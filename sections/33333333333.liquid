{% comment %} 护眼仪标签切换模块 {% endcomment %}
<div class="tab‑section container">
  <!-- 头部文字 -->
  <div class="tab‑header">
    <h2 class="tab‑main‑title">{{ section.settings.main_title }}</h2>
    <p class="tab‑sub‑title">{{ section.settings.sub_title }}</p>
  </div>

  <!-- Tab按钮栏 -->
  <div class="tab‑buttons">
    {% for block in section.blocks %}
      <button class="tab‑btn {% if forloop.index == 1 %}active{% endif %}" data‑tab="{{ block.id }}">
        {{ block.settings.tab_name }}
      </button>
    {% endfor %}
  </div>

  <!-- Tab内容区域 -->
  <div class="tab‑content‑wrap">
    {% for block in section.blocks %}
      <div class="tab‑content {% if forloop.index == 1 %}show{% endif %}" data‑content="{{ block.id }}">
        <div class="tab‑content‑inner">
          {% if block.settings.image != blank %}
            <div class="tab‑img">
              {{ block.settings.image | image_url: width: 800 | image_tag }}
            </div>
          {% endif %}
          <div class="tab‑text">
            <h3>{{ block.settings.content_title }}</h3>
            <div>{{ block.settings.content_text }}</div>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% stylesheet %}
.tab‑section{
  padding: 60px 20px;
  max-width: 1200px;
  margin: 0 auto;
}
.tab‑header{
  text-align:center;
  margin-bottom:40px;
}
.tab‑main‑title{
  font-size:42px;
  font-weight:400;
  color:#444;
  margin:0 0 16px;
}
.tab‑sub‑title{
  font-size:18px;
  color:#666;
}
.tab‑buttons{
  display:flex;
  gap:4px;
  justify-content:center;
  margin-bottom:50px;
  flex-wrap:wrap;
}
.tab‑btn{
  border:1px solid #eee;
  background:#fff;
  border-radius:999px;
  padding:14px 36px;
  font-size:17px;
  cursor:pointer;
  transition: all 0.3s;
}
.tab‑btn.active{
  background:#f3ece0;
  border‑color:#f3ece0;
}
.tab‑content{
  display:none;
}
.tab‑content.show{
  display:block;
}
.tab‑content‑inner{
  display:grid;
  grid-template-columns: 1fr 1fr;
  gap:40px;
  align-items:center;
}
.tab‑img img{
  width:100%;
  border-radius:12px;
}
@media(max-width:768px){
  .tab‑content‑inner{
    grid-template-columns: 1fr;
  }
  .tab‑main‑title{
    font-size:28px;
  }
}
{% endstylesheet %}

{% javascript %}
document.addEventListener('DOMContentLoaded',()=>{
  const buttons = document.querySelectorAll('.tab‑btn');
  buttons.forEach(btn=>{
    btn.addEventListener('click',()=>{
      //移除全部激活状态
      document.querySelectorAll('.tab‑btn').forEach(b=>b.classList.remove('active'));
      document.querySelectorAll('.tab‑content').forEach(c=>c.classList.remove('show'));
      //激活当前
      btn.classList.add('active');
      const tabId = btn.dataset.tab;
      document.querySelector(`.tab‑content[data‑content="${tabId}"]`).classList.add('show');
    })
  })
})
{% endjavascript %}

{% comment %} 后台编辑器设置 {% endcomment %}
{% schema %}
{
  "name": "标签切换体验模块",
  "settings": [
    {
      "type": "text",
      "id": "main_title",
      "label": "主标题",
      "default": "满足您需求的放松方式"
    },
    {
      "type": "text",
      "id": "sub_title",
      "label": "副标题",
      "default": "智能便捷的穴位按摩器，只需您发出指令即可使用。适合所有人。"
    }
  ],
  "blocks": [
    {
      "type": "tab_item",
      "name": "标签选项",
      "settings": [
        {
          "type": "text",
          "id": "tab_name",
          "label": "标签按钮文字",
          "default": "体验"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "内容配图"
        },
        {
          "type": "text",
          "id": "content_title",
          "label": "内容标题",
          "default": "为您量身定制的自我护理"
        },
        {
          "type": "richtext",
          "id": "content_text",
          "label": "正文描述"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "标签切换模块",
      "blocks":[
        {"type":"tab_item"},
        {"type":"tab_item"},
        {"type":"tab_item"},
        {"type":"tab_item"},
        {"type":"tab_item"}
      ]
    }
  ]
}
{% endschema %}