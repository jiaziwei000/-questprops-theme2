{% comment %}
  /**
   * Incredible Apps (IA) - Testimonial v5
   * -----------------------------------------------
   * website: https://incredible-apps.com/
   * Apps : https://apps.shopify.com/partners/incredible-apps
   * Copyright © 2025 Incredible Apps. All rights reserved.
   * For support or customization requests, please contact:
   * contact@incredible-apps.com
   *
   * @version: 1.0.0
   * @author: Incredible Apps (IA)
   * @requires Shopify Online Store 2.0+
   */
{% endcomment %}

<style>
  /* Base styles */
  #ia-section-testimonial-5-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    background-color: {{ section.settings.background_color }};
    overflow: hidden;
    width: 100%;
  }

  #ia-section-testimonial-5-{{ section.id }} .ia-section-testimonial-5__container {
    {% if section.settings.full_width %}
      width: 100%;
      padding: 0 15px;
    {% else %}
      max-width: {{ section.settings.section_width }}px;
      margin: 0 auto;
      padding: a 15px;
    {% endif %}
  }

  /* Content layout with mobile-first approach */
  #ia-section-testimonial-5-{{ section.id }} .ia-section-testimonial-5__content {
    display: flex;
    flex-direction: column-reverse; /* Carousel first on mobile */
    gap: 20px;
  }

  #ia-section-testimonial-5-{{ section.id }} .ia-section-testimonial-5__text {
    width: 100%;
    padding: 15px 0;
    text-align: {{ section.settings.text_alignment }};
    display: flex;
    flex-direction: column;
    align-items: {% if section.settings.text_alignment == 'left' %}flex-start{% elsif section.settings.text_alignment == 'right' %}flex-end{% else %}center{% endif %};
  }

  #ia-section-testimonial-5-{{ section.id }} .ia-section-testimonial-5__heading {
    font-size: {{ section.settings.heading_font_size }}px;
    line-height: 1.3;
    font-weight: {{ section.settings.heading_font_weight }};
    margin-bottom: 12px;
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
    color: {{ section.settings.heading_color }};
    text-align: {{ section.settings.text_alignment }};
    font-family: {{ section.settings.heading_font_family.family }}, {{ section.settings.heading_font_family.fallback_families }};
    font-style: {{ section.settings.heading_font_style }};
  }

  #ia-section-testimonial-5-{{ section.id }} .ia-section-testimonial-5__subheading {
    margin-bottom: 12px;
    font-size: {{ section.settings.subheading_font_size }}px;
    line-height: 1.5;
    text-align: {{ section.settings.text_alignment }};
    color: {{ section.settings.subheading_color }};
    font-family: {{ section.settings.subheading_font_family.family }}, {{ section.settings.subheading_font_family.fallback_families }};
    font-weight: {{ section.settings.subheading_font_weight }};
    font-style: {{ section.settings.subheading_font_style }};
    letter-spacing: {{ section.settings.subheading_letter_spacing }}px;
  }

  #ia-section-testimonial-5-{{ section.id }} .ia-section-testimonial-5__cta-button {
    display: inline-block;
    padding: {{ section.settings.button_padding_vertical }}px {{ section.settings.button_padding_horizontal }}px;
    line-height: 1.5;
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: {{ section.settings.button_font_weight }};
    text-transform: uppercase;
    letter-spacing: {{ section.settings.button_letter_spacing }}px;
    color: {{ section.settings.button_text_color }};
    background-color: {{ section.settings.button_background_color }};
    border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_border_color }};
    border-radius: {{ section.settings.button_border_radius }}px;
    transition: all 0.3s cubic-bezier(0.215, 0.61, 0.355, 1);
    text-decoration: none;
  }

  #ia-section-testimonial-5-{{ section.id }} .ia-section-testimonial-5__cta-button:hover {
    color: {{ section.settings.button_hover_text_color }};
    background-color: {{ section.settings.button_hover_background_color }};
    border-color: {{ section.settings.button_hover_border_color }};
  }

  /* Rating styles */
  #ia-section-testimonial-5-{{ section.id }} .ia-section-testimonial-5__rating {
    display: flex;
    flex-direction: column;
    align-items: {% if section.settings.text_alignment == 'left' %}flex-start{% elsif section.settings.text_alignment == 'right' %}flex-end{% else %}center{% endif %};
    margin-top: 15px;
  }

  #ia-section-testimonial-5-{{ section.id }} .ia-section-testimonial-5__stars {
    display: flex;
    align-items: center;
    gap: {{ section.settings.star_spacing }}px;
  }

  #ia-section-testimonial-5-{{ section.id }} .ia-section-testimonial-5__star-filled svg,
  #ia-section-testimonial-5-{{ section.id }} .ia-section-testimonial-5__star-empty svg {
    width: {{ section.settings.star_size }}px;
    height: {{ section.settings.star_size }}px;
  }

  #ia-section-testimonial-5-{{ section.id }} .ia-section-testimonial-5__star-filled svg {
    fill: {{ section.settings.star_color }};
  }

  #ia-section-testimonial-5-{{ section.id }} .ia-section-testimonial-5__star-empty svg {
    fill: none;
    stroke: {{ section.settings.star_color }};
  }

  #ia-section-testimonial-5-{{ section.id }} .ia-section-testimonial-5__rating-text {
    margin-top: {{ section.settings.rating_text_spacing }}px;
    font-size: {{ section.settings.rating_text_size }}px;
    color: {{ section.settings.rating_text_color }};
    font-weight: {{ section.settings.rating_text_weight }};
  }

  /* Carousel styles */
  #ia-section-testimonial-5-{{ section.id }} .ia-section-testimonial-5__carousel {
    width: 100%;
    position: relative;
    overflow: hidden;
    border-radius: 4px;
  }

  #ia-section-testimonial-5-{{ section.id }} .ia-section-testimonial-5__track-container {
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  #ia-section-testimonial-5-{{ section.id }} .ia-section-testimonial-5__track {
    display: flex;
    will-change: transform;
    transition: transform 0.5s ease;
  }

  #ia-section-testimonial-5-{{ section.id }} .ia-section-testimonial-5__item {
    flex: 0 0 auto;
    width: 290px;
    padding: 0 8px;
    box-sizing: border-box;
  }

  #ia-section-testimonial-5-{{ section.id }} .ia-section-testimonial-5__video-container,
  #ia-section-testimonial-5-{{ section.id }} .ia-section-testimonial-5__image-container {
    position: relative;
    border-radius: 10px;
    overflow: hidden;
    height: 0;
    padding-bottom: 177.78%; /* 16:9 aspect ratio */
  }

  #ia-section-testimonial-5-{{ section.id }} .ia-section-testimonial-5__video,
  #ia-section-testimonial-5-{{ section.id }} .ia-section-testimonial-5__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 10px;
  }

  #ia-section-testimonial-5-{{ section.id }} .ia-section-testimonial-5__username {
    position: absolute;
    top: 10px;
    left: 10px;
    background-color: rgba(0, 0, 0, 0.5);
    color: white;
    padding: 2px 8px;
    border-radius: 20px;
    font-size: 12px;
    z-index: 2;
  }

  #ia-section-testimonial-5-{{ section.id }} .ia-section-testimonial-5__placeholder {
    width: 100%;
    height: 100%;
    background-color: #f0f0f0;
    border-radius: 10px;
  }

  /* Desktop styles */
  @media screen and (min-width: 769px) {
    #ia-section-testimonial-5-{{ section.id }} .ia-section-testimonial-5__container {
      padding: 0 40px;
    }

    #ia-section-testimonial-5-{{ section.id }} .ia-section-testimonial-5__content {
      flex-direction: row;
      align-items: center;
      gap: 20px;
    }

    #ia-section-testimonial-5-{{ section.id }} .ia-section-testimonial-5__text {
      width: 50%;
      padding: 50px;
      text-align: {{ section.settings.text_alignment }};
      align-items: {% if section.settings.text_alignment == 'left' %}flex-start{% elsif section.settings.text_alignment == 'right' %}flex-end{% else %}center{% endif %};
    }

    #ia-section-testimonial-5-{{ section.id }} .ia-section-testimonial-5__heading {
      font-size: {{ section.settings.heading_font_size_desktop }}px;
      margin-bottom: 15px;
      text-align: {{ section.settings.text_alignment }};
    }

    #ia-section-testimonial-5-{{ section.id }} .ia-section-testimonial-5__subheading {
      margin-bottom: 15px;
      text-align: {{ section.settings.text_alignment }};
    }

    #ia-section-testimonial-5-{{ section.id }} .ia-section-testimonial-5__carousel {
      width: 50%;
    }

    #ia-section-testimonial-5-{{ section.id }} .ia-section-testimonial-5__item {
      width: 303px;
      padding: 0 10px;
    }

    #ia-section-testimonial-5-{{ section.id }} .ia-section-testimonial-5__rating {
      margin-top: 20px;
    }
  }

  /* Mobile-specific optimizations */
  @media screen and (max-width: 768px) {
    #ia-section-testimonial-5-{{ section.id }} {
      padding: {{ section.settings.padding_top | divided_by: 1.5 | round }}px 0 {{ section.settings.padding_bottom | divided_by: 1.5 | round }}px;
    }

    #ia-section-testimonial-5-{{ section.id }} .ia-section-testimonial-5__heading {
      font-size: {{ section.settings.heading_font_size | times: 0.9 | round }}px;
    }

    #ia-section-testimonial-5-{{ section.id }} .ia-section-testimonial-5__cta-button {
      padding: {{ section.settings.button_padding_vertical | minus: 2 }}px {{ section.settings.button_padding_horizontal | minus: 5 }}px;
      font-size: {{ section.settings.button_font_size | minus: 2 }}px;
    }

    #ia-section-testimonial-5-{{ section.id }} .ia-section-testimonial-5__star-filled svg,
    #ia-section-testimonial-5-{{ section.id }} .ia-section-testimonial-5__star-empty svg {
      width: {{ section.settings.star_size | minus: 2 }}px;
      height: {{ section.settings.star_size | minus: 2 }}px;
    }
  }
</style>

<div class="ia-section-testimonial-5" id="ia-section-testimonial-5-{{ section.id }}">
  <div class="ia-section-testimonial-5__container">
    <div class="ia-section-testimonial-5__content">
      <div class="ia-section-testimonial-5__text">
        {% if section.settings.heading != blank %}
          <h2 class="ia-section-testimonial-5__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <div class="ia-section-testimonial-5__subheading">{{ section.settings.subheading }}</div>
        {% endif %}

        {% if section.settings.button_text != blank %}
          <a href="{{ section.settings.button_link }}" class="ia-section-testimonial-5__cta-button">
            {{ section.settings.button_text }}
          </a>
        {% endif %}

        <div class="ia-section-testimonial-5__rating">
          <div class="ia-section-testimonial-5__stars">
            {% for i in (1..5) %}
              {% if i <= section.settings.rating_value %}
                <span class="ia-section-testimonial-5__star-filled">
                  {% if section.settings.custom_star_filled != blank %}
                    {{ section.settings.custom_star_filled }}
                  {% else %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" stroke="none">
                      <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                    </svg>
                  {% endif %}
                </span>
              {% else %}
                <span class="ia-section-testimonial-5__star-empty">
                  {% if section.settings.custom_star_empty != blank %}
                    {{ section.settings.custom_star_empty }}
                  {% else %}
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                    </svg>
                  {% endif %}
                </span>
              {% endif %}
            {% endfor %}
          </div>
          {% if section.settings.rating_text != blank %}
            <p class="ia-section-testimonial-5__rating-text">
              {{ section.settings.rating_text }}
            </p>
          {% endif %}
        </div>
      </div>

      <div class="ia-section-testimonial-5__carousel">
        <div class="ia-section-testimonial-5__track-container">
          <div class="ia-section-testimonial-5__track" id="ia-section-testimonial-5-carousel-track-{{ section.id }}">
            {% for block in section.blocks %}
              <div
                class="ia-section-testimonial-5__item"
                {{ block.shopify_attributes }}
                data-index="{{ forloop.index0 }}"
                data-original
              >
                {% case block.type %}
                  {% when 'video' %}
                    <div class="ia-section-testimonial-5__video-container">
                      {% if block.settings.video != blank %}
                        <video
                          class="ia-section-testimonial-5__video"
                          id="ia-section-testimonial-5-video-{{ block.id }}"
                          loop
                          muted
                          playsinline
                          webkit-playsinline
                          preload="auto"
                          poster="{{ block.settings.poster_image | img_url: '400x' }}"
                        >
                          <source src="{{ block.settings.video | video_tag: source: true }}" type="video/mp4">
                        </video>
                      {% elsif block.settings.video_url != blank %}
                        <video
                          class="ia-section-testimonial-5__video"
                          id="ia-section-testimonial-5-video-{{ block.id }}"
                          loop
                          muted
                          playsinline
                          webkit-playsinline
                          preload="auto"
                          poster="{{ block.settings.poster_image | img_url: '400x' }}"
                        >
                          <source src="{{ block.settings.video_url }}" type="video/mp4">
                        </video>
                      {% else %}
                        {{ 'image' | placeholder_svg_tag: 'ia-section-testimonial-5__placeholder' }}
                      {% endif %}
                      {% if block.settings.username != blank %}
                        <div class="ia-section-testimonial-5__username">{{ block.settings.username }}</div>
                      {% endif %}
                    </div>
                  {% when 'image' %}
                    <div class="ia-section-testimonial-5__image-container">
                      {% if block.settings.image != blank %}
                        <img
                          class="ia-section-testimonial-5__image"
                          src="{{ block.settings.image | img_url: '400x' }}"
                          alt="{{ block.settings.image.alt | escape }}"
                          loading="lazy"
                          width="400"
                          height="711"
                        >
                      {% else %}
                        {{ 'image' | placeholder_svg_tag: 'ia-section-testimonial-5__placeholder' }}
                      {% endif %}
                      {% if block.settings.username != blank %}
                        <div class="ia-section-testimonial-5__username">{{ block.settings.username }}</div>
                      {% endif %}
                    </div>
                {% endcase %}
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Create a class for the carousel to make each instance independent
    class IaSectionTestimonial5Carousel {
      constructor(sectionId) {
        this.sectionId = sectionId;
        this.carouselId = `ia-section-testimonial-5-carousel-track-${sectionId}`;
        this.track = document.getElementById(this.carouselId);
        
        if (!this.track) return; // Exit if track element doesn't exist
        
        this.originalItems = this.track.querySelectorAll('[data-original]');
        
        // Exit if no items
        if (this.originalItems.length === 0) return;
        
        this.position = 0;
        this.loopData = null;
        this.animationFrameId = null;
        this.lastTimestamp = 0;
        this.scrollSpeed = {{ section.settings.scroll_speed | default: 2 }} * 0.5;
        
        // Initialize videos
        this.initializeAllVideos();
        
        // Setup infinite loop
        this.loopData = this.setupInfiniteLoop();
        
        // Position track initially
        this.position = -this.loopData.itemWidth * this.loopData.startClones;
        this.track.style.transition = 'none';
        this.track.style.transform = `translateX(${this.position}px)`;
        
        // Force a reflow
        this.track.offsetHeight;
        
        // Re-enable transitions after initial positioning
        setTimeout(() => {
          this.track.style.transition = 'transform 0.5s ease';
          
          // Start animation
          this.animationFrameId = requestAnimationFrame(this.animateCarousel.bind(this));
        }, 50);
        
        // Add event listeners
        this.setupEventListeners();
      }
      
      initializeAllVideos() {
        const videos = document.querySelectorAll(`.ia-section-testimonial-5__video[id^="ia-section-testimonial-5-video-${this.sectionId}"]`);
        videos.forEach(video => {
          // Try to play the video
          const playPromise = video.play();
          if (playPromise !== undefined) {
            playPromise.catch(() => {
              // Auto-play was prevented
              // Show a "Play" button so that user can start playback manually
            });
          }
        });
      }
      
      setupInfiniteLoop() {
        // Clear any existing clones
        const existingClones = this.track.querySelectorAll('[data-clone]');
        existingClones.forEach(clone => clone.remove());
        
        // Get the container width to determine how many clones we need
        const containerWidth = this.track.parentElement.offsetWidth;
        const itemWidth = this.originalItems[0].offsetWidth;
        
        // Calculate how many items we need to clone to fill the view
        // We need at least enough to fill the container width on both sides
        const itemsNeededForView = Math.ceil(containerWidth / itemWidth) + 1;
        
        // Clone items to create the wrap-around effect
        // First, add clones at the end (for wrapping from last to first)
        for (let i = 0; i < itemsNeededForView; i++) {
          const index = i % this.originalItems.length;
          const clone = this.originalItems[index].cloneNode(true);
          clone.removeAttribute('data-original');
          clone.setAttribute('data-clone', 'end');
          clone.setAttribute('aria-hidden', 'true');
          this.track.appendChild(clone);
        }
        
        // Then, add clones at the beginning (for initial view)
        // We add these in reverse order to maintain the correct sequence
        for (let i = this.originalItems.length - 1; i >= this.originalItems.length - itemsNeededForView; i--) {
          const index = (i + this.originalItems.length) % this.originalItems.length;
          const clone = this.originalItems[index].cloneNode(true);
          clone.removeAttribute('data-original');
          clone.setAttribute('data-clone', 'start');
          clone.setAttribute('aria-hidden', 'true');
          this.track.insertBefore(clone, this.track.firstChild);
        }
        
        // Initialize all videos in the clones
        const allVideos = this.track.querySelectorAll('[data-clone] video');
        allVideos.forEach(video => {
          const playPromise = video.play();
          if (playPromise !== undefined) {
            playPromise.catch(() => {
              // Auto-play was prevented
              // Show a "Play" button so that user can start playback manually
            });
          }
        });
        
        return {
          itemWidth,
          startClones: itemsNeededForView,
          totalItems: this.track.querySelectorAll('.ia-section-testimonial-5__item').length
        };
      }
      
      animateCarousel(timestamp) {
        if (!this.lastTimestamp) this.lastTimestamp = timestamp;
        const elapsed = timestamp - this.lastTimestamp;
        
        if (elapsed > 16) { // Cap at ~60fps
          // Move the carousel based on elapsed time for smooth animation
          this.position -= this.scrollSpeed * (elapsed / 16);
          this.track.style.transform = `translateX(${this.position}px)`;
          
          this.lastTimestamp = timestamp;
          
          // Check if we need to reset position for the infinite loop
          const totalOriginalWidth = this.loopData.itemWidth * this.originalItems.length;
          
          // If we've scrolled past all original items, reset to the first original item
          if (Math.abs(this.position) >= (this.loopData.startClones + this.originalItems.length) * this.loopData.itemWidth) {
            // Jump back to the first original item (after clones)
            this.position = -this.loopData.itemWidth * this.loopData.startClones;
            
            // Disable transition for the jump
            this.track.style.transition = 'none';
            this.track.style.transform = `translateX(${this.position}px)`;
            
            // Force reflow
            this.track.offsetHeight;
            
            // Re-enable transition
            setTimeout(() => {
              this.track.style.transition = 'transform 0.5s ease';
            }, 50);
          }
        }
        
        this.animationFrameId = requestAnimationFrame(this.animateCarousel.bind(this));
      }
      
      initializeVideos() {
        const allVideos = this.track.querySelectorAll('video');
        allVideos.forEach(video => {
          // Try to play videos
          video.play().catch(() => {});
          
          // Optimize performance by pausing videos not in viewport
          const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                entry.target.play().catch(() => {});
              } else {
                entry.target.pause();
              }
            });
          }, { threshold: 0.1 });
          
          observer.observe(video);
        });
      }
      
      setupEventListeners() {
        // Handle visibility change to pause/resume animation
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) {
            cancelAnimationFrame(this.animationFrameId);
            this.lastTimestamp = 0;
          } else {
            this.animationFrameId = requestAnimationFrame(this.animateCarousel.bind(this));
          }
        });
        
        // Handle resize events
        let resizeTimer;
        window.addEventListener('resize', () => {
          clearTimeout(resizeTimer);
          
          resizeTimer = setTimeout(() => {
            // Cancel current animation
            cancelAnimationFrame(this.animationFrameId);
            
            // Reset variables
            this.lastTimestamp = 0;
            
            // Re-setup the infinite loop with new dimensions
            const newLoopData = this.setupInfiniteLoop();
            
            // Reset position to the first original item
            this.position = -newLoopData.itemWidth * newLoopData.startClones;
            this.track.style.transition = 'none';
            this.track.style.transform = `translateX(${this.position}px)`;
            
            // Force reflow
            this.track.offsetHeight;
            
            // Re-enable transition after positioning
            setTimeout(() => {
              this.track.style.transition = 'transform 0.5s ease';
              
              // Restart animation
              this.animationFrameId = requestAnimationFrame(this.animateCarousel.bind(this));
            }, 50);
            
            // Re-initialize videos
            this.initializeVideos();
          }, 250);
        });
      }
    }
    
    // Initialize each carousel on the page with a unique instance
    new IaSectionTestimonial5Carousel('{{ section.id }}');
  });
</script>

{% schema %}
{
  "name": "IA - Testimonial #5",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#fafafa"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false,
      "info": "When enabled, section spans the full width of the screen"
    },
    {
      "type": "range",
      "id": "section_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Section width",
      "default": 1200,
      "info": "Maximum width of the section content"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    },
    {
      "type": "range",
