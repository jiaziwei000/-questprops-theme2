{% liquid
  assign cfg_product = product
  assign cfg_variant = product.selected_or_first_available_variant
  assign cfg_base_price = cfg_variant.price
%}

<section
  id="QuestConfigurator-{{ section.id }}"
  class="qp-config"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-variant-id="{{ cfg_variant.id }}"
  data-base-price="{{ cfg_base_price }}"
>

  <div class="qp-config__visual">

    <div class="qp-config__visual-inner">

      {% if product.featured_image %}
        {{
          product.featured_image
          | image_url: width: 1800
          | image_tag:
            class: 'qp-config__product-image',
            loading: 'eager',
            widths: '600,900,1200,1500,1800',
            sizes: '70vw',
            alt: product.featured_image.alt | escape
        }}
      {% else %}
        <div class="qp-config__placeholder">
          QUESTPROPS™
        </div>
      {% endif %}

      <!-- HOTSPOT 01 -->
      <button
        type="button"
        class="qp-hotspot"
        data-hotspot="heat"
        style="--x: 37%; --y: 34%;"
        aria-label="Heat"
      >
        <span>+</span>
      </button>

      <!-- HOTSPOT 02 -->
      <button
        type="button"
        class="qp-hotspot"
        data-hotspot="ems"
        style="--x: 64%; --y: 43%;"
        aria-label="EMS"
      >
        <span>+</span>
      </button>

      <!-- HOTSPOT 03 -->
      <button
        type="button"
        class="qp-hotspot"
        data-hotspot="fit"
        style="--x: 49%; --y: 67%;"
        aria-label="Neck fit"
      >
        <span>+</span>
      </button>

      <!-- HOTSPOT INFORMATION -->
      <div
        class="qp-hotspot-card"
        data-hotspot-card
        aria-hidden="true"
      >

        <button
          type="button"
          class="qp-hotspot-card__close"
          data-hotspot-close
          aria-label="Close"
        >
          ×
        </button>

        <div
          class="qp-hotspot-card__number"
          data-hotspot-number
        >
          01
        </div>

        <h3
          class="qp-hotspot-card__title"
          data-hotspot-title
        >
          Soothing Heat
        </h3>

        <p
          class="qp-hotspot-card__text"
          data-hotspot-text
        >
          Gentle warmth designed to complement
          your daily 10-minute reset.
        </p>

      </div>

      <div class="qp-config__visual-label">
        <span></span>
        QUESTPROPS™ NECK RESTORE
      </div>

    </div>

  </div>


  <div class="qp-config__content">

    <div class="qp-config__header">

      <div class="qp-config__eyebrow">
        QUESTPROPS™
      </div>

      <h1 class="qp-config__title">
        Build your<br>
        daily reset.
      </h1>

      <p class="qp-config__intro">
        Explore the device, choose your setup,
        and make your daily 10-minute reset yours.
      </p>

      <div class="qp-config__rating">
        <span>★★★★★</span>
        <strong>4.9</strong>
        <span>1,000+ reviews</span>
      </div>

    </div>


    <!-- STEP 01 -->

    <div class="qp-step">

      <div class="qp-step__heading">
        <span>01</span>
        <h2>Choose your device</h2>
      </div>

      <div class="qp-product-card qp-product-card--active">

        <div class="qp-product-card__radio"></div>

        <div class="qp-product-card__info">

          <strong>
            {{ product.title }}
          </strong>

          <span>
            EMS stimulation + soothing heat
          </span>

        </div>

        <strong class="qp-product-card__price">
          {{ cfg_variant.price | money }}
        </strong>

      </div>

    </div>


    <!-- STEP 02 -->

    <div class="qp-step">

      <div class="qp-step__heading">
        <span>02</span>
        <h2>Choose your finish</h2>
      </div>

      <div class="qp-colors">

        <button
          type="button"
          class="qp-color qp-color--active"
          data-color="black"
        >
          <span class="qp-color__swatch qp-color__swatch--black"></span>
          <span>Black</span>
        </button>

        <button
          type="button"
          class="qp-color"
          data-color="white"
        >
          <span class="qp-color__swatch qp-color__swatch--white"></span>
          <span>White</span>
        </button>

      </div>

    </div>


    <!-- STEP 03 -->

    <div class="qp-step">

      <div class="qp-step__heading">
        <span>03</span>
        <h2>Add your essentials</h2>
      </div>


      <div class="qp-options">

        <label class="qp-option">

          <input
            type="checkbox"
            data-option="remote"
          >

          <span class="qp-option__check"></span>

          <span class="qp-option__content">

            <strong>
              Remote Control
            </strong>

            <small>
              Adjust your routine without reaching
              for the device.
            </small>

          </span>

          <strong class="qp-option__price">
            +$19
          </strong>

        </label>


        <label class="qp-option">

          <input
            type="checkbox"
            data-option="case"
          >

          <span class="qp-option__check"></span>

          <span class="qp-option__content">

            <strong>
              Travel Case
            </strong>

            <small>
              Keep your daily reset ready wherever
              you go.
            </small>

          </span>

          <strong class="qp-option__price">
            +$15
          </strong>

        </label>


        <label class="qp-option">

          <input
            type="checkbox"
            data-option="accessories"
          >

          <span class="qp-option__check"></span>

          <span class="qp-option__content">

            <strong>
              Extra Accessories
            </strong>

            <small>
              Keep your setup ready for everyday use.
            </small>

          </span>

          <strong class="qp-option__price">
            +$9
          </strong>

        </label>

      </div>

    </div>


    <!-- STEP 04 -->

    <div class="qp-step">

      <div class="qp-step__heading">
        <span>04</span>
        <h2>Protection</h2>
      </div>

      <label class="qp-option">

        <input
          type="checkbox"
          checked
          disabled
        >

        <span class="qp-option__check qp-option__check--included">
          ✓
        </span>

        <span class="qp-option__content">

          <strong>
            2-Year Warranty
          </strong>

          <small>
            Included with every QUESTPROPS™ device.
          </small>

        </span>

        <strong class="qp-option__price">
          Included
        </strong>

      </label>

    </div>


    <!-- TRUST -->

    <div class="qp-trust">

      <div>
        <strong>60-Day Trial</strong>
        <span>Try it at home.</span>
      </div>

      <div>
        <strong>2-Year Warranty</strong>
        <span>Built for everyday use.</span>
      </div>

      <div>
        <strong>Free Shipping</strong>
        <span>Worldwide delivery.</span>
      </div>

    </div>


    <!-- SUMMARY -->

    <div class="qp-summary">

      <div class="qp-summary__heading">

        <span>
          Your QUESTPROPS™
        </span>

        <strong data-total>
          {{ cfg_variant.price | money }}
        </strong>

      </div>


      <div
        class="qp-summary__items"
        data-summary
      >

        <div>
          <span>{{ product.title }}</span>
          <span>{{ cfg_variant.price | money }}</span>
        </div>

      </div>


      <button
        type="button"
        class="qp-summary__button"
        data-add-to-cart
      >

        <span>
          ADD TO CART
        </span>

        <span data-button-price>
          {{ cfg_variant.price | money }}
        </span>

      </button>


      <div class="qp-summary__note">
        Secure checkout · Free shipping · 60-day trial
      </div>

    </div>

  </div>

</section>


<style>

#QuestConfigurator-{{ section.id }} {

  --qp-black: #111111;
  --qp-white: #ffffff;
  --qp-bg: #f5f5f3;
  --qp-gray: #777777;
  --qp-border: #e4e4e1;

  --qp-space-xs: 8px;
  --qp-space-sm: 12px;
  --qp-space-md: 20px;
  --qp-space-lg: 32px;
  --qp-space-xl: 48px;
  --qp-space-2xl: 72px;
  --qp-space-3xl: 110px;

  color: var(--qp-black);
  background: var(--qp-white);

  font-family:
    inherit;

  -webkit-font-smoothing: antialiased;

}


/* ===============================
   MAIN GRID
================================ */

#QuestConfigurator-{{ section.id }} .qp-config {

  display: grid;

  grid-template-columns:
    minmax(0, 1.35fr)
    minmax(420px, .65fr);

  min-height: 100vh;

}


/* ===============================
   VISUAL
================================ */

#QuestConfigurator-{{ section.id }} .qp-config__visual {

  position: sticky;

  top: 0;

  height: 100vh;

  overflow: hidden;

  background: var(--qp-bg);

}


#QuestConfigurator-{{ section.id }} .qp-config__visual-inner {

  position: relative;

  width: 100%;

  height: 100%;

  display: flex;

  align-items: center;

  justify-content: center;

}


#QuestConfigurator-{{ section.id }} .qp-config__product-image {

  width: min(850px, 88%);

  height: auto;

  max-height: 82vh;

  object-fit: contain;

  display: block;

}


#QuestConfigurator-{{ section.id }} .qp-config__placeholder {

  width: 70%;

  aspect-ratio: 1;

  display: flex;

  align-items: center;

  justify-content: center;

  background: #eeeeeb;

  font-size: 28px;

  letter-spacing: .08em;

}


/* ===============================
   HOTSPOTS
================================ */

#QuestConfigurator-{{ section.id }} .qp-hotspot {

  position: absolute;

  left: var(--x);

  top: var(--y);

  z-index: 5;

  width: 44px;

  height: 44px;

  transform: translate(-50%, -50%);

  border: 1px solid rgba(0,0,0,.12);

  border-radius: 50%;

  background: rgba(255,255,255,.96);

  color: var(--qp-black);

  display: flex;

  align-items: center;

  justify-content: center;

  cursor: pointer;

  box-shadow:
    0 10px 35px rgba(0,0,0,.13);

  transition:
    transform .25s ease,
    box-shadow .25s ease;

}


#QuestConfigurator-{{ section.id }} .qp-hotspot:hover {

  transform:
    translate(-50%, -50%)
    scale(1.12);

  box-shadow:
    0 16px 45px rgba(0,0,0,.18);

}


#QuestConfigurator-{{ section.id }} .qp-hotspot span {

  font-size: 23px;

  font-weight: 300;

  line-height: 1;

}


/* ===============================
   HOTSPOT CARD
================================ */

#QuestConfigurator-{{ section.id }} .qp-hotspot-card {

  position: absolute;

  z-index: 20;

  top: 15%;

  right: 6%;

  width: 310px;

  padding: 30px;

  background:
    rgba(255,255,255,.97);

  border-radius: 16px;

  box-shadow:
    0 20px 60px rgba(0,0,0,.12);

  opacity: 0;

  pointer-events: none;

  transform: translateY(15px);

  transition:
    opacity .25s ease,
    transform .25s ease;

}


#QuestConfigurator-{{ section.id }} .qp-hotspot-card.is-active {

  opacity: 1;

  pointer-events: auto;

  transform: translateY(0);

}


#QuestConfigurator-{{ section.id }} .qp-hotspot-card__close {

  position: absolute;

  top: 10px;

  right: 14px;

  border: 0;

  background: transparent;

  font-size: 25px;

  cursor: pointer;

  color: var(--qp-gray);

}


#QuestConfigurator-{{ section.id }} .qp-hotspot-card__number {

  margin-bottom: 14px;

  color: var(--qp-gray);

  font-size: 10px;

  letter-spacing: .16em;

}


#QuestConfigurator-{{ section.id }} .qp-hotspot-card__title {

  margin: 0 0 10px;

  font-size: 25px;

  line-height: 1;

  letter-spacing: -.04em;

}


#QuestConfigurator-{{ section.id }} .qp-hotspot-card__text {

  margin: 0;

  color: var(--qp-gray);

  font-size: 14px;

  line-height: 1.55;

}


/* ===============================
   VISUAL LABEL
================================ */

#QuestConfigurator-{{ section.id }} .qp-config__visual-label {

  position: absolute;

  left: 30px;

  bottom: 26px;

  display: flex;

  align-items: center;

  gap: 9px;

  color: var(--qp-gray);

  font-size: 10px;

  letter-spacing: .14em;

}


#QuestConfigurator-{{ section.id }} .qp-config__visual-label span {

  width: 7px;

  height: 7px;

  border-radius: 50%;

  background: var(--qp-black);

}


/* ===============================
   CONTENT
================================ */

#QuestConfigurator-{{ section.id }} .qp-config__content {

  padding:
    70px
    clamp(28px, 5vw, 78px)
    90px;

  background: var(--qp-white);

}


#QuestConfigurator-{{ section.id }} .qp-config__header {

  margin-bottom: var(--qp-space-3xl);

}


#QuestConfigurator-{{ section.id }} .qp-config__eyebrow {

  margin-bottom: 18px;

  color: var(--qp-gray);

  font-size: 10px;

  letter-spacing: .17em;

}


#QuestConfigurator-{{ section.id }} .qp-config__title {

  margin: 0;

  font-size:
    clamp(46px, 5vw, 70px);

  line-height: .92;

  letter-spacing: -.06em;

  font-weight: 600;

}


#QuestConfigurator-{{ section.id }} .qp-config__intro {

  max-width: 420px;

  margin: 25px 0 0;

  color: var(--qp-gray);

  font-size: 14px;

  line-height: 1.6;

}


#QuestConfigurator-{{ section.id }} .qp-config__rating {

  display: flex;

  align-items: center;

  gap: 8px;

  margin-top: 22px;

  font-size: 11px;

}


#QuestConfigurator-{{ section.id }} .qp-config__rating span:first-child {

  letter-spacing: 2px;

}


/* ===============================
   STEPS
================================ */

#QuestConfigurator-{{ section.id }} .qp-step {

  padding:
    31px 0;

  border-top:
    1px solid var(--qp-border);

}


#QuestConfigurator-{{ section.id }} .qp-step__heading {

  display: flex;

  align-items: center;

  gap: 13px;

  margin-bottom: 18px;

}


#QuestConfigurator-{{ section.id }} .qp-step__heading > span {

  color: var(--qp-gray);

  font-size: 10px;

}


#QuestConfigurator-{{ section.id }} .qp-step__heading h2 {

  margin: 0;

  font-size: 16px;

  font-weight: 500;

}


/* ===============================
   PRODUCT
================================ */

#QuestConfigurator-{{ section.id }} .qp-product-card {

  display: flex;

  align-items: center;

  gap: 14px;

  width: 100%;

  padding: 18px;

  border:
    1px solid var(--qp-border);

  border-radius: 12px;

}


#QuestConfigurator-{{ section.id }} .qp-product-card--active {

  border-color:
    var(--qp-black);

}


#QuestConfigurator-{{ section.id }} .qp-product-card__radio {

  width: 18px;

  height: 18px;

  flex: 0 0 auto;

  border-radius: 50%;

  border:
    5px solid var(--qp-black);

}


#QuestConfigurator-{{ section.id }} .qp-product-card__info {

  flex: 1;

  display: flex;

  flex-direction: column;

  gap: 5px;

}


#QuestConfigurator-{{ section.id }} .qp-product-card__info span {

  color: var(--qp-gray);

  font-size: 11px;

}


/* ===============================
   COLORS
================================ */

#QuestConfigurator-{{ section.id }} .qp-colors {

  display: flex;

  gap: 10px;

}


#QuestConfigurator-{{ section.id }} .qp-color {

  min-width: 120px;

  padding: 14px;

  display: flex;

  align-items: center;

  gap: 10px;

  border:
    1px solid var(--qp-border);

  border-radius: 10px;

  background: #fff;

  cursor: pointer;

}


#QuestConfigurator-{{ section.id }} .qp-color--active {

  border-color:
    var(--qp-black);

}


#QuestConfigurator-{{ section.id }} .qp-color__swatch {

  width: 22px;

  height: 22px;

  border-radius: 50%;

  border:
    1px solid #ccc;

}


#QuestConfigurator-{{ section.id }} .qp-color__swatch--black {

  background: #111;

}


#QuestConfigurator-{{ section.id }} .qp-color__swatch--white {

  background: #fff;

}


/* ===============================
   OPTIONS
================================ */

#QuestConfigurator-{{ section.id }} .qp-options {

  display: grid;

  gap: 9px;

}


#QuestConfigurator-{{ section.id }} .qp-option {

  position: relative;

  display: flex;

  align-items: center;

  gap: 13px;

  padding: 17px;

  border:
    1px solid var(--qp-border);

  border-radius: 11px;

  cursor: pointer;

  transition:
    border-color .2s ease,
    background .2s ease;

}


#QuestConfigurator-{{ section.id }} .qp-option:has(input:checked) {

  border-color:
    var(--qp-black);

  background:
    #fafafa;

}


#QuestConfigurator-{{ section.id }} .qp-option input {

  position: absolute;

  opacity: 0;

  pointer-events: none;

}


#QuestConfigurator-{{ section.id }} .qp-option__check {

  width: 18px;

  height: 18px;

  flex: 0 0 auto;

  border:
    1px solid #aaa;

  border-radius: 4px;

}


#QuestConfigurator-{{ section.id }} .qp-option input:checked
~ .qp-option__check {

  background:
    var(--qp-black);

  border-color:
    var(--qp-black);

}


#QuestConfigurator-{{ section.id }} .qp-option input:checked
~ .qp-option__check::after {

  content: "✓";

  display: block;

  color: #fff;

  font-size: 11px;

  line-height: 17px;

  text-align: center;

}


#QuestConfigurator-{{ section.id }} .qp-option__check--included {

  display: flex;

  align-items: center;

  justify-content: center;

  background:
    var(--qp-black);

  color:
    #fff;

  border-color:
    var(--qp-black);

  font-size: 11px;

}


#QuestConfigurator-{{ section.id }} .qp-option__content {

  flex: 1;

  display: flex;

  flex-direction: column;

  gap: 4px;

}


#QuestConfigurator-{{ section.id }} .qp-option__content small {

  color:
    var(--qp-gray);

  font-size: 11px;

  line-height: 1.45;

}


#QuestConfigurator-{{ section.id }} .qp-option__price {

  white-space: nowrap;

  font-size: 12px;

}


/* ===============================
   TRUST
================================ */

#QuestConfigurator-{{ section.id }} .qp-trust {

  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  border-top:
    1px solid var(--qp-border);

  border-bottom:
    1px solid var(--qp-border);

}


#QuestConfigurator-{{ section.id }} .qp-trust > div {

  padding: 20px 8px;

  display: flex;

  flex-direction: column;

  gap: 5px;

}


#QuestConfigurator-{{ section.id }} .qp-trust > div + div {

  border-left:
    1px solid var(--qp-border);

}


#QuestConfigurator-{{ section.id }} .qp-trust strong {

  font-size: 10px;

}


#QuestConfigurator-{{ section.id }} .qp-trust span {

  color: var(--qp-gray);

  font-size: 9px;

}


/* ===============================
   SUMMARY
================================ */

#QuestConfigurator-{{ section.id }} .qp-summary {

  position: sticky;

  bottom: 0;

  z-index: 20;

  padding-top: 28px;

  background:
    #fff;

}


#QuestConfigurator-{{ section.id }} .qp-summary__heading {

  display: flex;

  align-items: center;

  justify-content: space-between;

  margin-bottom: 11px;

}


#QuestConfigurator-{{ section.id }} .qp-summary__heading strong {

  font-size: 25px;

  letter-spacing: -.03em;

}


#QuestConfigurator-{{ section.id }} .qp-summary__items {

  margin-bottom: 15px;

  color: var(--qp-gray);

  font-size: 10px;

}


#QuestConfigurator-{{ section.id }} .qp-summary__items div {

  display: flex;

  justify-content: space-between;

  gap: 15px;

  margin-bottom: 4px;

}


#QuestConfigurator-{{ section.id }} .qp-summary__button {

  width: 100%;

  min-height: 60px;

  padding: 0 22px;

  border: 0;

  border-radius: 6px;

  background:
    var(--qp-black);

  color:
    #fff;

  display: flex;

  align-items: center;

  justify-content: space-between;

  cursor: pointer;

  transition:
    opacity .2s ease,
    transform .2s ease;

}


#QuestConfigurator-{{ section.id }} .qp-summary__button:hover {

  opacity: .88;

  transform:
    translateY(-2px);

}


#QuestConfigurator-{{ section.id }} .qp-summary__note {

  margin-top: 10px;

  text-align: center;

  color: var(--qp-gray);

  font-size: 9px;

}


/* ===============================
   TABLET / MOBILE
================================ */

@media screen and (max-width: 990px) {

  #QuestConfigurator-{{ section.id }} .qp-config {

    display: block;

  }


  #QuestConfigurator-{{ section.id }} .qp-config__visual {

    position: relative;

    height: 68vh;

    min-height: 480px;

  }


  #QuestConfigurator-{{ section.id }} .qp-config__content {

    padding:
      48px 24px 125px;

  }


  #QuestConfigurator-{{ section.id }} .qp-hotspot-card {

    top: 50%;

    left: 50%;

    right: auto;

    transform:
      translate(-50%, -45%);

  }


  #QuestConfigurator-{{ section.id }} .qp-hotspot-card.is-active {

    transform:
      translate(-50%, -50%);

  }


  #QuestConfigurator-{{ section.id }} .qp-summary {

    position: fixed;

    left: 0;

    right: 0;

    bottom: 0;

    padding:
      10px 18px
      calc(10px + env(safe-area-inset-bottom));

    box-shadow:
      0 -10px 35px rgba(0,0,0,.08);

  }


  #QuestConfigurator-{{ section.id }} .qp-summary__note {

    display: none;

  }


  #QuestConfigurator-{{ section.id }} .qp-summary__button {

    min-height: 52px;

  }

}


@media screen and (max-width: 600px) {

  #QuestConfigurator-{{ section.id }} .qp-config__visual {

    height: 62vh;

    min-height: 420px;

  }


  #QuestConfigurator-{{ section.id }} .qp-config__product-image {

    width: 94%;

  }


  #QuestConfigurator-{{ section.id }} .qp-config__title {

    font-size: 43px;

  }


  #QuestConfigurator-{{ section.id }} .qp-config__content {

    padding:
      42px 16px 120px;

  }


  #QuestConfigurator-{{ section.id }} .qp-hotspot {

    width: 38px;

    height: 38px;

  }


  #QuestConfigurator-{{ section.id }} .qp-hotspot-card {

    width:
      calc(100% - 32px);

    padding: 25px;

  }


  #QuestConfigurator-{{ section.id }} .qp-trust {

    grid-template-columns: 1fr;

  }


  #QuestConfigurator-{{ section.id }} .qp-trust > div {

    flex-direction: row;

    justify-content: space-between;

    padding: 13px 0;

  }


  #QuestConfigurator-{{ section.id }} .qp-trust > div + div {

    border-left: 0;

    border-top:
      1px solid var(--qp-border);

  }

}

</style>


<script>

(function() {

  const root =
    document.getElementById(
      'QuestConfigurator-{{ section.id }}'
    );

  if (!root) return;


  /* ===============================
     DATA
  =============================== */

  const options = {

    remote: {
      name: 'Remote Control',
      price: 19
    },

    case: {
      name: 'Travel Case',
      price: 15
    },

    accessories: {
      name: 'Extra Accessories',
      price: 9
    }

  };


  const hotspots = {

    heat: {
      number: '01',
      title: 'Soothing Heat',
      text:
        'Gentle warmth designed to complement your daily 10-minute reset.'
    },

    ems: {
      number: '02',
      title: 'EMS Stimulation',
      text:
        'Adjustable stimulation designed to complement your daily routine.'
    },

    fit: {
      number: '03',
      title: 'Ergonomic Neck Fit',
      text:
        'Designed around the natural curve of your neck for everyday comfort.'
    }

  };


  /* ===============================
     STATE
  =============================== */

  const state = {

    selectedOptions: [],

    color: 'black',

    basePrice:
      Number(
        root.dataset.basePrice
      ) / 100

  };


  /* ===============================
     ELEMENTS
  =============================== */

  const totalElement =
    root.querySelector('[data-total]');

  const buttonPrice =
    root.querySelector('[data-button-price]');

  const summary =
    root.querySelector('[data-summary]');

  const addButton =
    root.querySelector('[data-add-to-cart]');

  const hotspotCard =
    root.querySelector('[data-hotspot-card]');

  const hotspotNumber =
    root.querySelector('[data-hotspot-number]');

  const hotspotTitle =
    root.querySelector('[data-hotspot-title]');

  const hotspotText =
    root.querySelector('[data-hotspot-text]');

  const hotspotClose =
    root.querySelector('[data-hotspot-close]');


  /* ===============================
     MONEY
  =============================== */

  function money(value) {

    return new Intl.NumberFormat(
      '{{ localization.language.iso_code }}',
      {
        style: 'currency',
        currency: '{{ shop.currency }}'
      }
    ).format(value);

  }


  /* ===============================
     TOTAL
  =============================== */

  function calculateTotal() {

    let total =
      state.basePrice;


    state.selectedOptions.forEach(
      function(id) {

        if (options[id]) {

          total +=
            options[id].price;

        }

      }
    );


    return total;

  }


  /* ===============================
     RENDER PRICE
  =============================== */

  function renderPrice() {

    const total =
      calculateTotal();

    const formatted =
      money(total);


    if (totalElement) {

      totalElement.textContent =
        formatted;

    }


    if (buttonPrice) {

      buttonPrice.textContent =
        formatted;

    }

  }


  /* ===============================
     RENDER SUMMARY
  =============================== */

  function renderSummary() {

    if (!summary) return;


    let html = `

      <div>

        <span>
          {{ product.title | escape }}
        </span>

        <span>
          ${money(state.basePrice)}
        </span>

      </div>

    `;


    state.selectedOptions.forEach(
      function(id) {

        if (!options[id]) return;


        html += `

          <div>

            <span>
              ${options[id].name}
            </span>

            <span>
              +${money(options[id].price)}
            </span>

          </div>

        `;

      }
    );


    summary.innerHTML =
      html;

  }


  /* ===============================
     COLOR
  =============================== */

  root
    .querySelectorAll('[data-color]')
    .forEach(function(button) {

      button.addEventListener(
        'click',
        function() {

          root
            .querySelectorAll('[data-color]')
            .forEach(function(item) {

              item.classList.remove(
                'qp-color--active'
              );

            });


          button.classList.add(
            'qp-color--active'
          );


          state.color =
            button.dataset.color;

        }
      );

    });


  /* ===============================
     OPTIONS
  =============================== */

  root
    .querySelectorAll('[data-option]')
    .forEach(function(input) {

      input.addEventListener(
        'change',
        function() {

          const id =
            input.dataset.option;


          if (input.checked) {

            if (
              !state.selectedOptions.includes(id)
            ) {

              state.selectedOptions.push(id);

            }

          } else {

            state.selectedOptions =
              state.selectedOptions.filter(
                function(item) {

                  return item !== id;

                }
              );

          }


          renderPrice();

          renderSummary();

        }
      );

    });


  /* ===============================
     HOTSPOTS
  =============================== */

  root
    .querySelectorAll('.qp-hotspot')
    .forEach(function(button) {

      button.addEventListener(
        'click',
        function() {

          const id =
            button.dataset.hotspot;

          const data =
            hotspots[id];

          if (!data) return;


          hotspotNumber.textContent =
            data.number;

          hotspotTitle.textContent =
            data.title;

          hotspotText.textContent =
            data.text;


          hotspotCard
            .classList.add(
              'is-active'
            );


          hotspotCard
            .setAttribute(
              'aria-hidden',
              'false'
            );

        }
      );

    });


  /* ===============================
     CLOSE HOTSPOT
  =============================== */

  if (hotspotClose) {

    hotspotClose.addEventListener(
      'click',
      function() {

        hotspotCard
          .classList.remove(
            'is-active'
          );


        hotspotCard
          .setAttribute(
            'aria-hidden',
            'true'
          );

      }
    );

  }


  /* ===============================
     ADD TO CART
  =============================== */

  if (addButton) {

    addButton.addEventListener(
      'click',
      async function() {

        const variantId =
          Number(
            root.dataset.variantId
          );


        if (!variantId) {

          console.error(
            'Shopify variant ID missing.'
          );

          return;

        }


        const originalHTML =
          addButton.innerHTML;


        addButton.disabled =
          true;

        addButton.innerHTML =
          '<span>ADDING...</span>';


        try {

          const response =
            await fetch(
              '/cart/add.js',
              {
                method: 'POST',

                headers: {
                  'Content-Type':
                    'application/json',
                  'Accept':
                    'application/json'
                },

                body:
                  JSON.stringify({

                    items: [

                      {
                        id: variantId,
                        quantity: 1
                      }

                    ]

                  })

              }
            );


          if (!response.ok) {

            throw new Error(
              'Cart request failed'
            );

          }


          /*
           * Refresh Shopify cart drawer
           * when available.
           */

          document.dispatchEvent(
            new CustomEvent(
              'cart:refresh'
            )
          );


          /*
           * Fallback:
           * open cart page.
           */

          window.location.href =
            '/cart';


        } catch(error) {

          console.error(error);

          addButton.disabled =
            false;

          addButton.innerHTML =
            originalHTML;

          alert(
            'Unable to add this product to cart. Please try again.'
          );

        }

      }
    );

  }


  /* ===============================
     INITIAL RENDER
  =============================== */

  renderPrice();

  renderSummary();


})();

</script>


{% schema %}

{
  "name": "QUEST Configurator",
  "settings": [],
  "presets": [
    {
      "name": "QUEST Configurator"
    }
  ]
}

{% endschema %}