  }

}

</style>


<script>

(function() {

  const root =
    document.getElementById(
      'QP-Configure-{{ section.id }}'
    );

  if (!root) return;


  /* =========================
     HOTSPOTS
  ========================== */

  const hotspots =
    root.querySelectorAll('.qp-hotspot');

  const cards =
    root.querySelectorAll('.qp-hotspot-card');


  hotspots.forEach(function(hotspot) {

    hotspot.addEventListener('click', function() {

      const id =
        hotspot.dataset.hotspot;

      cards.forEach(function(card) {

        card.classList.remove('is-open');

      });

      const card =
        root.querySelector(
          '[data-card="' + id + '"]'
        );

      if (card) {

        card.classList.add('is-open');

      }

    });

  });


  root
    .querySelectorAll('.qp-card-close')
    .forEach(function(button) {

      button.addEventListener(
        'click',
        function() {

          cards.forEach(function(card) {

            card.classList.remove(
              'is-open'
            );

          });

        }
      );

    });


  /* =========================
     PRICE CALCULATOR
  ========================== */

  const basePrice =
    Number(
      root.dataset.basePrice
    ) || 0;


  let selectedOptionPrice = 0;


  const totalElement =
    root.querySelector('[data-total]');

  const buttonPrice =
    root.querySelector('.qp-button-price');


  function formatMoney(cents) {

    return new Intl.NumberFormat(
      '{{ localization.language.iso_code | default: "en" }}',
      {
        style: 'currency',
        currency:
          root.dataset.currency || 'USD'
      }
    ).format(cents / 100);

  }


  function updateTotal() {

    let total =
      basePrice +
      selectedOptionPrice;


    root
      .querySelectorAll(
        '.qp-addon-input:checked'
      )
      .forEach(function(input) {

        total +=
          Number(input.dataset.price) || 0;

      });


    totalElement.textContent =
      formatMoney(total);

    buttonPrice.textContent =
      formatMoney(total);

  }


  /* =========================
     OPTION SELECT
  ========================== */

  root
    .querySelectorAll('.qp-choice')
    .forEach(function(choice) {

      choice.addEventListener(
        'click',
        function() {

          root
            .querySelectorAll('.qp-choice')
            .forEach(function(item) {

              item.classList.remove(
                'active'
              );

            });


          choice.classList.add('active');


          selectedOptionPrice =
            Number(
              choice.dataset.price
            ) || 0;


          updateTotal();

        }
      );

    });


  /* =========================
     ADDONS
  ========================== */

  root
    .querySelectorAll('.qp-addon-input')
    .forEach(function(input) {

      input.addEventListener(
        'change',
        updateTotal
      );

    });


  /* =========================
     ADD TO CART
  ========================== */

  const addButton =
    root.querySelector(
      '[data-add-to-cart]'
    );


  addButton.addEventListener(
    'click',
    async function() {

      addButton.disabled = true;

      const original =
        addButton.innerHTML;

      addButton.innerHTML =
        '<span>Adding...</span>';


      try {

        const response =
          await fetch(
            '/cart/add.js',
            {
              method: 'POST',

              headers: {
                'Content-Type':
                  'application/json',
                'Accept':
                  'application/json'
              },

              body: JSON.stringify({

                items: [
                  {
                    id:
                      {{ product.selected_or_first_available_variant.id }},
                    quantity: 1
                  }
                ]

              })

            }
          );


        if (!response.ok) {

          throw new Error(
            'Add to cart failed'
          );

        }


        window.location.href =
          '/cart';

      }

      catch (error) {

        console.error(error);

        addButton.innerHTML =
          original;

        addButton.disabled = false;

        alert(
          'Sorry, something went wrong. Please try again.'
        );

      }

    }

  );


  updateTotal();

})();

</script>


