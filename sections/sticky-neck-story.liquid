<section id="qp-brand-scroll-{{ section.id }}" class="qp-brand-scroll">

  <div class="qp-scroll-stage">

    <!-- =========================================
         FIXED BACKGROUND TYPOGRAPHY
         背景文字始终固定
    ========================================== -->

    <div class="qp-fixed-canvas">

      <div class="qp-kicker">
        QUESTPROPS™ / NECK RESTORE
      </div>

      <div class="qp-big-text qp-text-top">
        YOUR DAILY
      </div>

      <div class="qp-big-text qp-text-bottom">
        NECK RESET
      </div>

      <div class="qp-small-line">
        EMS + HEAT THERAPY
      </div>

    </div>


    <!-- =========================================
         STICKY PRODUCT
    ========================================== -->

    <div class="qp-sticky-product">

      <div class="qp-product">

        {% if section.settings.product_image != blank %}

          {{
            section.settings.product_image
            | image_url: width: 2400
            | image_tag:
              class: 'qp-product-image',
              loading: 'eager',
              widths: '900,1200,1600,2000,2400'
          }}

        {% else %}

          <div class="qp-placeholder">
            PRODUCT IMAGE
          </div>

        {% endif %}


        <!-- PACKAGING -->

        <div class="qp-package">

          {% if section.settings.package_image != blank %}

            {{
              section.settings.package_image
              | image_url: width: 1600
              | image_tag:
                class: 'qp-package-image',
                loading: 'lazy',
                widths: '600,900,1200,1600'
            }}

          {% endif %}

        </div>

      </div>

    </div>


    <!-- =========================================
         FINAL LOCKUP
    ========================================== -->

    <div class="qp-final-lockup">

      <div class="qp-final-content">

        <div class="qp-final-brand">
          QUESTPROPS™ NECK RESTORE
        </div>

        <h2>
          A SIMPLE RESET<br>
          FOR YOUR DAY.
        </h2>

        <p>
          EMS stimulation + soothing heat.
        </p>

        <div class="qp-final-price">
          <span class="qp-old-price">$169.99</span>
          <strong>$119.99</strong>
        </div>

        <a
          href="{{ section.settings.button_link }}"
          class="qp-final-button"
        >
          {{ section.settings.button_text }}
          <span>→</span>
        </a>

        <div class="qp-final-trust">
          60-Day Trial&nbsp;&nbsp;·&nbsp;&nbsp;
          2-Year Warranty&nbsp;&nbsp;·&nbsp;&nbsp;
          Free Shipping
        </div>

      </div>

    </div>

  </div>

</section>


<style>

/* =====================================================
   ROOT
===================================================== */

#qp-brand-scroll-{{ section.id }} {

  --bg: #f3f1ec;

  --text: #171717;

  position: relative;

  width: 100%;

  background: var(--bg);

  color: var(--text);

  overflow: clip;

}


/* =====================================================
   SCROLL LENGTH
===================================================== */

#qp-brand-scroll-{{ section.id }}
.qp-scroll-stage {

  position: relative;

  height: 620vh;

}


/* =====================================================
   FIXED CANVAS
===================================================== */

#qp-brand-scroll-{{ section.id }}
.qp-fixed-canvas {

  position: sticky;

  top: 0;

  height: 100vh;

  height: 100svh;

  width: 100%;

  overflow: hidden;

  z-index: 1;

  pointer-events: none;

}


/* =====================================================
   TOP BRAND LABEL
===================================================== */

#qp-brand-scroll-{{ section.id }}
.qp-kicker {

  position: absolute;

  top: 28px;

  left: 32px;

  font-size: 10px;

  font-weight: 600;

  letter-spacing: .18em;

}


/* =====================================================
   GIANT TYPE
===================================================== */

#qp-brand-scroll-{{ section.id }}
.qp-big-text {

  position: absolute;

  white-space: nowrap;

  font-size: clamp(
    100px,
    14.5vw,
    235px
  );

  font-weight: 800;

  line-height: .78;

  letter-spacing: -.085em;

  text-transform: uppercase;

}


/* =====================================================
   TYPOGRAPHY COMPOSITION
===================================================== */

#qp-brand-scroll-{{ section.id }}
.qp-text-top {

  top: 18%;

  left: -3%;

}


#qp-brand-scroll-{{ section.id }}
.qp-text-bottom {

  top: 58%;

  right: -5%;

}


/* =====================================================
   SMALL TECH LINE
===================================================== */

#qp-brand-scroll-{{ section.id }}
.qp-small-line {

  position: absolute;

  bottom: 30px;

  right: 32px;

  font-size: 10px;

  font-weight: 600;

  letter-spacing: .18em;

}


/* =====================================================
   STICKY PRODUCT
===================================================== */

#qp-brand-scroll-{{ section.id }}
.qp-sticky-product {

  position: sticky;

  top: 0;

  height: 100vh;

  height: 100svh;

  margin-top: -100vh;

  margin-top: -100svh;

  display: flex;

  align-items: center;

  justify-content: center;

  z-index: 10;

  pointer-events: none;

}


/* =====================================================
   PRODUCT
===================================================== */

#qp-brand-scroll-{{ section.id }}
.qp-product {

  position: relative;

  width: min(53vw, 780px);

  transform:

    translate3d(
      0,
      55vh,
      0
    )

    scale(.72);

  will-change: transform;

}


#qp-brand-scroll-{{ section.id }}
.qp-product-image {

  display: block;

  width: 100%;

  height: auto;

  object-fit: contain;

  filter:
    drop-shadow(
      0 30px 45px rgba(0,0,0,.10)
    );

}


/* =====================================================
   PACKAGE
===================================================== */

#qp-brand-scroll-{{ section.id }}
.qp-package {

  position: absolute;

  width: 30%;

  right: -4%;

  bottom: -4%;

  opacity: 0;

  transform:

    translate3d(
      50px,
      70px,
      0
    )

    rotate(7deg)

    scale(.65);

  will-change:
    transform,
    opacity;

}


#qp-brand-scroll-{{ section.id }}
.qp-package-image {

  display: block;

  width: 100%;

  height: auto;

  filter:
    drop-shadow(
      0 20px 30px rgba(0,0,0,.10)
    );

}


/* =====================================================
   FINAL LOCKUP
===================================================== */

#qp-brand-scroll-{{ section.id }}
.qp-final-lockup {

  position: absolute;

  top: 500vh;

  left: 0;

  width: 100%;

  min-height: 120vh;

  display: flex;

  align-items: center;

  justify-content: center;

  z-index: 30;

  pointer-events: none;

}


#qp-brand-scroll-{{ section.id }}
.qp-final-content {

  width: 100%;

  text-align: center;

  opacity: 0;

  transform: translateY(40px);

  transition:

    opacity .9s ease,

    transform .9s
    cubic-bezier(
      .22,
      .61,
      .36,
      1
    );

}


#qp-brand-scroll-{{ section.id }}
.qp-final-content.active {

  opacity: 1;

  transform: translateY(0);

}


/* =====================================================
   FINAL TYPOGRAPHY
===================================================== */

#qp-brand-scroll-{{ section.id }}
.qp-final-brand {

  font-size: 10px;

  font-weight: 600;

  letter-spacing: .22em;

  margin-bottom: 22px;

}


#qp-brand-scroll-{{ section.id }}
.qp-final-content h2 {

  margin: 0;

  font-size: clamp(
    55px,
    7vw,
    112px
  );

  line-height: .84;

  letter-spacing: -.075em;

  font-weight: 800;

}


#qp-brand-scroll-{{ section.id }}
.qp-final-content p {

  margin:

    28px

    0

    18px;

  font-size: 15px;

}


/* =====================================================
   PRICE
===================================================== */

#qp-brand-scroll-{{ section.id }}
.qp-final-price {

  margin-bottom: 24px;

}


#qp-brand-scroll-{{ section.id }}
.qp-old-price {

  margin-right: 10px;

  opacity: .4;

  text-decoration: line-through;

  font-size: 15px;

}


#qp-brand-scroll-{{ section.id }}
.qp-final-price strong {

  font-size: 24px;

}


/* =====================================================
   CTA
===================================================== */

#qp-brand-scroll-{{ section.id }}
.qp-final-button {

  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 18px;

  min-width: 225px;

  padding: 18px 32px;

  background: #171717;

  color: white;

  text-decoration: none;

  font-size: 11px;

  font-weight: 700;

  letter-spacing: .12em;

  pointer-events: auto;

  transition:

    transform .25s ease,

    opacity .25s ease;

}


#qp-brand-scroll-{{ section.id }}
.qp-final-button:hover {

  transform: translateY(-2px);

  opacity: .9;

}


#qp-brand-scroll-{{ section.id }}
.qp-final-trust {

  margin-top: 18px;

  font-size: 10px;

  opacity: .5;

}


/* =====================================================
   MOBILE
===================================================== */

@media screen and (max-width: 749px) {


  #qp-brand-scroll-{{ section.id }}
  .qp-scroll-stage {

    height: 620vh;

  }


  #qp-brand-scroll-{{ section.id }}
  .qp-big-text {

    font-size: 19vw;

    line-height: .78;

    letter-spacing: -.085em;

  }


  #qp-brand-scroll-{{ section.id }}
  .qp-text-top {

    top: 20%;

    left: -8%;

  }


  #qp-brand-scroll-{{ section.id }}
  .qp-text-bottom {

    top: 61%;

    right: -18%;

  }


  #qp-brand-scroll-{{ section.id }}
  .qp-product {

    width: 91vw;

  }


  #qp-brand-scroll-{{ section.id }}
  .qp-package {

    width: 38%;

    right: -3%;

    bottom: -3%;

  }


  #qp-brand-scroll-{{ section.id }}
  .qp-kicker {

    top: 20px;

    left: 18px;

    font-size: 8px;

  }


  #qp-brand-scroll-{{ section.id }}
  .qp-small-line {

    bottom: 20px;

    right: 18px;

    font-size: 8px;

  }


  #qp-brand-scroll-{{ section.id }}
  .qp-final-content {

    padding: 0 20px;

  }


  #qp-brand-scroll-{{ section.id }}
  .qp-final-content h2 {

    font-size: 13vw;

  }


  #qp-brand-scroll-{{ section.id }}
  .qp-final-content p {

    font-size: 13px;

  }


}


/* =====================================================
   REDUCED MOTION
===================================================== */

@media
(prefers-reduced-motion: reduce) {

  #qp-brand-scroll-{{ section.id }}
  .qp-product {

    transform:
      translate3d(
        0,
        0,
        0
      )
      scale(1);

  }

}

</style>


<script>

(function() {

  const root =
    document.querySelector(
      '#qp-brand-scroll-{{ section.id }}'
    );

  if (!root) return;


  const stage =
    root.querySelector(
      '.qp-scroll-stage'
    );

  const product =
    root.querySelector(
      '.qp-product'
    );

  const packageBox =
    root.querySelector(
      '.qp-package'
    );

  const final =
    root.querySelector(
      '.qp-final-content'
    );


  function update() {

    const rect =
      stage.getBoundingClientRect();

    const total =
      stage.offsetHeight -
      window.innerHeight;


    if (total <= 0) return;


    let progress =
      -rect.top / total;


    progress =
      Math.max(
        0,
        Math.min(
          1,
          progress
        )
      );


    /* =========================================
       PRODUCT JOURNEY

       0.00
       ↓
       product enters from bottom

       0.25
       ↓
       centered

       0.55
       ↓
       begins growing

       0.72
       ↓
       package enters

       0.82
       ↓
       final lockup
    ========================================== */

    let y;

    let x;

    let scale;

    let rotate;


    if (progress < .22) {

      const p =
        progress / .22;


      y =
        55 -
        (55 * p);


      x = 0;


      scale =
        .72 +
        (.20 * p);


      rotate =
        -3 +
        (3 * p);

    }

    else if (progress < .50) {

      const p =
        (progress - .22) /
        .28;


      y = 0;


      x =
        -5 * p;


      scale =
        .92 +
        (.08 * p);


      rotate = 0;

    }

    else if (progress < .72) {

      const p =
        (progress - .50) /
        .22;


      y =
        -3 * p;


      x =
        -5 +
        (10 * p);


      scale =
        1 +
        (.18 * p);


      rotate =
        -1 +
        (2 * p);

    }

    else {

      const p =
        Math.min(
          1,
          (progress - .72) /
          .12
        );


      y = -3;


      x =
        5 -
        (5 * p);


      scale =
        1.18 +
        (.04 * p);


      rotate =
        1 -
        p;

    }


    product.style.transform =

      `translate3d(
        ${x}vw,
        ${y}vh,
        0
      )
      scale(${scale})
      rotate(${rotate}deg)`;


    /* =========================================
       PACKAGE ENTERS VERY LATE
    ========================================== */

    if (packageBox) {

      let p =
        (progress - .67) /
        .14;


      p =
        Math.max(
          0,
          Math.min(
            1,
            p
          )
        );


      packageBox.style.opacity = p;


      packageBox.style.transform =

        `translate3d(
          ${50 - (50 * p)}px,
          ${70 - (70 * p)}px,
          0
        )
        rotate(
          ${7 - (7 * p)}deg
        )
        scale(
          ${.65 + (.35 * p)}
        )`;

    }


    /* =========================================
       FINAL CTA
    ========================================== */

    if (progress > .82) {

      final.classList.add(
        'active'
      );

    } else {

      final.classList.remove(
        'active'
      );

    }

  }


  let ticking = false;


  function requestUpdate() {

    if (ticking) return;


    ticking = true;


    requestAnimationFrame(
      function() {

        update();

        ticking = false;

      }
    );

  }


  window.addEventListener(
    'scroll',
    requestUpdate,
    {
      passive: true
    }
  );


  window.addEventListener(
    'resize',
    requestUpdate
  );


  update();

})();

</script>


{% schema %}

{
  "name": "QP Brand Product Scroll",

  "settings": [

    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product image"
    },

    {
      "type": "image_picker",
      "id": "package_image",
      "label": "Packaging image"
    },

    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SHOP NECK RESTORE"
    },

    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }

  ],

  "presets": [
    {
      "name": "QP Brand Product Scroll"
    }
  ]

}

{% endschema %}