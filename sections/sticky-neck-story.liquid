<section id="QPScroll-{{ section.id }}" class="qp-scroll">

  <!-- =====================================================
       SCENE 01
       ===================================================== -->

  <div class="qp-scene qp-scene-1">

    <div class="qp-sticky">

      <div class="qp-bg-text qp-bg-text-1">
        TENSION
      </div>

      <div class="qp-scene-label qp-label-1">
        THE DAILY BUILDUP
      </div>

      <div class="qp-product qp-product-1">

        {% if section.settings.product_image != blank %}

          {{
            section.settings.product_image
            | image_url: width: 1800
            | image_tag:
              widths: '500,800,1200,1600,1800',
              loading: 'lazy',
              class: 'qp-product-image'
          }}

        {% endif %}

      </div>

      <div class="qp-copy qp-copy-1">

        <h2>
          Your neck<br>
          does a lot.
        </h2>

        <p>
          Sitting. Driving. Working.
          Tension can quietly build throughout the day.
        </p>

      </div>

      <div class="qp-card qp-card-left">

        <strong>
          LONG HOURS
        </strong>

        <span>
          Sitting, driving or working.
        </span>

      </div>

      <div class="qp-card qp-card-right">

        <strong>
          DAILY TENSION
        </strong>

        <span>
          Give your neck a moment to reset.
        </span>

      </div>

    </div>

  </div>


  <!-- =====================================================
       SCENE 02
       ===================================================== -->

  <div class="qp-scene qp-scene-2">

    <div class="qp-sticky">

      <div class="qp-bg-text qp-bg-text-2">
        RESET
      </div>

      <div class="qp-scene-label qp-label-2">
        QUESTPROPS™ NECK RESTORE
      </div>

      <div class="qp-product qp-product-2">

        {% if section.settings.product_image != blank %}

          {{
            section.settings.product_image
            | image_url: width: 1800
            | image_tag:
              widths: '500,800,1200,1600,1800',
              loading: 'lazy',
              class: 'qp-product-image'
          }}

        {% endif %}

      </div>


      <div class="qp-tag qp-tag-ems">
        EMS
      </div>

      <div class="qp-tag qp-tag-heat">
        HEAT
      </div>


      <div class="qp-feature-copy">

        <div class="qp-feature feature-1">

          <small>
            01
          </small>

          <h3>
            Gentle EMS
          </h3>

          <p>
            Designed to provide soothing electrical stimulation around the neck.
          </p>

        </div>


        <div class="qp-feature feature-2">

          <small>
            02
          </small>

          <h3>
            Soothing Heat
          </h3>

          <p>
            Warmth helps create a relaxing part of your daily routine.
          </p>

        </div>


        <div class="qp-feature feature-3">

          <small>
            03
          </small>

          <h3>
            One Simple Reset
          </h3>

          <p>
            Put it on, relax and give yourself ten minutes.
          </p>

        </div>

      </div>

    </div>

  </div>


  <!-- =====================================================
       SCENE 03
       ===================================================== -->

  <div class="qp-scene qp-scene-3">

    <div class="qp-sticky">

      <div class="qp-big-number">
        10
      </div>

      <div class="qp-minute-label">
        MINUTES A DAY
      </div>

      <div class="qp-product qp-product-3">

        {% if section.settings.product_image != blank %}

          {{
            section.settings.product_image
            | image_url: width: 1600
            | image_tag:
              widths: '500,800,1200,1600',
              loading: 'lazy',
              class: 'qp-product-image'
          }}

        {% endif %}

      </div>

      <div class="qp-final-copy">

        <h2>
          A simple reset<br>
          you can actually stick with.
        </h2>

        <p>
          Just 10 minutes a day.
        </p>

      </div>

    </div>

  </div>


  <!-- =====================================================
       FINAL CTA
       ===================================================== -->

  <div class="qp-final">

    <div>

      <span>
        QUESTPROPS™ NECK RESTORE
      </span>

      <h2>
        Your daily<br>
        neck reset.
      </h2>

      {% if section.settings.product_url != blank %}

        <a href="{{ section.settings.product_url }}">
          RESET YOUR NECK
        </a>

      {% endif %}

    </div>

  </div>

</section>



<style>

/* =========================================================
   BASE
   ========================================================= */

#QPScroll-{{ section.id }} {

  --bg: #ffffff;
  --text: #171717;
  --muted: rgba(23,23,23,.48);
  --yellow: #fde047;

  background: var(--bg);
  color: var(--text);

  width: 100%;

  overflow: clip;

}


/* =========================================================
   SCENE
   ========================================================= */

#QPScroll-{{ section.id }} .qp-scene {

  position: relative;
  width: 100%;

}


#QPScroll-{{ section.id }} .qp-scene-1 {
  height: 160vh;
}


#QPScroll-{{ section.id }} .qp-scene-2 {
  height: 210vh;
}


#QPScroll-{{ section.id }} .qp-scene-3 {
  height: 170vh;
}


/* =========================================================
   STICKY
   ========================================================= */

#QPScroll-{{ section.id }} .qp-sticky {

  position: sticky;

  top: 0;

  width: 100%;

  height: 100vh;
  height: 100svh;

  overflow: hidden;

}


/* =========================================================
   BACKGROUND TEXT
   ========================================================= */

#QPScroll-{{ section.id }} .qp-bg-text {

  position: absolute;

  left: 0;

  top: 50%;

  z-index: 1;

  white-space: nowrap;

  font-size: clamp(110px,17vw,300px);

  line-height: .75;

  font-weight: 900;

  letter-spacing: -.09em;

  color: rgba(23,23,23,.055);

  pointer-events: none;

  will-change: transform, opacity;

}


/* =========================================================
   PRODUCT
   ========================================================= */

#QPScroll-{{ section.id }} .qp-product {

  position: absolute;

  left: 50%;
  top: 50%;

  z-index: 5;

  width: min(58vw,760px);

  transform:
    translate(-50%,-50%);

  will-change: transform, opacity;

}


#QPScroll-{{ section.id }} .qp-product-image {

  display: block;

  width: 100%;
  height: auto;

  object-fit: contain;

}


/* =========================================================
   LABEL
   ========================================================= */

#QPScroll-{{ section.id }} .qp-scene-label {

  position: absolute;

  z-index: 10;

  top: 9vh;
  left: 7vw;

  font-size: 10px;

  letter-spacing: .3em;

  color: var(--muted);

}


/* =========================================================
   SCENE 1 COPY
   ========================================================= */

#QPScroll-{{ section.id }} .qp-copy-1 {

  position: absolute;

  left: 7vw;
  bottom: 9vh;

  z-index: 10;

  max-width: 400px;

  opacity: 0;

  will-change: transform, opacity;

}


#QPScroll-{{ section.id }} .qp-copy-1 h2 {

  margin: 0 0 15px;

  font-size: clamp(42px,5vw,75px);

  line-height: .9;

  letter-spacing: -.06em;

}


#QPScroll-{{ section.id }} .qp-copy-1 p {

  max-width: 340px;

  margin: 0;

  font-size: 15px;

  line-height: 1.5;

  color: var(--muted);

}


/* =========================================================
   CARDS
   ========================================================= */

#QPScroll-{{ section.id }} .qp-card {

  position: absolute;

  z-index: 10;

  bottom: 12vh;

  width: 220px;

  opacity: 0;

  will-change: transform, opacity;

}


#QPScroll-{{ section.id }} .qp-card-left {
  left: 6vw;
}


#QPScroll-{{ section.id }} .qp-card-right {
  right: 6vw;
}


#QPScroll-{{ section.id }} .qp-card strong {

  display: block;

  font-size: 10px;

  letter-spacing: .2em;

}


#QPScroll-{{ section.id }} .qp-card span {

  display: block;

  margin-top: 8px;

  font-size: 13px;

  line-height: 1.4;

  color: var(--muted);

}


/* =========================================================
   SCENE 2
   ========================================================= */

#QPScroll-{{ section.id }} .qp-product-2 {

  opacity: 0;

  transform:
    translate(-50%,-50%)
    scale(.82);

}


#QPScroll-{{ section.id }} .qp-tag {

  position: absolute;

  z-index: 10;

  padding: 10px 17px;

  border-radius: 999px;

  background: var(--yellow);

  font-size: 10px;

  font-weight: 800;

  letter-spacing: .15em;

  opacity: 0;

  will-change: transform, opacity;

}


#QPScroll-{{ section.id }} .qp-tag-ems {

  left: 14%;
  top: 35%;

}


#QPScroll-{{ section.id }} .qp-tag-heat {

  right: 14%;
  top: 61%;

}


/* =========================================================
   FEATURE COPY
   ========================================================= */

#QPScroll-{{ section.id }} .qp-feature-copy {

  position: absolute;

  z-index: 20;

  right: 7vw;

  top: 50%;

  width: min(32vw,430px);

  transform:
    translate(100px,-50%);

  opacity: 0;

  will-change: transform, opacity;

}


#QPScroll-{{ section.id }} .qp-feature {

  position: absolute;

  left: 0;
  top: 0;

  width: 100%;

  opacity: 0;

  transform: translateY(30px);

  will-change: transform, opacity;

}


#QPScroll-{{ section.id }} .qp-feature small {

  font-size: 10px;

  letter-spacing: .2em;

  color: var(--muted);

}


#QPScroll-{{ section.id }} .qp-feature h3 {

  margin: 12px 0;

  font-size: clamp(30px,4vw,55px);

  line-height: .95;

  letter-spacing: -.05em;

}


#QPScroll-{{ section.id }} .qp-feature p {

  margin: 0;

  max-width: 330px;

  font-size: 14px;

  line-height: 1.5;

  color: var(--muted);

}


/* =========================================================
   SCENE 3
   ========================================================= */

#QPScroll-{{ section.id }} .qp-big-number {

  position: absolute;

  z-index: 1;

  left: 50%;
  top: 45%;

  transform:
    translate(-50%,-50%);

  font-size: clamp(180px,32vw,520px);

  font-weight: 900;

  line-height: .7;

  letter-spacing: -.1em;

  color: rgba(23,23,23,.055);

  will-change: transform;

}


#QPScroll-{{ section.id }} .qp-minute-label {

  position: absolute;

  z-index: 10;

  top: 25%;
  left: 50%;

  transform:
    translateX(-50%);

  font-size: 10px;

  letter-spacing: .3em;

  color: var(--muted);

}


#QPScroll-{{ section.id }} .qp-product-3 {

  width: min(43vw,540px);

}


#QPScroll-{{ section.id }} .qp-final-copy {

  position: absolute;

  left: 50%;
  bottom: 9vh;

  z-index: 10;

  width: 90%;

  text-align: center;

  transform:
    translateX(-50%);

  opacity: 0;

  will-change: transform, opacity;

}


#QPScroll-{{ section.id }} .qp-final-copy h2 {

  margin: 0;

  font-size: clamp(32px,4vw,60px);

  line-height: .95;

  letter-spacing: -.05em;

}


#QPScroll-{{ section.id }} .qp-final-copy p {

  margin-top: 15px;

  color: var(--muted);

}


/* =========================================================
   FINAL
   ========================================================= */

#QPScroll-{{ section.id }} .qp-final {

  min-height: 70vh;

  display: flex;

  align-items: center;
  justify-content: center;

  padding: 80px 20px;

  text-align: center;

}


#QPScroll-{{ section.id }} .qp-final span {

  font-size: 10px;

  letter-spacing: .3em;

  color: var(--muted);

}


#QPScroll-{{ section.id }} .qp-final h2 {

  margin: 20px 0 35px;

  font-size: clamp(45px,7vw,90px);

  line-height: .88;

  letter-spacing: -.06em;

}


#QPScroll-{{ section.id }} .qp-final a {

  display: inline-flex;

  padding: 16px 28px;

  background: var(--text);

  color: #fff;

  text-decoration: none;

  font-size: 11px;

  font-weight: 700;

  letter-spacing: .15em;

}


/* =========================================================
   MOBILE
   ========================================================= */

@media screen and (max-width: 749px) {


  /* -------------------------------------------------------
     SCENE HEIGHT
     ------------------------------------------------------- */

  #QPScroll-{{ section.id }} .qp-scene-1 {
    height: 175vh;
  }


  #QPScroll-{{ section.id }} .qp-scene-2 {
    height: 220vh;
  }


  #QPScroll-{{ section.id }} .qp-scene-3 {
    height: 175vh;
  }


  /* -------------------------------------------------------
     STICKY
     ------------------------------------------------------- */

  #QPScroll-{{ section.id }} .qp-sticky {

    height: 100svh;

  }


  /* -------------------------------------------------------
     BIG TEXT
     ------------------------------------------------------- */

  #QPScroll-{{ section.id }} .qp-bg-text {

    font-size: 25vw;

    top: 43%;

  }


  /* -------------------------------------------------------
     LABEL
     ------------------------------------------------------- */

  #QPScroll-{{ section.id }} .qp-scene-label {

    top: 6vh;

    left: 20px;

    font-size: 8px;

    letter-spacing: .22em;

  }


  /* -------------------------------------------------------
     PRODUCT
     ------------------------------------------------------- */

  #QPScroll-{{ section.id }} .qp-product {

    width: 86vw;

    top: 45%;

  }


  /* -------------------------------------------------------
     SCENE 1 COPY
     ------------------------------------------------------- */

  #QPScroll-{{ section.id }} .qp-copy-1 {

    left: 20px;
    right: 20px;

    bottom: 7vh;

    max-width: none;

  }


  #QPScroll-{{ section.id }} .qp-copy-1 h2 {

    font-size: 44px;

  }


  #QPScroll-{{ section.id }} .qp-copy-1 p {

    font-size: 13px;

    max-width: 300px;

  }


  /* -------------------------------------------------------
     MOBILE CARDS
     ------------------------------------------------------- */

  #QPScroll-{{ section.id }} .qp-card {

    bottom: 20vh;

    width: 130px;

  }


  #QPScroll-{{ section.id }} .qp-card-left {

    left: 20px;

  }


  #QPScroll-{{ section.id }} .qp-card-right {

    right: 20px;

  }


  #QPScroll-{{ section.id }} .qp-card strong {

    font-size: 8px;

  }


  #QPScroll-{{ section.id }} .qp-card span {

    font-size: 11px;

  }


  /* -------------------------------------------------------
     SCENE 2 PRODUCT
     ------------------------------------------------------- */

  #QPScroll-{{ section.id }} .qp-product-2 {

    width: 88vw;

    top: 42%;

  }


  /* -------------------------------------------------------
     TAGS
     ------------------------------------------------------- */

  #QPScroll-{{ section.id }} .qp-tag {

    padding: 8px 13px;

    font-size: 8px;

  }


  #QPScroll-{{ section.id }} .qp-tag-ems {

    left: 8%;

    top: 30%;

  }


  #QPScroll-{{ section.id }} .qp-tag-heat {

    right: 8%;

    top: 58%;

  }


  /* -------------------------------------------------------
     FEATURE COPY
     ------------------------------------------------------- */

  #QPScroll-{{ section.id }} .qp-feature-copy {

    left: 20px;
    right: 20px;

    top: auto;
    bottom: 8vh;

    width: auto;

    transform:
      translateY(40px);

  }


  #QPScroll-{{ section.id }} .qp-feature {

    width: calc(100vw - 40px);

  }


  #QPScroll-{{ section.id }} .qp-feature h3 {

    font-size: 36px;

  }


  #QPScroll-{{ section.id }} .qp-feature p {

    max-width: 290px;

    font-size: 13px;

  }


  /* -------------------------------------------------------
     SCENE 3
     ------------------------------------------------------- */

  #QPScroll-{{ section.id }} .qp-big-number {

    font-size: 58vw;

    top: 42%;

  }


  #QPScroll-{{ section.id }} .qp-minute-label {

    top: 22%;

    font-size: 8px;

    letter-spacing: .24em;

  }


  #QPScroll-{{ section.id }} .qp-product-3 {

    width: 80vw;

    top: 43%;

  }


  #QPScroll-{{ section.id }} .qp-final-copy {

    bottom: 8vh;

  }


  #QPScroll-{{ section.id }} .qp-final-copy h2 {

    font-size: 34px;

  }


  /* -------------------------------------------------------
     FINAL
     ------------------------------------------------------- */

  #QPScroll-{{ section.id }} .qp-final {

    min-height: 65vh;

  }


  #QPScroll-{{ section.id }} .qp-final h2 {

    font-size: 48px;

  }

}


/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

  #QPScroll-{{ section.id }} .qp-scene {

    height: auto;

  }


  #QPScroll-{{ section.id }} .qp-sticky {

    position: relative;

    height: 100svh;

  }

}

</style>



<script>

(function() {

  const root =
    document.getElementById(
      'QPScroll-{{ section.id }}'
    );

  if (!root) return;


  let ticking = false;


  /* =====================================================
     HELPERS
     ===================================================== */

  function clamp(v) {

    return Math.max(
      0,
      Math.min(1,v)
    );

  }


  function map(
    value,
    a,
    b,
    c,
    d
  ) {

    const t =
      clamp(
        (value-a)/(b-a)
      );

    return c+(d-c)*t;

  }


  function getProgress(scene) {

    const rect =
      scene.getBoundingClientRect();

    const distance =
      scene.offsetHeight -
      window.innerHeight;

    if (distance <= 0) {
      return 0;
    }

    return clamp(
      -rect.top/distance
    );

  }


  /* =====================================================
     UPDATE
     ===================================================== */

  function update() {

    ticking = false;


    const mobile =
      window.innerWidth <= 749;


    /* ===================================================
       SCENE 01
       =================================================== */

    const scene1 =
      root.querySelector(
        '.qp-scene-1'
      );


    if (scene1) {

      const p =
        getProgress(scene1);


      const word =
        root.querySelector(
          '.qp-bg-text-1'
        );


      const product =
        root.querySelector(
          '.qp-product-1'
        );


      const copy =
        root.querySelector(
          '.qp-copy-1'
        );


      const cards =
        root.querySelectorAll(
          '.qp-scene-1 .qp-card'
        );


      /* BIG WORD */

      word.style.transform =
        `
        translate3d(
          ${map(
            p,
            0,
            .65,
            mobile ? 18 : 28,
            mobile ? -18 : -25
          )}vw,
          -50%,
          0
        )
        `;


      word.style.opacity =
        map(
          p,
          .65,
          .9,
          1,
          0
        );


      /* PRODUCT */

      product.style.transform =
        `
        translate3d(
          -50%,
          -50%,
          0
        )
        scale(
          ${map(
            p,
            0,
            .55,
            mobile ? 1.08 : 1.22,
            1
          )}
        )
        `;


      /* COPY */

      const copyP =
        clamp(
          (p-.35)/.2
        );


      copy.style.opacity =
        copyP;


      copy.style.transform =
        `
        translateY(
          ${map(
            copyP,
            0,
            1,
            35,
            0
          )}px
        )
        `;


      /* CARDS */

      const cardP =
        clamp(
          (p-.12)/.3
        );


      cards.forEach(
        function(card,index) {

          card.style.opacity =
            cardP;


          card.style.transform =
            `
            translateY(
              ${map(
                cardP,
                0,
                1,
                25,
                0
              )}px
            )
            `;

        }
      );

    }


    /* ===================================================
       SCENE 02
       =================================================== */

    const scene2 =
      root.querySelector(
        '.qp-scene-2'
      );


    if (scene2) {

      const p =
        getProgress(scene2);


      const word =
        root.querySelector(
          '.qp-bg-text-2'
        );


      const product =
        root.querySelector(
          '.qp-product-2'
        );


      const tagEms =
        root.querySelector(
          '.qp-tag-ems'
        );


      const tagHeat =
        root.querySelector(
          '.qp-tag-heat'
        );


      const featureCopy =
        root.querySelector(
          '.qp-feature-copy'
        );


      const features =
        root.querySelectorAll(
          '.qp-feature'
        );


      /* WORD */

      word.style.transform =
        `
        translate3d(
          ${map(
            p,
            0,
            .7,
            mobile ? 20 : 30,
            mobile ? -20 : -28
          )}vw,
          -50%,
          0
        )
        `;


      word.style.opacity =
        map(
          p,
          .7,
          .95,
          1,
          0
        );


      /* PRODUCT */

      const productP =
        clamp(
          p/.35
        );


      product.style.opacity =
        productP;


      product.style.transform =
        `
        translate3d(
          -50%,
          -50%,
          0
        )
        scale(
          ${map(
            productP,
            0,
            1,
            .8,
            1
          )}
        )
        `;


      /* EMS */

      const emsP =
        clamp(
          (p-.12)/.15
        );


      tagEms.style.opacity =
        emsP;


      tagEms.style.transform =
        `
        translateY(
          ${map(
            emsP,
            0,
            1,
            20,
            0
          )}px
        )
        scale(
          ${map(
            emsP,
            0,
            1,
            .8,
            1
          )}
        )
        `;


      /* HEAT */

      const heatP =
        clamp(
          (p-.25)/.15
        );


      tagHeat.style.opacity =
        heatP;


      tagHeat.style.transform =
        `
        translateY(
          ${map(
            heatP,
            0,
            1,
            20,
            0
          )}px
        )
        scale(
          ${map(
            heatP,
            0,
            1,
            .8,
            1
          )}
        )
        `;


      /* COPY */

      const copyP =
        clamp(
          (p-.38)/.2
        );


      featureCopy.style.opacity =
        copyP;


      featureCopy.style.transform =
        mobile
          ?
          `
          translateY(
            ${map(
              copyP,
              0,
              1,
              40,
              0
            )}px
          )
          `
          :
          `
          translate(
            ${map(
              copyP,
              0,
              1,
              100,
              0
            )}px,
            -50%
          )
          `;


      /* FEATURES */

      const starts =
        mobile
          ?
          [.45,.63,.81]
          :
          [.48,.64,.80];


      features.forEach(
        function(
          feature,
          index
        ) {

          const fp =
            clamp(
              (p-starts[index])/.11
            );


          feature.style.opacity =
            fp;


          feature.style.transform =
            `
            translateY(
              ${map(
                fp,
                0,
                1,
                30,
                0
              )}px
            )
            `;

        }
      );

    }


    /* ===================================================
       SCENE 03
       =================================================== */

    const scene3 =
      root.querySelector(
        '.qp-scene-3'
      );


    if (scene3) {

      const p =
        getProgress(scene3);


      const number =
        root.querySelector(
          '.qp-big-number'
        );


      const product =
        root.querySelector(
          '.qp-product-3'
        );


      const copy =
        root.querySelector(
          '.qp-final-copy'
        );


      /* NUMBER */

      number.style.transform =
        `
        translate(
          -50%,
          -50%
        )
        scale(
          ${map(
            p,
            0,
            .7,
            1.15,
            1
          )}
        )
        `;


      /* PRODUCT */

      product.style.transform =
        `
        translate(
          -50%,
          calc(
            -50% +
            ${map(
              p,
              0,
              .7,
              0,
              -70
            )}px
          )
        )
        scale(
          ${map(
            p,
            0,
            .75,
            1,
            .72
          )}
        )
        `;


      /* COPY */

      const copyP =
        clamp(
          (p-.65)/.2
        );


      copy.style.opacity =
        copyP;


      copy.style.transform =
        `
        translate(
          -50%,
          ${map(
            copyP,
            0,
            1,
            35,
            0
          )}px
        )
        `;

    }

  }


  /* =====================================================
     SCROLL
     ===================================================== */

  function requestUpdate() {

    if (ticking) return;

    ticking = true;

    window.requestAnimationFrame(
      update
    );

  }


  window.addEventListener(
    'scroll',
    requestUpdate,
    {
      passive: true
    }
  );


  window.addEventListener(
    'resize',
    requestUpdate
  );


  update();

})();

</script>



