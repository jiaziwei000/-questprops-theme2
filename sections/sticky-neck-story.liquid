<section id="qp-scroll-{{ section.id }}" class="qp-scroll">

  <!-- =========================
       SCENE 01
       ========================= -->

  <div class="qp-scene qp-scene-01">

    <div class="qp-sticky">

      <div class="qp-bg-text qp-bg-01">
        {{ section.settings.bg_text_01 }}
      </div>

      <div class="qp-label">
        {{ section.settings.label_01 }}
      </div>

      <!-- 产品展示窗口 -->
      <div class="qp-product-window">

        <div class="qp-product">

          {% if section.settings.product_image != blank %}

            {{
              section.settings.product_image
              | image_url: width: 1800
              | image_tag:
                widths: '400,600,800,1200,1600,1800',
                sizes: '90vw',
                loading: 'eager',
                class: 'qp-product-image'
            }}

          {% else %}

            <div class="qp-placeholder">
              ADD PRODUCT IMAGE
            </div>

          {% endif %}

        </div>

      </div>


      <!-- Hero 文案 -->

      <div class="qp-hero-copy">

        <div class="qp-small-label">
          {{ section.settings.small_label }}
        </div>

        <h1>
          {{ section.settings.heading }}
        </h1>

        <div class="qp-description">
          {{ section.settings.description }}
        </div>

      </div>


      <!-- 右侧信息 -->

      <div class="qp-side-info">

        {% for block in section.blocks %}

          {% if block.type == 'feature' %}

            <div
              class="qp-feature"
              {{ block.shopify_attributes }}
            >

              <div class="qp-feature-number">
                {{ block.settings.number }}
              </div>

              <div>

                <h3>
                  {{ block.settings.title }}
                </h3>

                <p>
                  {{ block.settings.text }}
                </p>

              </div>

            </div>

          {% endif %}

        {% endfor %}

      </div>

    </div>

  </div>


  <!-- =========================
       SCENE 02
       ========================= -->

  <div class="qp-scene qp-scene-02">

    <div class="qp-sticky">

      <div class="qp-bg-text qp-bg-02">
        {{ section.settings.bg_text_02 }}
      </div>

      <div class="qp-label">
        {{ section.settings.label_02 }}
      </div>


      <div class="qp-scene02-image">

        {% if section.settings.image_02 != blank %}

          {{
            section.settings.image_02
            | image_url: width: 1600
            | image_tag:
              widths: '400,600,800,1200,1600',
              sizes: '90vw',
              loading: 'lazy'
          }}

        {% endif %}

      </div>


      <div class="qp-scene02-copy">

        <h2>
          {{ section.settings.heading_02 }}
        </h2>

        <div>
          {{ section.settings.text_02 }}
        </div>

      </div>


      <div class="qp-scene02-cards">

        {% for block in section.blocks %}

          {% if block.type == 'story_card' %}

            <div
              class="qp-story-card"
              {{ block.shopify_attributes }}
            >

              {% if block.settings.image != blank %}

                {{
                  block.settings.image
                  | image_url: width: 600
                  | image_tag:
                    widths: '300,400,600',
                    sizes: '30vw',
                    loading: 'lazy'
                }}

              {% endif %}

              <span>
                {{ block.settings.number }}
              </span>

              <h3>
                {{ block.settings.title }}
              </h3>

              <p>
                {{ block.settings.text }}
              </p>

            </div>

          {% endif %}

        {% endfor %}

      </div>

    </div>

  </div>


  <!-- =========================
       SCENE 03
       ========================= -->

  <div class="qp-scene qp-scene-03">

    <div class="qp-sticky">

      <div class="qp-bg-text qp-bg-03">
        {{ section.settings.bg_text_03 }}
      </div>

      <div class="qp-label">
        {{ section.settings.label_03 }}
      </div>


      <div class="qp-how-product">

        {% if section.settings.image_03 != blank %}

          {{
            section.settings.image_03
            | image_url: width: 1800
            | image_tag:
              widths: '400,600,800,1200,1600,1800',
              sizes: '90vw',
              loading: 'lazy'
          }}

        {% endif %}

      </div>


      <div class="qp-how-title">

        <h2>
          {{ section.settings.heading_03 }}
        </h2>

      </div>


      <div class="qp-how-list">

        {% for block in section.blocks %}

          {% if block.type == 'how_item' %}

            <div
              class="qp-how-item"
              {{ block.shopify_attributes }}
            >

              <span>
                {{ block.settings.number }}
              </span>

              <div>

                <h3>
                  {{ block.settings.title }}
                </h3>

                <p>
                  {{ block.settings.text }}
                </p>

              </div>

            </div>

          {% endif %}

        {% endfor %}

      </div>

    </div>

  </div>


  <!-- =========================
       SCENE 04
       ========================= -->

  <div class="qp-scene qp-scene-04">

    <div class="qp-sticky">

      <div class="qp-big-number">
        {{ section.settings.big_number }}
      </div>

      <div class="qp-number-label">
        {{ section.settings.number_label }}
      </div>


      <div class="qp-final-product">

        {% if section.settings.image_04 != blank %}

          {{
            section.settings.image_04
            | image_url: width: 1800
            | image_tag:
              widths: '400,600,800,1200,1600,1800',
              sizes: '90vw',
              loading: 'lazy'
          }}

        {% endif %}

      </div>


      <div class="qp-final-copy">

        <h2>
          {{ section.settings.heading_04 }}
        </h2>

        <div>
          {{ section.settings.text_04 }}
        </div>

      </div>

    </div>

  </div>


  <!-- =========================
       FINAL CTA
       ========================= -->

  <div class="qp-final">

    <div class="qp-final-inner">

      <div class="qp-label">
        {{ section.settings.final_label }}
      </div>

      <h2>
        {{ section.settings.final_heading }}
      </h2>

      <div class="qp-final-description">
        {{ section.settings.final_description }}
      </div>

      {% if section.settings.button_text != blank %}

        <a
          href="{{ section.settings.button_link }}"
          class="qp-button"
        >
          {{ section.settings.button_text }}
        </a>

      {% endif %}

    </div>

  </div>

</section>


<style>

#qp-scroll-{{ section.id }} {

  --bg: {{ section.settings.background }};
  --text: {{ section.settings.text }};
  --muted: {{ section.settings.muted }};
  --accent: {{ section.settings.accent }};

  background: var(--bg);
  color: var(--text);

  overflow: clip;

}


#qp-scroll-{{ section.id }} * {

  box-sizing: border-box;

}


/* =====================================================
   SCENE
   ===================================================== */

#qp-scroll-{{ section.id }} .qp-scene {

  position: relative;
  width: 100%;

}


#qp-scroll-{{ section.id }} .qp-scene-01 {

  height: 200vh;

}


#qp-scroll-{{ section.id }} .qp-scene-02 {

  height: 210vh;

}


#qp-scroll-{{ section.id }} .qp-scene-03 {

  height: 210vh;

}


#qp-scroll-{{ section.id }} .qp-scene-04 {

  height: 190vh;

}


/* =====================================================
   STICKY
   ===================================================== */

#qp-scroll-{{ section.id }} .qp-sticky {

  position: sticky;

  top: 0;

  width: 100%;

  height: 100vh;

  height: 100svh;

  overflow: hidden;

}


/* =====================================================
   BACKGROUND TEXT
   ===================================================== */

#qp-scroll-{{ section.id }} .qp-bg-text {

  position: absolute;

  z-index: 1;

  left: 0;

  top: 50%;

  white-space: nowrap;

  font-size: clamp(
    140px,
    19vw,
    340px
  );

  font-weight: 900;

  line-height: .72;

  letter-spacing: -.09em;

  color: rgba(0,0,0,.055);

  pointer-events: none;

  user-select: none;

  will-change: transform, opacity;

}


/* =====================================================
   LABEL
   ===================================================== */

#qp-scroll-{{ section.id }} .qp-label {

  position: absolute;

  z-index: 40;

  top: 7vh;

  left: 6vw;

  font-size: 10px;

  line-height: 1;

  letter-spacing: .3em;

  text-transform: uppercase;

  color: var(--muted);

}


/* =====================================================
   PRODUCT WINDOW
   ===================================================== */

#qp-scroll-{{ section.id }} .qp-product-window {

  position: absolute;

  z-index: 10;

  left: 50%;

  top: 50%;

  width: min(
    58vw,
    820px
  );

  height: min(
    72vh,
    780px
  );

  transform:
    translate(-50%, -50%);

  overflow: hidden;

}


/* =====================================================
   PRODUCT

   初始：
   rotate 24deg
   scale 1.28
   translate
   clip 只露一部分
   ===================================================== */

#qp-scroll-{{ section.id }} .qp-product {

  position: absolute;

  width: 100%;

  left: 0;

  top: 0;

  transform:
    translate3d(
      18vw,
      12vh,
      0
    )
    rotate(24deg)
    scale(1.28);

  transform-origin: center center;

  clip-path:
    inset(
      0
      0
      35%
      0
    );

  opacity: 0;

  will-change:
    transform,
    clip-path,
    opacity;

}


#qp-scroll-{{ section.id }} .qp-product-image {

  display: block;

  width: 100%;

  height: auto;

  object-fit: contain;

}


/* =====================================================
   PLACEHOLDER
   ===================================================== */

#qp-scroll-{{ section.id }} .qp-placeholder {

  width: 100%;

  aspect-ratio: 1 / 1;

  display: grid;

  place-items: center;

  background: #f4f4f4;

  color: #aaa;

  font-size: 11px;

}


/* =====================================================
   HERO COPY
   ===================================================== */

#qp-scroll-{{ section.id }} .qp-hero-copy {

  position: absolute;

  z-index: 30;

  left: 6vw;

  bottom: 8vh;

  width: min(
    430px,
    40vw
  );

  opacity: 0;

  transform:
    translateY(40px);

  will-change:
    transform,
    opacity;

}


#qp-scroll-{{ section.id }} .qp-small-label {

  margin-bottom: 12px;

  font-size: 10px;

  letter-spacing: .2em;

  text-transform: uppercase;

  color: var(--muted);

}


#qp-scroll-{{ section.id }} .qp-hero-copy h1 {

  margin: 0 0 18px;

  font-size: clamp(
    48px,
    6vw,
    90px
  );

  line-height: .84;

  letter-spacing: -.07em;

}


#qp-scroll-{{ section.id }} .qp-description {

  color: var(--muted);

  font-size: 14px;

  line-height: 1.55;

}


/* =====================================================
   SIDE INFO
   ===================================================== */

#qp-scroll-{{ section.id }} .qp-side-info {

  position: absolute;

  z-index: 30;

  right: 6vw;

  bottom: 8vh;

  display: flex;

  gap: 35px;

}


#qp-scroll-{{ section.id }} .qp-feature {

  width: 170px;

  opacity: 0;

  transform:
    translateY(30px);

  will-change:
    transform,
    opacity;

}


#qp-scroll-{{ section.id }} .qp-feature-number {

  margin-bottom: 10px;

  font-size: 9px;

  letter-spacing: .2em;

  color: var(--muted);

}


#qp-scroll-{{ section.id }} .qp-feature h3 {

  margin: 0 0 8px;

  font-size: 13px;

  letter-spacing: .1em;

  text-transform: uppercase;

}


#qp-scroll-{{ section.id }} .qp-feature p {

  margin: 0;

  color: var(--muted);

  font-size: 12px;

  line-height: 1.45;

}


/* =====================================================
   SCENE 02
   ===================================================== */

#qp-scroll-{{ section.id }} .qp-scene02-image {

  position: absolute;

  z-index: 5;

  left: 50%;

  top: 50%;

  width: min(
    46vw,
    650px
  );

  transform:
    translate(-50%, -50%)
    scale(.75);

  opacity: 0;

  will-change:
    transform,
    opacity;

}


#qp-scroll-{{ section.id }} .qp-scene02-image img {

  width: 100%;

  display: block;

}


#qp-scroll-{{ section.id }} .qp-scene02-copy {

  position: absolute;

  z-index: 30;

  left: 7vw;

  top: 28%;

  width: min(
    32vw,
    420px
  );

  opacity: 0;

  transform:
    translateY(40px);

  will-change:
    transform,
    opacity;

}


#qp-scroll-{{ section.id }} .qp-scene02-copy h2 {

  margin: 0 0 18px;

  font-size: clamp(
    45px,
    5vw,
    75px
  );

  line-height: .86;

  letter-spacing: -.07em;

}


#qp-scroll-{{ section.id }} .qp-scene02-copy > div {

  color: var(--muted);

  font-size: 14px;

  line-height: 1.55;

}


/* =====================================================
   STORY CARDS
   ===================================================== */

#qp-scroll-{{ section.id }} .qp-scene02-cards {

  position: absolute;

  inset: 0;

  z-index: 30;

}


#qp-scroll-{{ section.id }} .qp-story-card {

  position: absolute;

  width: 180px;

  opacity: 0;

  transform:
    translateY(40px);

  will-change:
    transform,
    opacity;

}


#qp-scroll-{{ section.id }} .qp-story-card:nth-child(1) {

  left: 7vw;

  bottom: 13vh;

}


#qp-scroll-{{ section.id }} .qp-story-card:nth-child(2) {

  right: 7vw;

  top: 19vh;

}


#qp-scroll-{{ section.id }} .qp-story-card:nth-child(3) {

  right: 20vw;

  bottom: 10vh;

}


#qp-scroll-{{ section.id }} .qp-story-card:nth-child(4) {

  left: 20vw;

  top: 17vh;

}


#qp-scroll-{{ section.id }} .qp-story-card img {

  width: 100%;

  aspect-ratio: 1;

  object-fit: cover;

  display: block;

  margin-bottom: 12px;

}


#qp-scroll-{{ section.id }} .qp-story-card span {

  font-size: 9px;

  letter-spacing: .2em;

  color: var(--muted);

}


#qp-scroll-{{ section.id }} .qp-story-card h3 {

  margin: 7px 0;

  font-size: 13px;

  letter-spacing: .1em;

}


#qp-scroll-{{ section.id }} .qp-story-card p {

  margin: 0;

  color: var(--muted);

  font-size: 12px;

  line-height: 1.45;

}


/* =====================================================
   SCENE 03
   ===================================================== */

#qp-scroll-{{ section.id }} .qp-how-product {

  position: absolute;

  z-index: 5;

  left: 50%;

  top: 50%;

  width: min(
    52vw,
    740px
  );

  transform:
    translate(-50%, -50%)
    scale(.72);

  opacity: 0;

  will-change:
    transform,
    opacity;

}


#qp-scroll-{{ section.id }} .qp-how-product img {

  width: 100%;

  display: block;

}


#qp-scroll-{{ section.id }} .qp-how-title {

  position: absolute;

  z-index: 30;

  left: 7vw;

  top: 23%;

  opacity: 0;

  transform:
    translateY(40px);

}


#qp-scroll-{{ section.id }} .qp-how-title h2 {

  margin: 0;

  font-size: clamp(
    50px,
    6vw,
    90px
  );

  line-height: .84;

  letter-spacing: -.07em;

}


#qp-scroll-{{ section.id }} .qp-how-list {

  position: absolute;

  z-index: 30;

  right: 7vw;

  top: 50%;

  width: min(
    31vw,
    410px
  );

  transform:
    translate(80px, -50%);

  opacity: 0;

  will-change:
    transform,
    opacity;

}


#qp-scroll-{{ section.id }} .qp-how-item {

  display: flex;

  gap: 18px;

  margin-bottom: 30px;

  opacity: 0;

  transform:
    translateY(30px);

}


#qp-scroll-{{ section.id }} .qp-how-item > span {

  font-size: 9px;

  letter-spacing: .2em;

  color: var(--muted);

}


#qp-scroll-{{ section.id }} .qp-how-item h3 {

  margin: 0 0 7px;

  font-size: 17px;

}


#qp-scroll-{{ section.id }} .qp-how-item p {

  margin: 0;

  color: var(--muted);

  font-size: 13px;

  line-height: 1.5;

}


/* =====================================================
   SCENE 04
   ===================================================== */

#qp-scroll-{{ section.id }} .qp-big-number {

  position: absolute;

  z-index: 1;

  left: 50%;

  top: 45%;

  transform:
    translate(-50%, -50%)
    scale(1.2);

  font-size: clamp(
    220px,
    38vw,
    620px
  );

  line-height: .6;

  font-weight: 900;

  letter-spacing: -.12em;

  color: rgba(0,0,0,.055);

  will-change:
    transform;

}


#qp-scroll-{{ section.id }} .qp-number-label {

  position: absolute;

  z-index: 20;

  top: 20%;

  left: 50%;

  transform:
    translateX(-50%);

  font-size: 10px;

  letter-spacing: .3em;

  text-transform: uppercase;

  color: var(--muted);

}


#qp-scroll-{{ section.id }} .qp-final-product {

  position: absolute;

  z-index: 5;

  left: 50%;

  top: 50%;

  width: min(
    48vw,
    680px
  );

  transform:
    translate(-50%, -50%);

  will-change:
    transform;

}


#qp-scroll-{{ section.id }} .qp-final-product img {

  width: 100%;

  display: block;

}


#qp-scroll-{{ section.id }} .qp-final-copy {

  position: absolute;

  z-index: 30;

  left: 50%;

  bottom: 8vh;

  width: min(
    800px,
    88vw
  );

  text-align: center;

  transform:
    translate(-50%, 40px);

  opacity: 0;

  will-change:
    transform,
    opacity;

}


#qp-scroll-{{ section.id }} .qp-final-copy h2 {

  margin: 0 0 15px;

  font-size: clamp(
    42px,
    5vw,
    76px
  );

  line-height: .87;

  letter-spacing: -.07em;

}


#qp-scroll-{{ section.id }} .qp-final-copy > div {

  color: var(--muted);

  font-size: 14px;

  line-height: 1.5;

}


/* =====================================================
   FINAL
   ===================================================== */

#qp-scroll-{{ section.id }} .qp-final {

  min-height: 75vh;

  display: flex;

  justify-content: center;

  align-items: center;

  text-align: center;

  padding: 100px 20px;

}


#qp-scroll-{{ section.id }} .qp-final-inner {

  width: min(
    900px,
    92vw
  );

}


#qp-scroll-{{ section.id }} .qp-final-inner .qp-label {

  position: static;

  margin-bottom: 20px;

}


#qp-scroll-{{ section.id }} .qp-final-inner h2 {

  margin: 0 0 25px;

  font-size: clamp(
    50px,
    7vw,
    105px
  );

  line-height: .84;

  letter-spacing: -.075em;

}


#qp-scroll-{{ section.id }} .qp-final-description {

  max-width: 520px;

  margin: 0 auto 30px;

  color: var(--muted);

  line-height: 1.5;

}


#qp-scroll-{{ section.id }} .qp-button {

  display: inline-flex;

  min-height: 54px;

  padding: 0 32px;

  align-items: center;

  justify-content: center;

  background: var(--text);

  color: var(--bg);

  text-decoration: none;

  font-size: 11px;

  font-weight: 700;

  letter-spacing: .16em;

  text-transform: uppercase;

}


/* =====================================================
   MOBILE
   ===================================================== */

@media screen and (max-width: 749px) {

  #qp-scroll-{{ section.id }} .qp-scene-01 {

    height: 190vh;

  }

  #qp-scroll-{{ section.id }} .qp-scene-02 {

    height: 220vh;

  }

  #qp-scroll-{{ section.id }} .qp-scene-03 {

    height: 220vh;

  }

  #qp-scroll-{{ section.id }} .qp-scene-04 {

    height: 190vh;

  }


  #qp-scroll-{{ section.id }} .qp-bg-text {

    font-size: 29vw;

  }


  #qp-scroll-{{ section.id }} .qp-label {

    left: 20px;

    top: 6vh;

    font-size: 8px;

  }


  /* 产品窗口 */

  #qp-scroll-{{ section.id }} .qp-product-window {

    width: 94vw;

    height: 70vh;

    top: 45%;

  }


  /* Hero */

  #qp-scroll-{{ section.id }} .qp-hero-copy {

    left: 20px;

    right: 20px;

    bottom: 6vh;

    width: auto;

  }


  #qp-scroll-{{ section.id }} .qp-hero-copy h1 {

    font-size: 43px;

  }


  #qp-scroll-{{ section.id }} .qp-side-info {

    left: 20px;

    right: 20px;

    bottom: 22vh;

    gap: 15px;

    justify-content: space-between;

  }


  #qp-scroll-{{ section.id }} .qp-feature {

    width: 44%;

  }


  #qp-scroll-{{ section.id }} .qp-feature p {

    font-size: 10px;

  }


  /* Scene 02 */

  #qp-scroll-{{ section.id }} .qp-scene02-copy {

    left: 20px;

    right: 20px;

    top: 15%;

    width: auto;

  }


  #qp-scroll-{{ section.id }} .qp-scene02-copy h2 {

    font-size: 40px;

  }


  #qp-scroll-{{ section.id }} .qp-scene02-image {

    width: 90vw;

    top: 44%;

  }


  #qp-scroll-{{ section.id }} .qp-story-card {

    width: 120px;

  }


  #qp-scroll-{{ section.id }} .qp-story-card:nth-child(1) {

    left: 20px;

    bottom: 9vh;

  }


  #qp-scroll-{{ section.id }} .qp-story-card:nth-child(2) {

    right: 20px;

    top: 25vh;

  }


  #qp-scroll-{{ section.id }} .qp-story-card:nth-child(3) {

    right: 20px;

    bottom: 9vh;

  }


  #qp-scroll-{{ section.id }} .qp-story-card:nth-child(4) {

    left: 20px;

    top: 25vh;

  }


  /* Scene 03 */

  #qp-scroll-{{ section.id }} .qp-how-product {

    width: 90vw;

    top: 44%;

  }


  #qp-scroll-{{ section.id }} .qp-how-title {

    left: 20px;

    top: 14%;

  }


  #qp-scroll-{{ section.id }} .qp-how-title h2 {

    font-size: 43px;

  }


  #qp-scroll-{{ section.id }} .qp-how-list {

    left: 20px;

    right: 20px;

    bottom: 5vh;

    top: auto;

    width: auto;

    transform: translateY(40px);

  }


  /* Scene 04 */

  #qp-scroll-{{ section.id }} .qp-big-number {

    font-size: 66vw;

  }


  #qp-scroll-{{ section.id }} .qp-final-product {

    width: 88vw;

  }


  #qp-scroll-{{ section.id }} .qp-final-copy {

    left: 20px;

    right: 20px;

    width: auto;

  }


  #qp-scroll-{{ section.id }} .qp-final-copy h2 {

    font-size: 38px;

  }


}


/* =====================================================
   REDUCED MOTION
   ===================================================== */

@media (prefers-reduced-motion: reduce) {

  #qp-scroll-{{ section.id }} .qp-scene {

    height: auto;

  }

  #qp-scroll-{{ section.id }} .qp-sticky {

    position: relative;

  }

}

</style>


<script>

(function() {

  const root =
    document.getElementById(
      'qp-scroll-{{ section.id }}'
    );

  if (!root) return;


  let raf = null;


  function clamp(value) {

    return Math.max(
      0,
      Math.min(
        1,
        value
      )
    );

  }


  function map(
    value,
    inMin,
    inMax,
    outMin,
    outMax
  ) {

    const p = clamp(
      (value - inMin) /
      (inMax - inMin)
    );

    return outMin +
      (outMax - outMin) * p;

  }


  function progress(scene) {

    const rect =
      scene.getBoundingClientRect();

    const distance =
      scene.offsetHeight -
      window.innerHeight;

    if (distance <= 0) {
      return 0;
    }

    return clamp(
      -rect.top /
      distance
    );

  }


  /* =====================================================
     SCENE 01
     ===================================================== */

  function scene01() {

    const scene =
      root.querySelector(
        '.qp-scene-01'
      );

    if (!scene) return;


    const p =
      progress(scene);


    const bg =
      root.querySelector(
        '.qp-bg-01'
      );

    const product =
      root.querySelector(
        '.qp-product'
      );

    const copy =
      root.querySelector(
        '.qp-hero-copy'
      );

    const features =
      root.querySelectorAll(
        '.qp-feature'
      );


    /*
      ============================================
      产品核心动画
      ============================================

      0%
      歪 24°
      右移
      下移
      放大
      只露约 65%

      ↓

      40%
      开始明显摆正

      ↓

      65%
      完全摆正
      完整露出

      ↓

      100%
      保持
    */


    if (product) {

      const rotate =
        map(
          p,
          0,
          .65,
          24,
          0
        );


      const x =
        map(
          p,
          0,
          .65,
          18,
          0
        );


      const y =
        map(
          p,
          0,
          .65,
          12,
          0
        );


      const scale =
        map(
          p,
          0,
          .65,
          1.28,
          1
        );


      const clip =
        map(
          p,
          0,
          .65,
          35,
          0
        );


      const opacity =
        map(
          p,
          0,
          .08,
          0,
          1
        );


      product.style.opacity =
        opacity;


      product.style.transform = `
        translate3d(
          ${x}vw,
          ${y}vh,
          0
        )
        rotate(${rotate}deg)
        scale(${scale})
      `;


      product.style.clipPath = `
        inset(
          0
          0
          ${clip}%
          0
        )
      `;

    }


    /* =====================
       背景巨型文字
       ===================== */

    if (bg) {

      bg.style.transform = `
        translate3d(
          ${map(
            p,
            0,
            .8,
            32,
            -30
          )}vw,
          -50%,
          0
        )
      `;


      bg.style.opacity =
        map(
          p,
          .68,
          .95,
          1,
          0
        );

    }


    /* =====================
       文案
       ===================== */

    if (copy) {

      const cp =
        clamp(
          (p - .55) /
          .18
        );


      copy.style.opacity =
        cp;


      copy.style.transform = `
        translateY(
          ${map(
            cp,
            0,
            1,
            40,
            0
          )}px
        )
      `;

    }


    /* =====================
       Feature
       ===================== */

    features.forEach(
      function(
        item,
        index
      ) {

        const start =
          .25 +
          index * .10;


        const fp =
          clamp(
            (p - start) /
            .16
          );


        item.style.opacity =
          fp;


        item.style.transform = `
          translateY(
            ${map(
              fp,
              0,
              1,
              35,
              0
            )}px
          )
        `;

      }
    );

  }


  /* =====================================================
     SCENE 02
     ===================================================== */

  function scene02() {

    const scene =
      root.querySelector(
        '.qp-scene-02'
      );

    if (!scene) return;


    const p =
      progress(scene);


    const bg =
      root.querySelector(
        '.qp-bg-02'
      );

    const image =
      root.querySelector(
        '.qp-scene02-image'
      );

    const copy =
      root.querySelector(
        '.qp-scene02-copy'
      );

    const cards =
      root.querySelectorAll(
        '.qp-story-card'
      );


    if (bg) {

      bg.style.transform = `
        translate3d(
          ${map(
            p,
            0,
            .8,
            30,
            -30
          )}vw,
          -50%,
          0
        )
      `;

      bg.style.opacity =
        map(
          p,
          .7,
          .95,
          1,
          0
        );

    }


    if (image) {

      const ip =
        clamp(
          p / .35
        );


      image.style.opacity =
        ip;


      image.style.transform = `
        translate(
          -50%,
          -50%
        )
        scale(
          ${map(
            ip,
            0,
            1,
            .72,
            1
          )}
        )
      `;

    }


    if (copy) {

      const cp =
        clamp(
          (p - .28) /
          .18
        );


      copy.style.opacity =
        cp;


      copy.style.transform = `
        translateY(
          ${map(
            cp,
            0,
            1,
            40,
            0
          )}px
        )
      `;

    }


    cards.forEach(
      function(
        card,
        index
      ) {

        const start =
          .42 +
          index * .09;


        const cp =
          clamp(
            (p - start) /
            .15
          );


        card.style.opacity =
          cp;


        card.style.transform = `
          translateY(
            ${map(
              cp,
              0,
              1,
              40,
              0
            )}px
          )
        `;

      }
    );

  }


  /* =====================================================
     SCENE 03
     ===================================================== */

  function scene03() {

    const scene =
      root.querySelector(
        '.qp-scene-03'
      );

    if (!scene) return;


    const p =
      progress(scene);


    const bg =
      root.querySelector(
        '.qp-bg-03'
      );

    const product =
      root.querySelector(
        '.qp-how-product'
      );

    const title =
      root.querySelector(
        '.qp-how-title'
      );

    const list =
      root.querySelector(
        '.qp-how-list'
      );

    const items =
      root.querySelectorAll(
        '.qp-how-item'
      );


    if (bg) {

      bg.style.transform = `
        translate3d(
          ${map(
            p,
            0,
            .8,
            30,
            -25
          )}vw,
          -50%,
          0
        )
      `;

      bg.style.opacity =
        map(
          p,
          .72,
          .95,
          1,
          0
        );

    }


    if (product) {

      const ip =
        clamp(
          p / .3
        );


      product.style.opacity =
        ip;


      product.style.transform = `
        translate(
          -50%,
          -50%
        )
        scale(
          ${map(
            ip,
            0,
            1,
            .72,
            1
          )}
        )
      `;

    }


    if (title) {

      const tp =
        clamp(
          (p - .25) /
          .18
        );


      title.style.opacity =
        tp;


      title.style.transform = `
        translateY(
          ${map(
            tp,
            0,
            1,
            40,
            0
          )}px
        )
      `;

    }


    if (list) {

      const lp =
        clamp(
          (p - .38) /
          .15
        );


      list.style.opacity =
        lp;


      list.style.transform = `
        translate(
          ${map(
            lp,
            0,
            1,
            80,
            0
          )}px,
          -50%
        )
      `;

    }


    items.forEach(
      function(
        item,
        index
      ) {

        const start =
          .45 +
          index * .12;


        const ip =
          clamp(
            (p - start) /
            .12
          );


        item.style.opacity =
          ip;


        item.style.transform = `
          translateY(
            ${map(
              ip,
              0,
              1,
              30,
              0
            )}px
          )
        `;

      }
    );

  }


  /* =====================================================
     SCENE 04
     ===================================================== */

  function scene04() {

    const scene =
      root.querySelector(
        '.qp-scene-04'
      );

    if (!scene) return;


    const p =
      progress(scene);


    const number =
      root.querySelector(
        '.qp-big-number'
      );

    const product =
      root.querySelector(
        '.qp-final-product'
      );

    const copy =
      root.querySelector(
        '.qp-final-copy'
      );


    if (number) {

      number.style.transform = `
        translate(
          -50%,
          -50%
        )
        scale(
          ${map(
            p,
            0,
            .8,
            1.2,
            .88
          )}
        )
      `;

    }


    if (product) {

      product.style.transform = `
        translate(
          -50%,
          calc(
            -50% -
            ${map(
              p,
              0,
              1,
              0,
              100
            )}px
          )
        )
        scale(
          ${map(
            p,
            0,
            .8,
            1,
            .76
          )}
        )
      `;

    }


    if (copy) {

      const cp =
        clamp(
          (p - .55) /
          .22
        );


      copy.style.opacity =
        cp;


      copy.style.transform = `
        translate(
          -50%,
          ${map(
            cp,
            0,
            1,
            40,
            0
          )}px
        )
      `;

    }

  }


  /* =====================================================
     UPDATE
     ===================================================== */

  function update() {

    raf = null;

    scene01();

    scene02();

    scene03();

    scene04();

  }


  function requestUpdate() {

    if (raf) return;

    raf =
      requestAnimationFrame(
        update
      );

  }


  window.addEventListener(
    'scroll',
    requestUpdate,
    {
      passive: true
    }
  );


  window.addEventListener(
    'resize',
    requestUpdate
  );


  update();

})();

</script>


