{% comment %}
  QUESTPROPS™ SCROLL STORY
  Sticky scroll storytelling product page
  Shopify OS 2.0 single section
{% endcomment %}

<section
  id="QPStory-{{ section.id }}"
  class="qp-story"
>

  <!-- ======================================================
       SCENE 01 — HERO / PRODUCT
       ====================================================== -->

  <section
    class="qp-scene qp-scene-hero"
    data-scene="hero"
  >

    <div class="qp-sticky">

      <div class="qp-bg-text qp-bg-hero">
        {{ section.settings.hero_bg_text }}
      </div>

      <div class="qp-eyebrow">
        {{ section.settings.hero_eyebrow }}
      </div>

      <div class="qp-hero-product">

        {% if section.settings.hero_image != blank %}

          {{
            section.settings.hero_image
            | image_url: width: 1800
            | image_tag:
              widths: '400,600,800,1000,1400,1800',
              sizes: '90vw',
              loading: 'eager',
              class: 'qp-image'
          }}

        {% else %}

          <div class="qp-image-placeholder">
            ADD PRODUCT IMAGE
          </div>

        {% endif %}

      </div>

      <div class="qp-hero-copy">

        <h1>
          {{ section.settings.hero_heading }}
        </h1>

        {% if section.settings.hero_text != blank %}

          <div class="qp-richtext">
            {{ section.settings.hero_text }}
          </div>

        {% endif %}

      </div>

      <div class="qp-hero-features">

        {% for block in section.blocks %}

          {% if block.type == 'hero_feature' %}

            <div
              class="qp-feature-card"
              {{ block.shopify_attributes }}
            >

              <span class="qp-feature-index">
                {{ block.settings.number }}
              </span>

              <strong>
                {{ block.settings.title }}
              </strong>

              <p>
                {{ block.settings.text }}
              </p>

            </div>

          {% endif %}

        {% endfor %}

      </div>

    </div>

  </section>


  <!-- ======================================================
       SCENE 02 — WHY / TENSION
       ====================================================== -->

  <section
    class="qp-scene qp-scene-tension"
    data-scene="tension"
  >

    <div class="qp-sticky">

      <div class="qp-bg-text qp-bg-tension">
        {{ section.settings.tension_bg_text }}
      </div>

      <div class="qp-eyebrow">
        {{ section.settings.tension_eyebrow }}
      </div>

      <div class="qp-tension-image">

        {% if section.settings.tension_image != blank %}

          {{
            section.settings.tension_image
            | image_url: width: 1600
            | image_tag:
              widths: '400,600,800,1200,1600',
              sizes: '90vw',
              loading: 'lazy',
              class: 'qp-image'
          }}

        {% endif %}

      </div>

      <div class="qp-tension-heading">

        <h2>
          {{ section.settings.tension_heading }}
        </h2>

        <div class="qp-richtext">
          {{ section.settings.tension_text }}
        </div>

      </div>

      <div class="qp-tension-cards">

        {% for block in section.blocks %}

          {% if block.type == 'tension_card' %}

            <div
              class="qp-tension-card"
              {{ block.shopify_attributes }}
            >

              {% if block.settings.image != blank %}

                {{
                  block.settings.image
                  | image_url: width: 700
                  | image_tag:
                    widths: '300,500,700',
                    sizes: '35vw',
                    loading: 'lazy',
                    class: 'qp-image'
                }}

              {% endif %}

              <div class="qp-card-content">

                <span>
                  {{ block.settings.number }}
                </span>

                <h3>
                  {{ block.settings.title }}
                </h3>

                <p>
                  {{ block.settings.text }}
                </p>

              </div>

            </div>

          {% endif %}

        {% endfor %}

      </div>

    </div>

  </section>


  <!-- ======================================================
       SCENE 03 — HOW IT WORKS
       ====================================================== -->

  <section
    class="qp-scene qp-scene-how"
    data-scene="how"
  >

    <div class="qp-sticky">

      <div class="qp-bg-text qp-bg-how">
        {{ section.settings.how_bg_text }}
      </div>

      <div class="qp-eyebrow">
        {{ section.settings.how_eyebrow }}
      </div>

      <div class="qp-how-product">

        {% if section.settings.how_image != blank %}

          {{
            section.settings.how_image
            | image_url: width: 1800
            | image_tag:
              widths: '400,600,800,1000,1400,1800',
              sizes: '90vw',
              loading: 'lazy',
              class: 'qp-image'
          }}

        {% endif %}

      </div>

      <div class="qp-how-title">

        <h2>
          {{ section.settings.how_heading }}
        </h2>

      </div>

      <div class="qp-how-points">

        {% for block in section.blocks %}

          {% if block.type == 'how_point' %}

            <div
              class="qp-how-point"
              {{ block.shopify_attributes }}
            >

              <span class="qp-point-number">
                {{ block.settings.number }}
              </span>

              <div>

                <h3>
                  {{ block.settings.title }}
                </h3>

                <p>
                  {{ block.settings.text }}
                </p>

              </div>

            </div>

          {% endif %}

        {% endfor %}

      </div>

    </div>

  </section>


  <!-- ======================================================
       SCENE 04 — 10 MINUTES
       ====================================================== -->

  <section
    class="qp-scene qp-scene-reset"
    data-scene="reset"
  >

    <div class="qp-sticky">

      <div class="qp-big-number">
        {{ section.settings.reset_number }}
      </div>

      <div class="qp-number-label">
        {{ section.settings.reset_label }}
      </div>

      <div class="qp-reset-product">

        {% if section.settings.reset_image != blank %}

          {{
            section.settings.reset_image
            | image_url: width: 1800
            | image_tag:
              widths: '400,600,800,1000,1400,1800',
              sizes: '90vw',
              loading: 'lazy',
              class: 'qp-image'
          }}

        {% endif %}

      </div>

      <div class="qp-reset-copy">

        <h2>
          {{ section.settings.reset_heading }}
        </h2>

        <div class="qp-richtext">
          {{ section.settings.reset_text }}
        </div>

      </div>

    </div>

  </section>


  <!-- ======================================================
       FINAL CTA
       ====================================================== -->

  <section class="qp-final">

    <div class="qp-final-inner">

      <span>
        {{ section.settings.final_eyebrow }}
      </span>

      <h2>
        {{ section.settings.final_heading }}
      </h2>

      <div class="qp-final-text">
        {{ section.settings.final_text }}
      </div>

      {% if section.settings.final_button_text != blank %}

        <a
          href="{{ section.settings.final_button_url }}"
          class="qp-button"
        >
          {{ section.settings.final_button_text }}
        </a>

      {% endif %}

    </div>

  </section>

</section>


<style>

#QPStory-{{ section.id }} {

  --qp-bg: {{ section.settings.background }};
  --qp-text: {{ section.settings.text_color }};
  --qp-muted: {{ section.settings.muted_color }};
  --qp-accent: {{ section.settings.accent }};

  background: var(--qp-bg);
  color: var(--qp-text);

  width: 100%;

  overflow: clip;

}


/* ======================================================
   RESET
   ====================================================== */

#QPStory-{{ section.id }} *,
#QPStory-{{ section.id }} *::before,
#QPStory-{{ section.id }} *::after {

  box-sizing: border-box;

}


/* ======================================================
   SCENES
   ====================================================== */

#QPStory-{{ section.id }} .qp-scene {

  position: relative;

  width: 100%;

}


#QPStory-{{ section.id }} .qp-scene-hero {

  height: 190vh;

}


#QPStory-{{ section.id }} .qp-scene-tension {

  height: 220vh;

}


#QPStory-{{ section.id }} .qp-scene-how {

  height: 230vh;

}


#QPStory-{{ section.id }} .qp-scene-reset {

  height: 190vh;

}


/* ======================================================
   STICKY
   ====================================================== */

#QPStory-{{ section.id }} .qp-sticky {

  position: sticky;

  top: 0;

  height: 100vh;
  height: 100svh;

  width: 100%;

  overflow: hidden;

}


/* ======================================================
   IMAGE
   ====================================================== */

#QPStory-{{ section.id }} .qp-image {

  display: block;

  width: 100%;

  height: auto;

  object-fit: contain;

}


/* ======================================================
   BACKGROUND TEXT
   ====================================================== */

#QPStory-{{ section.id }} .qp-bg-text {

  position: absolute;

  z-index: 1;

  left: 0;

  top: 50%;

  white-space: nowrap;

  font-size: clamp(
    130px,
    19vw,
    330px
  );

  font-weight: 900;

  line-height: .72;

  letter-spacing: -.09em;

  color: rgba(20,20,20,.055);

  pointer-events: none;

  user-select: none;

  will-change:
    transform,
    opacity;

}


/* ======================================================
   EYEBROW
   ====================================================== */

#QPStory-{{ section.id }} .qp-eyebrow {

  position: absolute;

  z-index: 30;

  top: 7vh;

  left: 6vw;

  font-size: 10px;

  line-height: 1;

  letter-spacing: .3em;

  text-transform: uppercase;

  color: var(--qp-muted);

}


/* ======================================================
   HERO PRODUCT
   ====================================================== */

#QPStory-{{ section.id }} .qp-hero-product {

  position: absolute;

  z-index: 5;

  width: min(60vw, 820px);

  left: 50%;

  top: 49%;

  transform:
    translate(-50%, -50%)
    scale(.72);

  will-change:
    transform,
    opacity;

}


#QPStory-{{ section.id }} .qp-image-placeholder {

  width: 600px;

  max-width: 70vw;

  aspect-ratio: 1 / 1;

  display: grid;

  place-items: center;

  background: #f4f4f4;

  color: #aaa;

  font-size: 12px;

}


/* ======================================================
   HERO COPY
   ====================================================== */

#QPStory-{{ section.id }} .qp-hero-copy {

  position: absolute;

  z-index: 20;

  left: 6vw;

  bottom: 9vh;

  max-width: 430px;

  opacity: 0;

  transform:
    translateY(40px);

  will-change:
    transform,
    opacity;

}


#QPStory-{{ section.id }} .qp-hero-copy h1 {

  margin: 0 0 18px;

  font-size: clamp(
    48px,
    6vw,
    88px
  );

  line-height: .86;

  letter-spacing: -.07em;

}


#QPStory-{{ section.id }} .qp-richtext {

  color: var(--qp-muted);

  font-size: 15px;

  line-height: 1.55;

}


#QPStory-{{ section.id }} .qp-richtext p {

  margin: 0 0 10px;

}


/* ======================================================
   HERO FEATURES
   ====================================================== */

#QPStory-{{ section.id }} .qp-hero-features {

  position: absolute;

  z-index: 20;

  right: 6vw;

  bottom: 9vh;

  display: flex;

  gap: 40px;

}


#QPStory-{{ section.id }} .qp-feature-card {

  width: 180px;

  opacity: 0;

  transform:
    translateY(30px);

  will-change:
    transform,
    opacity;

}


#QPStory-{{ section.id }} .qp-feature-index {

  display: block;

  margin-bottom: 12px;

  font-size: 9px;

  letter-spacing: .2em;

  color: var(--qp-muted);

}


#QPStory-{{ section.id }} .qp-feature-card strong {

  display: block;

  font-size: 13px;

  letter-spacing: .08em;

  text-transform: uppercase;

}


#QPStory-{{ section.id }} .qp-feature-card p {

  margin: 8px 0 0;

  color: var(--qp-muted);

  font-size: 12px;

  line-height: 1.45;

}


/* ======================================================
   TENSION IMAGE
   ====================================================== */

#QPStory-{{ section.id }} .qp-tension-image {

  position: absolute;

  z-index: 5;

  width: min(45vw, 620px);

  left: 50%;

  top: 50%;

  transform:
    translate(-50%, -50%)
    scale(.72);

  opacity: 0;

  will-change:
    transform,
    opacity;

}


/* ======================================================
   TENSION HEADING
   ====================================================== */

#QPStory-{{ section.id }} .qp-tension-heading {

  position: absolute;

  z-index: 25;

  left: 7vw;

  top: 30%;

  width: min(32vw, 430px);

  opacity: 0;

  transform:
    translateY(40px);

  will-change:
    transform,
    opacity;

}


#QPStory-{{ section.id }} .qp-tension-heading h2 {

  margin: 0 0 18px;

  font-size: clamp(
    40px,
    5vw,
    70px
  );

  line-height: .9;

  letter-spacing: -.065em;

}


/* ======================================================
   TENSION CARDS
   ====================================================== */

#QPStory-{{ section.id }} .qp-tension-cards {

  position: absolute;

  inset: 0;

  z-index: 20;

}


#QPStory-{{ section.id }} .qp-tension-card {

  position: absolute;

  width: 180px;

  opacity: 0;

  transform:
    translateY(40px);

  will-change:
    transform,
    opacity;

}


#QPStory-{{ section.id }} .qp-tension-card:nth-child(1) {

  left: 7vw;

  bottom: 15vh;

}


#QPStory-{{ section.id }} .qp-tension-card:nth-child(2) {

  right: 7vw;

  top: 20vh;

}


#QPStory-{{ section.id }} .qp-tension-card:nth-child(3) {

  right: 18vw;

  bottom: 10vh;

}


#QPStory-{{ section.id }} .qp-tension-card:nth-child(4) {

  left: 18vw;

  top: 18vh;

}


#QPStory-{{ section.id }} .qp-tension-card .qp-image {

  aspect-ratio: 1 / 1;

  object-fit: cover;

  margin-bottom: 12px;

}


#QPStory-{{ section.id }} .qp-card-content span {

  font-size: 9px;

  letter-spacing: .2em;

  color: var(--qp-muted);

}


#QPStory-{{ section.id }} .qp-card-content h3 {

  margin: 7px 0;

  font-size: 13px;

  letter-spacing: .1em;

  text-transform: uppercase;

}


#QPStory-{{ section.id }} .qp-card-content p {

  margin: 0;

  color: var(--qp-muted);

  font-size: 12px;

  line-height: 1.45;

}


/* ======================================================
   HOW IT WORKS
   ====================================================== */

#QPStory-{{ section.id }} .qp-how-product {

  position: absolute;

  z-index: 5;

  left: 50%;

  top: 51%;

  width: min(53vw, 720px);

  transform:
    translate(-50%, -50%)
    scale(.72);

  opacity: 0;

  will-change:
    transform,
    opacity;

}


#QPStory-{{ section.id }} .qp-how-title {

  position: absolute;

  z-index: 25;

  left: 7vw;

  top: 25%;

  opacity: 0;

  transform:
    translateY(40px);

  will-change:
    transform,
    opacity;

}


#QPStory-{{ section.id }} .qp-how-title h2 {

  margin: 0;

  font-size: clamp(
    50px,
    6vw,
    90px
  );

  line-height: .85;

  letter-spacing: -.07em;

}


/* ======================================================
   HOW POINTS
   ====================================================== */

#QPStory-{{ section.id }} .qp-how-points {

  position: absolute;

  z-index: 30;

  right: 7vw;

  top: 50%;

  width: min(30vw, 400px);

  transform:
    translate(100px, -50%);

  opacity: 0;

  will-change:
    transform,
    opacity;

}


#QPStory-{{ section.id }} .qp-how-point {

  display: flex;

  gap: 18px;

  margin-bottom: 35px;

  opacity: 0;

  transform:
    translateY(35px);

  will-change:
    transform,
    opacity;

}


#QPStory-{{ section.id }} .qp-point-number {

  flex: 0 0 auto;

  font-size: 9px;

  letter-spacing: .2em;

  color: var(--qp-muted);

}


#QPStory-{{ section.id }} .qp-how-point h3 {

  margin: 0 0 7px;

  font-size: 18px;

  letter-spacing: -.02em;

}


#QPStory-{{ section.id }} .qp-how-point p {

  margin: 0;

  color: var(--qp-muted);

  font-size: 13px;

  line-height: 1.5;

}


/* ======================================================
   RESET / 10 MIN
   ====================================================== */

#QPStory-{{ section.id }} .qp-big-number {

  position: absolute;

  z-index: 1;

  left: 50%;

  top: 45%;

  transform:
    translate(-50%, -50%)
    scale(1.15);

  font-size: clamp(
    220px,
    38vw,
    600px
  );

  line-height: .65;

  font-weight: 900;

  letter-spacing: -.12em;

  color: rgba(20,20,20,.055);

  will-change:
    transform;

}


#QPStory-{{ section.id }} .qp-number-label {

  position: absolute;

  z-index: 20;

  top: 23%;

  left: 50%;

  transform:
    translateX(-50%);

  font-size: 10px;

  letter-spacing: .3em;

  text-transform: uppercase;

  color: var(--qp-muted);

}


#QPStory-{{ section.id }} .qp-reset-product {

  position: absolute;

  z-index: 5;

  left: 50%;

  top: 51%;

  width: min(47vw, 640px);

  transform:
    translate(-50%, -50%)
    scale(1);

  will-change:
    transform;

}


#QPStory-{{ section.id }} .qp-reset-copy {

  position: absolute;

  z-index: 25;

  left: 50%;

  bottom: 8vh;

  width: min(800px, 88vw);

  text-align: center;

  transform:
    translate(-50%, 40px);

  opacity: 0;

  will-change:
    transform,
    opacity;

}


#QPStory-{{ section.id }} .qp-reset-copy h2 {

  margin: 0 0 15px;

  font-size: clamp(
    42px,
    5vw,
    76px
  );

  line-height: .88;

  letter-spacing: -.07em;

}


/* ======================================================
   FINAL CTA
   ====================================================== */

#QPStory-{{ section.id }} .qp-final {

  min-height: 75vh;

  display: flex;

  align-items: center;

  justify-content: center;

  padding: 100px 20px;

  text-align: center;

}


#QPStory-{{ section.id }} .qp-final-inner {

  width: min(900px, 92vw);

}


#QPStory-{{ section.id }} .qp-final-inner > span {

  font-size: 10px;

  letter-spacing: .3em;

  text-transform: uppercase;

  color: var(--qp-muted);

}


#QPStory-{{ section.id }} .qp-final-inner h2 {

  margin: 20px 0 30px;

  font-size: clamp(
    52px,
    7vw,
    105px
  );

  line-height: .83;

  letter-spacing: -.075em;

}


#QPStory-{{ section.id }} .qp-final-text {

  max-width: 500px;

  margin: 0 auto 30px;

  color: var(--qp-muted);

  line-height: 1.5;

}


#QPStory-{{ section.id }} .qp-button {

  display: inline-flex;

  min-height: 54px;

  align-items: center;

  justify-content: center;

  padding: 0 32px;

  background: var(--qp-text);

  color: var(--qp-bg);

  text-decoration: none;

  font-size: 11px;

  font-weight: 700;

  letter-spacing: .16em;

  text-transform: uppercase;

  transition:
    transform .25s ease,
    opacity .25s ease;

}


#QPStory-{{ section.id }} .qp-button:hover {

  transform: translateY(-2px);

  opacity: .85;

}


/* ======================================================
   MOBILE
   ====================================================== */

@media screen and (max-width: 749px) {

  #QPStory-{{ section.id }} .qp-scene-hero {

    height: 180vh;

  }

  #QPStory-{{ section.id }} .qp-scene-tension {

    height: 230vh;

  }

  #QPStory-{{ section.id }} .qp-scene-how {

    height: 240vh;

  }

  #QPStory-{{ section.id }} .qp-scene-reset {

    height: 190vh;

  }


  #QPStory-{{ section.id }} .qp-bg-text {

    font-size: 28vw;

  }


  #QPStory-{{ section.id }} .qp-eyebrow {

    top: 6vh;

    left: 20px;

    font-size: 8px;

    letter-spacing: .22em;

  }


  /* HERO */

  #QPStory-{{ section.id }} .qp-hero-product {

    width: 92vw;

    top: 43%;

  }


  #QPStory-{{ section.id }} .qp-hero-copy {

    left: 20px;

    right: 20px;

    bottom: 7vh;

    max-width: none;

  }


  #QPStory-{{ section.id }} .qp-hero-copy h1 {

    font-size: 45px;

  }


  #QPStory-{{ section.id }} .qp-richtext {

    font-size: 13px;

  }


  #QPStory-{{ section.id }} .qp-hero-features {

    left: 20px;

    right: 20px;

    bottom: 23vh;

    justify-content: space-between;

    gap: 15px;

  }


  #QPStory-{{ section.id }} .qp-feature-card {

    width: 42%;

  }


  #QPStory-{{ section.id }} .qp-feature-card p {

    font-size: 11px;

  }


  /* TENSION */

  #QPStory-{{ section.id }} .qp-tension-image {

    width: 88vw;

    top: 43%;

  }


  #QPStory-{{ section.id }} .qp-tension-heading {

    left: 20px;

    right: 20px;

    top: 17%;

    width: auto;

  }


  #QPStory-{{ section.id }} .qp-tension-heading h2 {

    font-size: 40px;

  }


  #QPStory-{{ section.id }} .qp-tension-card {

    width: 125px;

  }


  #QPStory-{{ section.id }} .qp-tension-card:nth-child(1) {

    left: 20px;

    bottom: 9vh;

  }


  #QPStory-{{ section.id }} .qp-tension-card:nth-child(2) {

    right: 20px;

    top: 25vh;

  }


  #QPStory-{{ section.id }} .qp-tension-card:nth-child(3) {

    right: 20px;

    bottom: 9vh;

  }


  #QPStory-{{ section.id }} .qp-tension-card:nth-child(4) {

    left: 20px;

    top: 25vh;

  }


  /* HOW */

  #QPStory-{{ section.id }} .qp-how-product {

    width: 90vw;

    top: 43%;

  }


  #QPStory-{{ section.id }} .qp-how-title {

    left: 20px;

    top: 14%;

  }


  #QPStory-{{ section.id }} .qp-how-title h2 {

    font-size: 45px;

  }


  #QPStory-{{ section.id }} .qp-how-points {

    left: 20px;

    right: 20px;

    bottom: 6vh;

    top: auto;

    width: auto;

  }


  #QPStory-{{ section.id }} .qp-how-point {

    margin-bottom: 18px;

  }


  #QPStory-{{ section.id }} .qp-how-point h3 {

    font-size: 16px;

  }


  /* RESET */

  #QPStory-{{ section.id }} .qp-big-number {

    font-size: 65vw;

  }


  #QPStory-{{ section.id }} .qp-reset-product {

    width: 85vw;

    top: 43%;

  }


  #QPStory-{{ section.id }} .qp-reset-copy {

    left: 20px;

    right: 20px;

    width: auto;

    bottom: 7vh;

  }


  #QPStory-{{ section.id }} .qp-reset-copy h2 {

    font-size: 38px;

  }


  /* CTA */

  #QPStory-{{ section.id }} .qp-final {

    min-height: 65vh;

  }


  #QPStory-{{ section.id }} .qp-final-inner h2 {

    font-size: 50px;

  }

}


/* ======================================================
   REDUCED MOTION
   ====================================================== */

@media (prefers-reduced-motion: reduce) {

  #QPStory-{{ section.id }} .qp-scene {

    height: auto;

  }

  #QPStory-{{ section.id }} .qp-sticky {

    position: relative;

    height: 100svh;

  }

}

</style>


<script>

(function() {

  const root = document.getElementById(
    'QPStory-{{ section.id }}'
  );

  if (!root) return;


  let ticking = false;


  function clamp(value) {

    return Math.max(
      0,
      Math.min(1, value)
    );

  }


  function map(
    value,
    start,
    end,
    outStart,
    outEnd
  ) {

    const p = clamp(
      (value - start) /
      (end - start)
    );

    return outStart +
      (outEnd - outStart) * p;

  }


  function getProgress(scene) {

    const rect =
      scene.getBoundingClientRect();

    const scrollDistance =
      scene.offsetHeight -
      window.innerHeight;

    if (scrollDistance <= 0) {
      return 0;
    }

    return clamp(
      -rect.top /
      scrollDistance
    );

  }


  /* ======================================================
     SCENE 01
     ====================================================== */

  function sceneHero() {

    const scene =
      root.querySelector(
        '.qp-scene-hero'
      );

    if (!scene) return;

    const p =
      getProgress(scene);


    const bg =
      root.querySelector(
        '.qp-bg-hero'
      );

    const product =
      root.querySelector(
        '.qp-hero-product'
      );

    const copy =
      root.querySelector(
        '.qp-hero-copy'
      );

    const features =
      root.querySelectorAll(
        '.qp-feature-card'
      );


    /* background text */

    if (bg) {

      bg.style.transform =
        `
        translate3d(
          ${map(
            p,
            0,
            .75,
            35,
            -30
          )}vw,
          -50%,
          0
        )
        `;

      bg.style.opacity =
        map(
          p,
          .72,
          1,
          1,
          0
        );

    }


    /* product */

    if (product) {

      product.style.transform =
        `
        translate3d(
          -50%,
          -50%,
          0
        )
        scale(
          ${map(
            p,
            0,
            .55,
            .72,
            1
          )}
        )
        `;

    }


    /* heading */

    if (copy) {

      const cp =
        clamp(
          (p - .42) /
          .20
        );

      copy.style.opacity = cp;

      copy.style.transform =
        `
        translateY(
          ${map(
            cp,
            0,
            1,
            45,
            0
          )}px
        )
        `;

    }


    /* feature cards */

    features.forEach(
      function(card, index) {

        const start =
          .18 +
          index * .10;

        const fp =
          clamp(
            (p - start) /
            .18
          );

        card.style.opacity = fp;

        card.style.transform =
          `
          translateY(
            ${map(
              fp,
              0,
              1,
              35,
              0
            )}px
          )
          `;

      }
    );

  }


  /* ======================================================
     SCENE 02
     ====================================================== */

  function sceneTension() {

    const scene =
      root.querySelector(
        '.qp-scene-tension'
      );

    if (!scene) return;

    const p =
      getProgress(scene);


    const bg =
      root.querySelector(
        '.qp-bg-tension'
      );

    const image =
      root.querySelector(
        '.qp-tension-image'
      );

    const heading =
      root.querySelector(
        '.qp-tension-heading'
      );

    const cards =
      root.querySelectorAll(
        '.qp-tension-card'
      );


    /* background */

    if (bg) {

      bg.style.transform =
        `
        translate3d(
          ${map(
            p,
            0,
            .75,
            30,
            -30
          )}vw,
          -50%,
          0
        )
        `;

      bg.style.opacity =
        map(
          p,
          .68,
          .92,
          1,
          0
        );

    }


    /* image */

    if (image) {

      const ip =
        clamp(
          p / .35
        );

      image.style.opacity = ip;

      image.style.transform =
        `
        translate3d(
          -50%,
          -50%,
          0
        )
        scale(
          ${map(
            ip,
            0,
            1,
            .72,
            1
          )}
        )
        `;

    }


    /* heading */

    if (heading) {

      const hp =
        clamp(
          (p - .28) /
          .18
        );

      heading.style.opacity = hp;

      heading.style.transform =
        `
        translateY(
          ${map(
            hp,
            0,
            1,
            40,
            0
          )}px
        )
        `;

    }


    /* cards */

    cards.forEach(
      function(card, index) {

        const start =
          .42 +
          index * .09;

        const cp =
          clamp(
            (p - start) /
            .15
          );

        card.style.opacity = cp;

        card.style.transform =
          `
          translateY(
            ${map(
              cp,
              0,
              1,
              45,
              0
            )}px
          )
          `;

      }
    );

  }


  /* ======================================================
     SCENE 03
     ====================================================== */

  function sceneHow() {

    const scene =
      root.querySelector(
        '.qp-scene-how'
      );

    if (!scene) return;

    const p =
      getProgress(scene);


    const bg =
      root.querySelector(
        '.qp-bg-how'
      );

    const product =
      root.querySelector(
        '.qp-how-product'
      );

    const title =
      root.querySelector(
        '.qp-how-title'
      );

    const container =
      root.querySelector(
        '.qp-how-points'
      );

    const points =
      root.querySelectorAll(
        '.qp-how-point'
      );


    /* background */

    if (bg) {

      bg.style.transform =
        `
        translate3d(
          ${map(
            p,
            0,
            .8,
            30,
            -25
          )}vw,
          -50%,
          0
        )
        `;

      bg.style.opacity =
        map(
          p,
          .72,
          .95,
          1,
          0
        );

    }


    /* product */

    if (product) {

      const ip =
        clamp(
          p / .32
        );

      product.style.opacity = ip;

      product.style.transform =
        `
        translate3d(
          -50%,
          -50%,
          0
        )
        scale(
          ${map(
            ip,
            0,
            1,
            .72,
            1
          )}
        )
        `;

    }


    /* title */

    if (title) {

      const tp =
        clamp(
          (p - .25) /
          .18
        );

      title.style.opacity = tp;

      title.style.transform =
        `
        translateY(
          ${map(
            tp,
            0,
            1,
            40,
            0
          )}px
        )
        `;

    }


    /* points container */

    if (container) {

      const cp =
        clamp(
          (p - .38) /
          .15
        );

      container.style.opacity = cp;

      container.style.transform =
        `
        translate(
          ${map(
            cp,
            0,
            1,
            100,
            0
          )}px,
          -50%
        )
        `;

    }


    /* points */

    points.forEach(
      function(point, index) {

        const start =
          .45 +
          index * .13;

        const pp =
          clamp(
            (p - start) /
            .11
          );

        point.style.opacity = pp;

        point.style.transform =
          `
          translateY(
            ${map(
              pp,
              0,
              1,
              35,
              0
            )}px
          )
          `;

      }
    );

  }


  /* ======================================================
     SCENE 04
     ====================================================== */

  function sceneReset() {

    const scene =
      root.querySelector(
        '.qp-scene-reset'
      );

    if (!scene) return;

    const p =
      getProgress(scene);


    const number =
      root.querySelector(
        '.qp-big-number'
      );

    const product =
      root.querySelector(
        '.qp-reset-product'
      );

    const copy =
      root.querySelector(
        '.qp-reset-copy'
      );


    /* number */

    if (number) {

      number.style.transform =
        `
        translate(
          -50%,
          -50%
        )
        scale(
          ${map(
            p,
            0,
            .75,
            1.15,
            .88
          )}
        )
        `;

    }


    /* product */

    if (product) {

      product.style.transform =
        `
        translate(
          -50%,
          calc(
            -50% +
            ${map(
              p,
              0,
              1,
              0,
              -110
            )}px
          )
        )
        scale(
          ${map(
            p,
            0,
            .8,
            1,
            .72
          )}
        )
        `;

    }


    /* copy */

    if (copy) {

      const cp =
        clamp(
          (p - .55) /
          .22
        );

      copy.style.opacity = cp;

      copy.style.transform =
        `
        translate(
          -50%,
          ${map(
            cp,
            0,
            1,
            45,
            0
          )}px
        )
        `;

    }

  }


  function update() {

    ticking = false;

    sceneHero();

    sceneTension();

    sceneHow();

    sceneReset();

  }


  function requestUpdate() {

    if (ticking) return;

    ticking = true;

    requestAnimationFrame(update);

  }


  window.addEventListener(
    'scroll',
    requestUpdate,
    {
      passive: true
    }
  );

  window.addEventListener(
    'resize',
    requestUpdate
  );


  update();

})();

</script>


