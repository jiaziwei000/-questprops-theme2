<section
  id="qp-reset-story-{{ section.id }}"
  class="qp-reset-story"
>
  <div class="qp-reset-scroll">

    <!-- =========================
         FIXED VISUAL CANVAS
    ========================== -->

    <div class="qp-reset-canvas">

      <!-- small brand mark -->
      <div class="qp-reset-brand">
        QUESTPROPS™
      </div>

      <!-- fixed typography -->
      <div class="qp-reset-title">
        <span>MAKE TIME</span>
        <span>FOR YOUR NECK.</span>
      </div>

      <div class="qp-reset-meta">
        NECK RESTORE / 01
      </div>


      <!-- =========================
           PRODUCT
      ========================== -->

      <div class="qp-reset-product-wrap">

        <div class="qp-reset-product">

          {% if section.settings.product_image != blank %}

            {{
              section.settings.product_image
              | image_url: width: 2400
              | image_tag:
                class: 'qp-reset-product-image',
                loading: 'eager',
                widths: '800,1200,1600,2000,2400'
            }}

          {% endif %}


          <!-- packaging -->

          {% if section.settings.package_image != blank %}

            <div class="qp-reset-package">

              {{
                section.settings.package_image
                | image_url: width: 1400
                | image_tag:
                  class: 'qp-reset-package-image',
                  loading: 'lazy',
                  widths: '500,800,1100,1400'
              }}

            </div>

          {% endif %}

        </div>

      </div>


      <!-- =========================
           SECOND MESSAGE
      ========================== -->

      <div class="qp-reset-ten">

        <span>10 MINUTES.</span>
        <span>THAT'S IT.</span>

      </div>


      <!-- =========================
           FINAL PRODUCT LOCKUP
      ========================== -->

      <div class="qp-reset-final">

        <div class="qp-reset-final-brand">
          QUESTPROPS™ NECK RESTORE
        </div>

        <h2>
          A SIMPLE RESET<br>
          FOR YOUR DAY.
        </h2>

        <div class="qp-reset-final-price">

          <span>$169.99</span>

          <strong>$119.99</strong>

        </div>

        <a
          href="{{ section.settings.button_link }}"
          class="qp-reset-button"
        >
          {{ section.settings.button_text }}
          <span>→</span>
        </a>

        <div class="qp-reset-trust">
          60-DAY TRIAL&nbsp;&nbsp; · &nbsp;&nbsp;
          2-YEAR WARRANTY&nbsp;&nbsp; · &nbsp;&nbsp;
          FREE SHIPPING
        </div>

      </div>

    </div>

  </div>
</section>


<style>

/* =====================================================
   ROOT
===================================================== */

#qp-reset-story-{{ section.id }} {

  --qp-background: #f2f0eb;
  --qp-black: #171717;

  position: relative;

  width: 100%;

  background: var(--qp-background);

  color: var(--qp-black);

  overflow: clip;
}


/* =====================================================
   SCROLL LENGTH
===================================================== */

#qp-reset-story-{{ section.id }}
.qp-reset-scroll {

  position: relative;

  height: 560vh;
}


/* =====================================================
   ONE SINGLE STICKY CANVAS
===================================================== */

#qp-reset-story-{{ section.id }}
.qp-reset-canvas {

  position: sticky;

  top: 0;

  width: 100%;

  height: 100vh;

  height: 100svh;

  overflow: hidden;

  isolation: isolate;
}


/* =====================================================
   BRAND
===================================================== */

#qp-reset-story-{{ section.id }}
.qp-reset-brand {

  position: absolute;

  top: 28px;

  left: 32px;

  z-index: 20;

  font-size: 10px;

  line-height: 1;

  font-weight: 700;

  letter-spacing: .18em;
}


/* =====================================================
   FIXED GIANT TYPE

   THIS NEVER MOVES
===================================================== */

#qp-reset-story-{{ section.id }}
.qp-reset-title {

  position: absolute;

  left: -3vw;

  top: 19vh;

  z-index: 1;

  display: flex;

  flex-direction: column;

  font-size: clamp(
    82px,
    14vw,
    230px
  );

  line-height: .78;

  font-weight: 800;

  letter-spacing: -.085em;

  text-transform: uppercase;

  white-space: nowrap;

  pointer-events: none;
}


#qp-reset-story-{{ section.id }}
.qp-reset-title span:last-child {

  margin-left: 9vw;

}


/* =====================================================
   SMALL META
===================================================== */

#qp-reset-story-{{ section.id }}
.qp-reset-meta {

  position: absolute;

  right: 32px;

  top: 31px;

  z-index: 20;

  font-size: 9px;

  font-weight: 600;

  letter-spacing: .18em;
}


/* =====================================================
   PRODUCT LAYER

   ABOVE TYPOGRAPHY
===================================================== */

#qp-reset-story-{{ section.id }}
.qp-reset-product-wrap {

  position: absolute;

  inset: 0;

  z-index: 10;

  display: flex;

  align-items: center;

  justify-content: center;

  pointer-events: none;
}


/* =====================================================
   PRODUCT

   JS ONLY CONTROLS THIS
===================================================== */

#qp-reset-story-{{ section.id }}
.qp-reset-product {

  position: relative;

  width: min(
    52vw,
    760px
  );

  transform:
    translate3d(
      0,
      62vh,
      0
    )
    scale(.68);

  will-change: transform;
}


/* =====================================================
   PRODUCT IMAGE
===================================================== */

#qp-reset-story-{{ section.id }}
.qp-reset-product-image {

  display: block;

  width: 100%;

  height: auto;

  object-fit: contain;

  filter:
    drop-shadow(
      0 28px 38px rgba(0,0,0,.12)
    );
}


/* =====================================================
   PACKAGE

   HIDDEN UNTIL THE END
===================================================== */

#qp-reset-story-{{ section.id }}
.qp-reset-package {

  position: absolute;

  width: 29%;

  right: -2%;

  bottom: -5%;

  opacity: 0;

  transform:
    translate3d(
      35px,
      45px,
      0
    )
    scale(.72)
    rotate(5deg);

  transform-origin: center bottom;

  will-change:
    transform,
    opacity;
}


#qp-reset-story-{{ section.id }}
.qp-reset-package-image {

  display: block;

  width: 100%;

  height: auto;

  filter:
    drop-shadow(
      0 20px 28px rgba(0,0,0,.12)
    );
}


/* =====================================================
   10 MINUTES MESSAGE

   THIS IS BEHIND PRODUCT
===================================================== */

#qp-reset-story-{{ section.id }}
.qp-reset-ten {

  position: absolute;

  left: 50%;

  top: 50%;

  z-index: 3;

  transform:
    translate(
      -50%,
      -50%
    );

  display: flex;

  flex-direction: column;

  align-items: center;

  font-size: clamp(
    50px,
    7vw,
    110px
  );

  line-height: .82;

  letter-spacing: -.075em;

  font-weight: 800;

  white-space: nowrap;

  opacity: 0;
}


/* =====================================================
   FINAL LOCKUP
===================================================== */

#qp-reset-story-{{ section.id }}
.qp-reset-final {

  position: absolute;

  left: 0;

  right: 0;

  top: 100vh;

  height: 100vh;

  height: 100svh;

  z-index: 30;

  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: center;

  text-align: center;

  opacity: 0;

  pointer-events: none;
}


#qp-reset-story-{{ section.id }}
.qp-reset-final-brand {

  margin-bottom: 22px;

  font-size: 10px;

  font-weight: 700;

  letter-spacing: .2em;
}


#qp-reset-story-{{ section.id }}
.qp-reset-final h2 {

  margin: 0;

  font-size: clamp(
    48px,
    6.5vw,
    105px
  );

  line-height: .84;

  letter-spacing: -.075em;

  font-weight: 800;
}


#qp-reset-story-{{ section.id }}
.qp-reset-final-price {

  display: flex;

  align-items: center;

  gap: 12px;

  margin-top: 28px;

  margin-bottom: 22px;
}


#qp-reset-story-{{ section.id }}
.qp-reset-final-price span {

  font-size: 14px;

  opacity: .4;

  text-decoration: line-through;
}


#qp-reset-story-{{ section.id }}
.qp-reset-final-price strong {

  font-size: 23px;
}


/* =====================================================
   BUTTON
===================================================== */

#qp-reset-story-{{ section.id }}
.qp-reset-button {

  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 20px;

  min-width: 230px;

  padding: 18px 28px;

  background: var(--qp-black);

  color: white;

  text-decoration: none;

  font-size: 10px;

  font-weight: 700;

  letter-spacing: .15em;

  pointer-events: auto;

  transition:
    transform .25s ease,
    opacity .25s ease;
}


#qp-reset-story-{{ section.id }}
.qp-reset-button:hover {

  transform: translateY(-2px);

  opacity: .88;
}


#qp-reset-story-{{ section.id }}
.qp-reset-trust {

  margin-top: 18px;

  font-size: 9px;

  letter-spacing: .05em;

  opacity: .45;
}


/* =====================================================
   MOBILE
===================================================== */

@media screen and (max-width: 749px) {

  #qp-reset-story-{{ section.id }}
  .qp-reset-scroll {

    height: 520vh;

  }


  #qp-reset-story-{{ section.id }}
  .qp-reset-brand {

    top: 20px;

    left: 18px;

    font-size: 8px;

  }


  #qp-reset-story-{{ section.id }}
  .qp-reset-meta {

    top: 22px;

    right: 18px;

    font-size: 8px;

  }


  #qp-reset-story-{{ section.id }}
  .qp-reset-title {

    left: -8vw;

    top: 22vh;

    font-size: 18vw;

    line-height: .8;

  }


  #qp-reset-story-{{ section.id }}
  .qp-reset-title span:last-child {

    margin-left: 12vw;

  }


  #qp-reset-story-{{ section.id }}
  .qp-reset-product {

    width: 91vw;

  }


  #qp-reset-story-{{ section.id }}
  .qp-reset-package {

    width: 36%;

    right: -3%;

    bottom: -3%;

  }


  #qp-reset-story-{{ section.id }}
  .qp-reset-ten {

    font-size: 12vw;

  }


  #qp-reset-story-{{ section.id }}
  .qp-reset-final {

    padding: 0 20px;

  }


  #qp-reset-story-{{ section.id }}
  .qp-reset-final h2 {

    font-size: 13vw;

  }


  #qp-reset-story-{{ section.id }}
  .qp-reset-trust {

    max-width: 280px;

    line-height: 1.7;

  }

}

</style>


<script>

(function() {

  const root =
    document.getElementById(
      'qp-reset-story-{{ section.id }}'
    );

  if (!root) return;


  const scroll =
    root.querySelector(
      '.qp-reset-scroll'
    );

  const product =
    root.querySelector(
      '.qp-reset-product'
    );

  const packageEl =
    root.querySelector(
      '.qp-reset-package'
    );

  const ten =
    root.querySelector(
      '.qp-reset-ten'
    );

  const final =
    root.querySelector(
      '.qp-reset-final'
    );


  function clamp(value, min, max) {

    return Math.max(
      min,
      Math.min(
        max,
        value
      )
    );

  }


  function ease(value) {

    return value *
      value *
      (3 - 2 * value);

  }


  function update() {

    const rect =
      scroll.getBoundingClientRect();

    const scrollable =
      scroll.offsetHeight -
      window.innerHeight;


    if (scrollable <= 0) return;


    let progress =
      -rect.top /
      scrollable;


    progress =
      clamp(
        progress,
        0,
        1
      );


    /* =========================================
       PRODUCT TIMELINE

       0 — 20%
       ENTER

       20 — 55%
       CENTER

       55 — 76%
       GROW

       76 — 88%
       FINAL LOCKUP
    ========================================== */


    let y = 0;

    let x = 0;

    let scale = .68;

    let rotation = 0;


    if (progress < .20) {

      const p =
        ease(
          progress / .20
        );


      y =
        62 -
        (62 * p);


      scale =
        .68 +
        (.20 * p);


      rotation =
        -2 +
        (2 * p);

    }


    else if (progress < .55) {

      const p =
        ease(
          (progress - .20) /
          .35
        );


      y = 0;

      x =
        -2 * p;


      scale =
        .88 +
        (.07 * p);


      rotation = 0;

    }


    else if (progress < .76) {

      const p =
        ease(
          (progress - .55) /
          .21
        );


      x =
        -2 +
        (4 * p);


      y =
        -1 * p;


      scale =
        .95 +
        (.20 * p);


      rotation =
        1 * p;

    }


    else {

      const p =
        ease(
          (progress - .76) /
          .12
        );


      x =
        2 -
        (2 * p);


      y = -1;


      scale =
        1.15 +
        (.04 * p);


      rotation =
        1 -
        p;

    }


    product.style.transform =

      `translate3d(
        ${x}vw,
        ${y}vh,
        0
      )
      scale(${scale})
      rotate(${rotation}deg)`;


    /* =========================================
       SECOND MESSAGE

       appears only after product
       has become the hero
    ========================================== */

    let tenProgress =
      (progress - .50) /
      .16;


    tenProgress =
      clamp(
        tenProgress,
        0,
        1
      );


    ten.style.opacity =
      tenProgress;


    /* =========================================
       PACKAGE

       enters near the end
    ========================================== */

    if (packageEl) {

      let packageProgress =
        (progress - .67) /
        .13;


      packageProgress =
        clamp(
          packageProgress,
          0,
          1
        );


      const p =
        ease(
          packageProgress
        );


      packageEl.style.opacity =
        p;


      packageEl.style.transform =

        `translate3d(
          ${35 - (35 * p)}px,
          ${45 - (45 * p)}px,
          0
        )
        scale(
          ${.72 + (.28 * p)}
        )
        rotate(
          ${5 - (5 * p)}deg
        )`;

    }


    /* =========================================
       FINAL CTA

       only appears after everything settles
    ========================================== */

    let finalProgress =
      (progress - .86) /
      .09;


    finalProgress =
      clamp(
        finalProgress,
        0,
        1
      );


    final.style.opacity =
      finalProgress;


    final.style.pointerEvents =
      finalProgress > .85
        ? 'auto'
        : 'none';

  }


  let ticking = false;


  function requestUpdate() {

    if (ticking) return;


    ticking = true;


    requestAnimationFrame(
      function() {

        update();

        ticking = false;

      }
    );

  }


  window.addEventListener(
    'scroll',
    requestUpdate,
    {
      passive: true
    }
  );


  window.addEventListener(
    'resize',
    requestUpdate
  );


  update();

})();

</script>


{% schema %}

{
  "name": "QP Reset Story",

  "settings": [

    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product image"
    },

    {
      "type": "image_picker",
      "id": "package_image",
      "label": "Packaging image"
    },

    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SHOP NECK RESTORE"
    },

    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }

  ],

  "presets": [
    {
      "name": "QP Reset Story"
    }
  ]

}

{% endschema %}