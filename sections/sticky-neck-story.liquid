<section id="qp-sticky-{{ section.id }}" class="qp-sticky">

  <div class="qp-sticky-scroll">

    <!-- =========================
         BACKGROUND TEXT
    ========================== -->

    <div class="qp-big-copy">

      <div class="qp-copy-line line-1">
        YOUR NECK
      </div>

      <div class="qp-copy-line line-2">
        WORKS ALL DAY.
      </div>

      <div class="qp-copy-line line-3">
        MAKE ROOM
      </div>

      <div class="qp-copy-line line-4">
        FOR A RESET.
      </div>

      <div class="qp-copy-line line-5">
        GENTLE EMS.
      </div>

      <div class="qp-copy-line line-6">
        SOOTHING HEAT.
      </div>

      <div class="qp-copy-line line-7">
        JUST 10 MINUTES.
      </div>

    </div>


    <!-- =========================
         PRODUCT FOREGROUND
    ========================== -->

    <div class="qp-product-sticky">

      <div class="qp-product-wrap">

        {% if section.settings.product_image != blank %}

          {{
            section.settings.product_image
            | image_url: width: 2000
            | image_tag:
              class: 'qp-product-image',
              loading: 'eager',
              widths: '800,1200,1600,2000'
          }}

        {% else %}

          <div class="qp-placeholder">
            PRODUCT IMAGE
          </div>

        {% endif %}


        <!-- PACKAGE -->

        <div class="qp-package">

          {% if section.settings.package_image != blank %}

            {{
              section.settings.package_image
              | image_url: width: 1400
              | image_tag:
                class: 'qp-package-image',
                loading: 'lazy',
                widths: '500,800,1100,1400'
            }}

          {% else %}

            <div class="qp-package-placeholder">
              PACKAGING
            </div>

          {% endif %}

        </div>

      </div>

    </div>


    <!-- =========================
         FINAL CONTENT
    ========================== -->

    <div class="qp-final">

      <div class="qp-final-inner">

        <div class="qp-final-brand">
          QUESTPROPS™ NECK RESTORE
        </div>

        <h2>
          MEET YOUR<br>
          DAILY RESET.
        </h2>

        <div class="qp-final-price">
          $119.99
        </div>

        <a
          href="{{ section.settings.button_link }}"
          class="qp-final-button"
        >
          {{ section.settings.button_text }}
          <span>→</span>
        </a>

        <div class="qp-final-trust">
          60-Day Trial · 2-Year Warranty · Free Shipping
        </div>

      </div>

    </div>

  </div>

</section>


<style>

/* =====================================================
   MAIN
===================================================== */

#qp-sticky-{{ section.id }} {

  position: relative;

  width: 100%;

  background: #f3f1ec;

  color: #171717;

  overflow: clip;

}


/* =====================================================
   SCROLL LENGTH
===================================================== */

#qp-sticky-{{ section.id }} .qp-sticky-scroll {

  position: relative;

  height: 650vh;

}


/* =====================================================
   PRODUCT STICKY
===================================================== */

#qp-sticky-{{ section.id }} .qp-product-sticky {

  position: sticky;

  top: 0;

  height: 100vh;

  height: 100svh;

  width: 100%;

  display: flex;

  align-items: center;

  justify-content: center;

  z-index: 10;

  pointer-events: none;

}


/* =====================================================
   PRODUCT
===================================================== */

#qp-sticky-{{ section.id }} .qp-product-wrap {

  position: relative;

  width: min(54vw, 780px);

  display: flex;

  align-items: center;

  justify-content: center;

}


#qp-sticky-{{ section.id }} .qp-product-image {

  display: block;

  width: 100%;

  height: auto;

  object-fit: contain;

  transform-origin: center center;

  will-change: transform;

  filter: drop-shadow(
    0 25px 45px rgba(0,0,0,.08)
  );

}


/* =====================================================
   PACKAGE
===================================================== */

#qp-sticky-{{ section.id }} .qp-package {

  position: absolute;

  width: 31%;

  right: -3%;

  bottom: -7%;

  opacity: 0;

  transform:
    translateY(100px)
    rotate(7deg)
    scale(.75);

  transform-origin: bottom center;

  will-change: transform, opacity;

}


#qp-sticky-{{ section.id }} .qp-package-image {

  width: 100%;

  height: auto;

  display: block;

}


#qp-sticky-{{ section.id }} .qp-package-placeholder {

  aspect-ratio: 1 / 1;

  border: 1px dashed #aaa;

  display: flex;

  align-items: center;

  justify-content: center;

  font-size: 10px;

  letter-spacing: .15em;

}


/* =====================================================
   BIG TYPOGRAPHY
===================================================== */

#qp-sticky-{{ section.id }} .qp-big-copy {

  position: absolute;

  inset: 0;

  z-index: 3;

  pointer-events: none;

  overflow: hidden;

}


#qp-sticky-{{ section.id }} .qp-copy-line {

  position: absolute;

  white-space: nowrap;

  font-size: clamp(
    90px,
    14vw,
    220px
  );

  line-height: .78;

  letter-spacing: -.075em;

  font-weight: 700;

  text-transform: uppercase;

  will-change: transform, opacity;

}


/* =====================================================
   TEXT POSITIONS
===================================================== */

#qp-sticky-{{ section.id }} .line-1 {

  top: 13%;

  left: -2%;

}


#qp-sticky-{{ section.id }} .line-2 {

  top: 27%;

  right: -6%;

}


#qp-sticky-{{ section.id }} .line-3 {

  top: 15%;

  left: -8%;

}


#qp-sticky-{{ section.id }} .line-4 {

  top: 35%;

  right: -10%;

}


#qp-sticky-{{ section.id }} .line-5 {

  top: 17%;

  left: -3%;

}


#qp-sticky-{{ section.id }} .line-6 {

  top: 37%;

  right: -8%;

}


#qp-sticky-{{ section.id }} .line-7 {

  top: 25%;

  left: -8%;

}


/* =====================================================
   TEXT Z-INDEX
===================================================== */

#qp-sticky-{{ section.id }} .qp-big-copy {

  z-index: 5;

}


/*
   Product is above the typography.
   This creates the "product covering text" effect.
*/

#qp-sticky-{{ section.id }} .qp-product-sticky {

  z-index: 20;

}


/* =====================================================
   FINAL
===================================================== */

#qp-sticky-{{ section.id }} .qp-final {

  position: absolute;

  top: 520vh;

  left: 0;

  width: 100%;

  height: 100vh;

  display: flex;

  align-items: center;

  justify-content: center;

  z-index: 30;

  pointer-events: none;

}


#qp-sticky-{{ section.id }} .qp-final-inner {

  text-align: center;

  opacity: 0;

  transform: translateY(50px);

  transition:
    opacity .8s ease,
    transform .8s cubic-bezier(.22,.61,.36,1);

}


#qp-sticky-{{ section.id }} .qp-final.active
.qp-final-inner {

  opacity: 1;

  transform: translateY(0);

}


#qp-sticky-{{ section.id }} .qp-final-brand {

  font-size: 11px;

  letter-spacing: .22em;

  margin-bottom: 24px;

}


#qp-sticky-{{ section.id }} .qp-final h2 {

  margin: 0 0 22px;

  font-size: clamp(
    55px,
    7vw,
    110px
  );

  line-height: .86;

  letter-spacing: -.065em;

}


#qp-sticky-{{ section.id }} .qp-final-price {

  font-size: 23px;

  margin-bottom: 24px;

}


#qp-sticky-{{ section.id }} .qp-final-button {

  pointer-events: auto;

  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 16px;

  min-width: 220px;

  padding: 17px 30px;

  background: #171717;

  color: #fff;

  text-decoration: none;

  font-size: 12px;

  font-weight: 600;

  letter-spacing: .09em;

  transition:
    transform .25s ease,
    opacity .25s ease;

}


#qp-sticky-{{ section.id }} .qp-final-button:hover {

  transform: translateY(-2px);

  opacity: .9;

}


#qp-sticky-{{ section.id }} .qp-final-trust {

  margin-top: 18px;

  font-size: 11px;

  opacity: .55;

}


/* =====================================================
   MOBILE
===================================================== */

@media screen and (max-width: 749px) {


  #qp-sticky-{{ section.id }} .qp-sticky-scroll {

    height: 650vh;

  }


  #qp-sticky-{{ section.id }} .qp-product-sticky {

    height: 100svh;

  }


  #qp-sticky-{{ section.id }} .qp-product-wrap {

    width: 88vw;

  }


  #qp-sticky-{{ section.id }} .qp-copy-line {

    font-size: clamp(
      58px,
      17vw,
      100px
    );

    line-height: .8;

    letter-spacing: -.07em;

  }


  #qp-sticky-{{ section.id }} .line-1 {

    top: 18%;

    left: -8%;

  }


  #qp-sticky-{{ section.id }} .line-2 {

    top: 31%;

    right: -35%;

  }


  #qp-sticky-{{ section.id }} .line-3 {

    top: 16%;

    left: -22%;

  }


  #qp-sticky-{{ section.id }} .line-4 {

    top: 34%;

    right: -30%;

  }


  #qp-sticky-{{ section.id }} .line-5 {

    top: 20%;

    left: -8%;

  }


  #qp-sticky-{{ section.id }} .line-6 {

    top: 36%;

    right: -28%;

  }


  #qp-sticky-{{ section.id }} .line-7 {

    top: 25%;

    left: -25%;

  }


  #qp-sticky-{{ section.id }} .qp-package {

    width: 38%;

    right: -3%;

    bottom: -4%;

  }


  #qp-sticky-{{ section.id }} .qp-final {

    top: 520vh;

    height: 100svh;

    padding: 0 6%;

  }


  #qp-sticky-{{ section.id }} .qp-final h2 {

    font-size: clamp(
      46px,
      13vw,
      68px
    );

  }


  #qp-sticky-{{ section.id }} .qp-final-button {

    min-width: 190px;

    padding: 16px 22px;

  }


  #qp-sticky-{{ section.id }} .qp-final-trust {

    max-width: 280px;

    margin-left: auto;

    margin-right: auto;

    line-height: 1.5;

  }

}

</style>


<script>

(function() {

  const root =
    document.querySelector(
      '#qp-sticky-{{ section.id }}'
    );

  if (!root) return;


  const scrollArea =
    root.querySelector(
      '.qp-sticky-scroll'
    );

  const product =
    root.querySelector(
      '.qp-product-image'
    );

  const packageBox =
    root.querySelector(
      '.qp-package'
    );

  const final =
    root.querySelector(
      '.qp-final'
    );


  const lines =
    root.querySelectorAll(
      '.qp-copy-line'
    );


  function update() {

    const rect =
      scrollArea.getBoundingClientRect();


    const total =
      scrollArea.offsetHeight -
      window.innerHeight;


    if (total <= 0) return;


    let progress =
      -rect.top / total;


    progress =
      Math.max(
        0,
        Math.min(
          1,
          progress
        )
      );


    /*
      Product scale
    */

    if (product) {

      let scale = 1;

      let rotate = 0;

      let y = 0;


      if (progress < .25) {

        scale =
          0.92 +
          progress * .55;

        rotate =
          -2 +
          progress * 8;

        y =
          progress * -30;

      }

      else if (progress < .5) {

        scale =
          1.05 +
          (progress - .25) * .45;

        rotate =
          0;

        y =
          -30;

      }

      else if (progress < .72) {

        scale =
          1.16 +
          (progress - .5) * .35;

        rotate =
          2;

        y =
          -10;

      }

      else {

        scale =
          1.23;

        rotate =
          0;

        y =
          0;

      }


      product.style.transform =
        `
        translateY(${y}px)
        scale(${scale})
        rotate(${rotate}deg)
        `;

    }


    /*
      Typography movement
    */

    lines.forEach(
      function(line, index) {

        let move = 0;

        let opacity = 1;


        const offset =
          index * .035;


        move =
          (progress - offset) *
          (index % 2 === 0 ? -420 : 420);


        /*
          Fade lines as they leave
        */

        if (
          progress >
          .65
        ) {

          opacity =
            Math.max(
              0,
              1 -
              ((progress - .65) / .25)
            );

        }


        line.style.transform =
          `translate3d(${move}px,0,0)`;


        line.style.opacity =
          opacity;

      }
    );


    /*
      Packaging enters
    */

    if (packageBox) {

      const start =
        .62;

      let p =
        (progress - start) /
        .16;


      p =
        Math.max(
          0,
          Math.min(
            1,
            p
          )
        );


      packageBox.style.opacity =
        p;


      packageBox.style.transform =
        `
        translateY(${100 - (100 * p)}px)
        rotate(${7 - (7 * p)}deg)
        scale(${.75 + (.25 * p)})
        `;

    }


    /*
      Final CTA
    */

    if (final) {

      if (progress > .79) {

        final.classList.add(
          'active'
        );

      }

      else {

        final.classList.remove(
          'active'
        );

      }

    }

  }


  let ticking = false;


  function requestUpdate() {

    if (ticking) return;


    ticking = true;


    requestAnimationFrame(
      function() {

        update();

        ticking = false;

      }
    );

  }


  window.addEventListener(
    'scroll',
    requestUpdate,
    {
      passive: true
    }
  );


  window.addEventListener(
    'resize',
    requestUpdate
  );


  update();

})();

</script>


{% schema %}

{
  "name": "QP Sticky Neck Story",

  "settings": [

    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product image"
    },

    {
      "type": "image_picker",
      "id": "package_image",
      "label": "Packaging image"
    },

    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SHOP NECK RESTORE"
    },

    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }

  ],

  "presets": [
    {
      "name": "QP Sticky Neck Story"
    }
  ]

}

{% endschema %}