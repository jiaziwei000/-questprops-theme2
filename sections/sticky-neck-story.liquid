<section id="qp-sticky-{{ section.id }}" class="qp-sticky">
  <div class="qp-scroll">

    <!-- =========================
         GIANT TYPOGRAPHY
    ========================== -->

    <div class="qp-words">

      <div class="qp-word word-1">
        THE DAY
      </div>

      <div class="qp-word word-2">
        KEEPS GOING.
      </div>

      <div class="qp-word word-3">
        YOUR NECK
      </div>

      <div class="qp-word word-4">
        FEELS IT.
      </div>

      <div class="qp-word word-5">
        HEAT.
      </div>

      <div class="qp-word word-6">
        STIMULATION.
      </div>

      <div class="qp-word word-7">
        QUIET.
      </div>

      <div class="qp-word word-8">
        TEN MINUTES.
      </div>

    </div>


    <!-- =========================
         SMALL SUPPORTING COPY
    ========================== -->

    <div class="qp-support">

      <div class="support support-1">
        Sitting. Driving. Working.<br>
        There's always something next.
      </div>

      <div class="support support-2">
        So give yourself<br>
        a few minutes back.
      </div>

      <div class="support support-3">
        A simple reset<br>
        in the middle of your day.
      </div>

    </div>


    <!-- =========================
         PRODUCT
    ========================== -->

    <div class="qp-product-layer">

      <div class="qp-product">

        {% if section.settings.product_image != blank %}

          {{
            section.settings.product_image
            | image_url: width: 2200
            | image_tag:
              class: 'qp-product-img',
              loading: 'eager',
              widths: '800,1200,1600,2000,2200'
          }}

        {% else %}

          <div class="qp-placeholder">
            PRODUCT IMAGE
          </div>

        {% endif %}


        <!-- =========================
             PACKAGE
        ========================== -->

        <div class="qp-package">

          {% if section.settings.package_image != blank %}

            {{
              section.settings.package_image
              | image_url: width: 1400
              | image_tag:
                class: 'qp-package-img',
                loading: 'lazy',
                widths: '500,800,1100,1400'
            }}

          {% else %}

            <div class="qp-package-placeholder">
              PACKAGING
            </div>

          {% endif %}

        </div>

      </div>

    </div>


    <!-- =========================
         FINAL MESSAGE
    ========================== -->

    <div class="qp-final">

      <div class="qp-final-content">

        <div class="qp-brand">
          QUESTPROPS™ NECK RESTORE
        </div>

        <h2>
          RESET.<br>
          THEN GET BACK<br>
          TO WHAT MATTERS.
        </h2>

        <p>
          Your daily neck reset.
        </p>

        <div class="qp-price">
          $119.99
        </div>

        <a
          href="{{ section.settings.button_link }}"
          class="qp-button"
        >
          {{ section.settings.button_text }}
          <span>→</span>
        </a>

        <div class="qp-trust">
          60-Day Trial · 2-Year Warranty · Free Shipping
        </div>

      </div>

    </div>

  </div>
</section>


<style>

/* =====================================================
   ROOT
===================================================== */

#qp-sticky-{{ section.id }} {

  position: relative;

  width: 100%;

  background: #f3f1ec;

  color: #171717;

  overflow: clip;

}


/* =====================================================
   SCROLL LENGTH
===================================================== */

#qp-sticky-{{ section.id }} .qp-scroll {

  position: relative;

  height: 700vh;

}


/* =====================================================
   PRODUCT LAYER
===================================================== */

#qp-sticky-{{ section.id }} .qp-product-layer {

  position: sticky;

  top: 0;

  height: 100vh;

  height: 100svh;

  width: 100%;

  display: flex;

  align-items: center;

  justify-content: center;

  z-index: 20;

  pointer-events: none;

}


/* =====================================================
   PRODUCT
===================================================== */

#qp-sticky-{{ section.id }} .qp-product {

  position: relative;

  width: min(58vw, 820px);

  display: flex;

  align-items: center;

  justify-content: center;

}


#qp-sticky-{{ section.id }} .qp-product-img {

  display: block;

  width: 100%;

  height: auto;

  object-fit: contain;

  transform-origin: center center;

  will-change: transform;

  filter:
    drop-shadow(
      0 30px 55px rgba(0,0,0,.08)
    );

}


/* =====================================================
   PACKAGE
===================================================== */

#qp-sticky-{{ section.id }} .qp-package {

  position: absolute;

  width: 30%;

  right: -2%;

  bottom: -5%;

  opacity: 0;

  transform:
    translateY(120px)
    rotate(8deg)
    scale(.72);

  will-change:
    transform,
    opacity;

}


#qp-sticky-{{ section.id }} .qp-package-img {

  display: block;

  width: 100%;

  height: auto;

}


#qp-sticky-{{ section.id }} .qp-package-placeholder {

  width: 100%;

  aspect-ratio: 1 / 1;

  border: 1px dashed #999;

  display: flex;

  align-items: center;

  justify-content: center;

  font-size: 10px;

  letter-spacing: .15em;

}


/* =====================================================
   GIANT WORDS
===================================================== */

#qp-sticky-{{ section.id }} .qp-words {

  position: absolute;

  inset: 0;

  z-index: 5;

  overflow: hidden;

  pointer-events: none;

}


#qp-sticky-{{ section.id }} .qp-word {

  position: absolute;

  white-space: nowrap;

  font-size:
    clamp(
      90px,
      13vw,
      210px
    );

  line-height: .78;

  letter-spacing: -.075em;

  font-weight: 700;

  text-transform: uppercase;

  will-change:
    transform,
    opacity;

}


/* =====================================================
   WORD POSITIONS
===================================================== */

#qp-sticky-{{ section.id }} .word-1 {

  top: 10%;

  left: -2%;

}


#qp-sticky-{{ section.id }} .word-2 {

  top: 27%;

  right: -6%;

}


#qp-sticky-{{ section.id }} .word-3 {

  top: 13%;

  left: -7%;

}


#qp-sticky-{{ section.id }} .word-4 {

  top: 35%;

  right: -8%;

}


#qp-sticky-{{ section.id }} .word-5 {

  top: 15%;

  left: -3%;

}


#qp-sticky-{{ section.id }} .word-6 {

  top: 31%;

  right: -10%;

}


#qp-sticky-{{ section.id }} .word-7 {

  top: 43%;

  left: 2%;

}


#qp-sticky-{{ section.id }} .word-8 {

  top: 22%;

  left: -5%;

}


/* =====================================================
   SUPPORT COPY
===================================================== */

#qp-sticky-{{ section.id }} .qp-support {

  position: absolute;

  inset: 0;

  z-index: 25;

  pointer-events: none;

}


#qp-sticky-{{ section.id }} .support {

  position: absolute;

  font-size: 14px;

  line-height: 1.5;

  letter-spacing: -.01em;

  opacity: 0;

  transition:
    opacity .5s ease,
    transform .6s ease;

}


#qp-sticky-{{ section.id }} .support-1 {

  left: 8%;

  bottom: 12%;

}


#qp-sticky-{{ section.id }} .support-2 {

  right: 8%;

  bottom: 15%;

}


#qp-sticky-{{ section.id }} .support-3 {

  left: 8%;

  bottom: 15%;

}


/* =====================================================
   FINAL
===================================================== */

#qp-sticky-{{ section.id }} .qp-final {

  position: absolute;

  left: 0;

  top: 560vh;

  width: 100%;

  height: 100vh;

  display: flex;

  align-items: center;

  justify-content: center;

  z-index: 40;

  pointer-events: none;

}


#qp-sticky-{{ section.id }} .qp-final-content {

  text-align: center;

  opacity: 0;

  transform: translateY(60px);

  transition:
    opacity .8s ease,
    transform .8s cubic-bezier(.22,.61,.36,1);

}


#qp-sticky-{{ section.id }} .qp-final.active
.qp-final-content {

  opacity: 1;

  transform: translateY(0);

}


#qp-sticky-{{ section.id }} .qp-brand {

  font-size: 11px;

  letter-spacing: .22em;

  margin-bottom: 25px;

}


#qp-sticky-{{ section.id }} .qp-final h2 {

  margin: 0;

  font-size:
    clamp(
      50px,
      7vw,
      110px
    );

  line-height: .86;

  letter-spacing: -.065em;

}


#qp-sticky-{{ section.id }} .qp-final p {

  margin:
    28px
    0
    14px;

  font-size: 16px;

}


#qp-sticky-{{ section.id }} .qp-price {

  font-size: 23px;

  margin-bottom: 25px;

}


#qp-sticky-{{ section.id }} .qp-button {

  pointer-events: auto;

  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 15px;

  min-width: 220px;

  padding: 17px 30px;

  background: #171717;

  color: #fff;

  text-decoration: none;

  font-size: 12px;

  font-weight: 600;

  letter-spacing: .09em;

}


#qp-sticky-{{ section.id }} .qp-trust {

  margin-top: 18px;

  font-size: 11px;

  opacity: .55;

}


/* =====================================================
   MOBILE
===================================================== */

@media screen and (max-width: 749px) {

  #qp-sticky-{{ section.id }} .qp-scroll {

    height: 700vh;

  }


  #qp-sticky-{{ section.id }} .qp-product {

    width: 92vw;

  }


  #qp-sticky-{{ section.id }} .qp-word {

    font-size:
      clamp(
        58px,
        17vw,
        105px
      );

    line-height: .8;

    letter-spacing: -.075em;

  }


  #qp-sticky-{{ section.id }} .word-1 {

    top: 16%;

    left: -10%;

  }


  #qp-sticky-{{ section.id }} .word-2 {

    top: 30%;

    right: -35%;

  }


  #qp-sticky-{{ section.id }} .word-3 {

    top: 17%;

    left: -28%;

  }


  #qp-sticky-{{ section.id }} .word-4 {

    top: 34%;

    right: -32%;

  }


  #qp-sticky-{{ section.id }} .word-5 {

    top: 17%;

    left: -8%;

  }


  #qp-sticky-{{ section.id }} .word-6 {

    top: 31%;

    right: -48%;

  }


  #qp-sticky-{{ section.id }} .word-7 {

    top: 43%;

    left: -5%;

  }


  #qp-sticky-{{ section.id }} .word-8 {

    top: 25%;

    left: -28%;

  }


  #qp-sticky-{{ section.id }} .qp-package {

    width: 38%;

    right: -2%;

    bottom: -3%;

  }


  #qp-sticky-{{ section.id }} .support {

    font-size: 12px;

  }


  #qp-sticky-{{ section.id }} .support-1 {

    left: 6%;

    bottom: 8%;

  }


  #qp-sticky-{{ section.id }} .support-2 {

    right: 6%;

    bottom: 8%;

  }


  #qp-sticky-{{ section.id }} .support-3 {

    left: 6%;

    bottom: 8%;

  }


  #qp-sticky-{{ section.id }} .qp-final {

    top: 560vh;

    height: 100svh;

    padding: 0 6%;

  }


  #qp-sticky-{{ section.id }} .qp-final h2 {

    font-size:
      clamp(
        44px,
        12vw,
        68px
      );

  }


  #qp-sticky-{{ section.id }} .qp-final p {

    font-size: 14px;

  }


  #qp-sticky-{{ section.id }} .qp-final-trust {

    max-width: 280px;

    margin-left: auto;

    margin-right: auto;

    line-height: 1.5;

  }

}

</style>


<script>

(function() {

  const root =
    document.querySelector(
      '#qp-sticky-{{ section.id }}'
    );

  if (!root) return;


  const scroll =
    root.querySelector(
      '.qp-scroll'
    );

  const product =
    root.querySelector(
      '.qp-product-img'
    );

  const packageBox =
    root.querySelector(
      '.qp-package'
    );

  const final =
    root.querySelector(
      '.qp-final'
    );

  const words =
    root.querySelectorAll(
      '.qp-word'
    );

  const supports =
    root.querySelectorAll(
      '.support'
    );


  function update() {

    const rect =
      scroll.getBoundingClientRect();

    const max =
      scroll.offsetHeight -
      window.innerHeight;


    if (max <= 0) return;


    let progress =
      -rect.top / max;


    progress =
      Math.max(
        0,
        Math.min(
          1,
          progress
        )
      );


    /* =====================
       PRODUCT MOVEMENT
    ====================== */

    if (product) {

      let scale;

      let rotate;

      let y;


      if (progress < .25) {

        scale =
          .88 +
          progress * .75;

        rotate =
          -2 +
          progress * 8;

        y =
          progress * -40;

      }

      else if (progress < .5) {

        scale =
          1.07 +
          (progress - .25) * .5;

        rotate =
          0;

        y =
          -35;

      }

      else if (progress < .72) {

        scale =
          1.19 +
          (progress - .5) * .45;

        rotate =
          2;

        y =
          -10;

      }

      else {

        scale =
          1.29;

        rotate =
          0;

        y =
          0;

      }


      product.style.transform =
        `
        translate3d(0,${y}px,0)
        scale(${scale})
        rotate(${rotate}deg)
        `;

    }


    /* =====================
       WORD MOVEMENT
    ====================== */

    words.forEach(
      function(word, index) {

        const direction =
          index % 2 === 0
            ? -1
            : 1;


        const speed =
          280 +
          index * 45;


        const move =
          progress *
          speed *
          direction;


        let opacity = 1;


        if (progress > .55) {

          opacity =
            Math.max(
              0,
              1 -
              ((progress - .55) / .25)
            );

        }


        word.style.transform =
          `
          translate3d(
            ${move}px,
            0,
            0
          )
          `;


        word.style.opacity =
          opacity;

      }
    );


    /* =====================
       SUPPORTING COPY
    ====================== */

    supports.forEach(
      function(item) {

        item.style.opacity = 0;

      }
    );


    if (
      progress > .05 &&
      progress < .27
    ) {

      supports[0].style.opacity = 1;

    }


    if (
      progress > .27 &&
      progress < .48
    ) {

      supports[1].style.opacity = 1;

    }


    if (
      progress > .48 &&
      progress < .67
    ) {

      supports[2].style.opacity = 1;

    }


    /* =====================
       PACKAGE
    ====================== */

    if (packageBox) {

      const start = .62;

      let p =
        (progress - start) / .14;


      p =
        Math.max(
          0,
          Math.min(
            1,
            p
          )
        );


      packageBox.style.opacity =
        p;


      packageBox.style.transform =
        `
        translate3d(
          0,
          ${100 - (100 * p)}px,
          0
        )
        rotate(
          ${8 - (8 * p)}deg
        )
        scale(
          ${.72 + (.28 * p)}
        )
        `;

    }


    /* =====================
       FINAL
    ====================== */

    if (final) {

      if (progress > .78) {

        final.classList.add(
          'active'
        );

      } else {

        final.classList.remove(
          'active'
        );

      }

    }

  }


  let ticking = false;


  function requestUpdate() {

    if (ticking) return;


    ticking = true;


    requestAnimationFrame(
      function() {

        update();

        ticking = false;

      }
    );

  }


  window.addEventListener(
    'scroll',
    requestUpdate,
    {
      passive: true
    }
  );


  window.addEventListener(
    'resize',
    requestUpdate
  );


  update();

})();

</script>


{% schema %}

{
  "name": "QP Sticky Neck Story",

  "settings": [

    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product image"
    },

    {
      "type": "image_picker",
      "id": "package_image",
      "label": "Packaging image"
    },

    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SHOP NECK RESTORE"
    },

    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }

  ],

  "presets": [
    {
      "name": "QP Sticky Neck Story"
    }
  ]

}

{% endschema %}