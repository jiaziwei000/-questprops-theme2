<section
  id="QPScrollStory-{{ section.id }}"
  class="qp-scroll-story"
>

  <!-- =====================================================
       SCENE 01
       THE PROBLEM
       ===================================================== -->

  <section class="qp-scene qp-scene--problem">

    <div class="qp-sticky">

      <div class="qp-big-word qp-big-word--problem">
        TENSION
      </div>

      <div class="qp-problem-copy">
        <span>THE DAILY BUILDUP</span>

        <h2>
          Your neck<br>
          does a lot.
        </h2>
      </div>

      <div class="qp-main-product">

        {% if section.settings.product_image != blank %}

          {{
            section.settings.product_image
            | image_url: width: 1600
            | image_tag:
              widths: '500,700,900,1100,1400,1600',
              loading: 'lazy',
              class: 'qp-product-img'
          }}

        {% endif %}

      </div>

      <div class="qp-side-card qp-side-card--left">

        <strong>LONG HOURS</strong>

        <span>
          Sitting. Driving. Working.
        </span>

      </div>

      <div class="qp-side-card qp-side-card--right">

        <strong>NECK TENSION</strong>

        <span>
          Builds up over the day.
        </span>

      </div>

    </div>

  </section>


  <!-- =====================================================
       SCENE 02
       THE RESET
       ===================================================== -->

  <section class="qp-scene qp-scene--reset">

    <div class="qp-sticky">

      <div class="qp-big-word qp-big-word--reset">
        RESET
      </div>

      <div class="qp-reset-product">

        {% if section.settings.product_image != blank %}

          {{
            section.settings.product_image
            | image_url: width: 1600
            | image_tag:
              widths: '500,700,900,1100,1400,1600',
              loading: 'lazy',
              class: 'qp-product-img'
          }}

        {% endif %}

        <div class="qp-feature-tag qp-feature-tag--ems">
          EMS
        </div>

        <div class="qp-feature-tag qp-feature-tag--heat">
          HEAT
        </div>

      </div>


      <div class="qp-reset-copy">

        <span>
          QUESTPROPS™ NECK RESTORE
        </span>

        <div class="qp-copy-step qp-copy-step--1">

          Gentle EMS<br>
          stimulation.

        </div>

        <div class="qp-copy-step qp-copy-step--2">

          Soothing<br>
          heat.

        </div>

        <div class="qp-copy-step qp-copy-step--3">

          Designed for<br>
          your daily reset.

        </div>

      </div>

    </div>

  </section>


  <!-- =====================================================
       SCENE 03
       TEN MINUTES
       ===================================================== -->

  <section class="qp-scene qp-scene--routine">

    <div class="qp-sticky">

      <div class="qp-routine-number">
        10
      </div>

      <div class="qp-routine-label">
        MINUTES A DAY
      </div>

      <div class="qp-routine-product">

        {% if section.settings.product_image != blank %}

          {{
            section.settings.product_image
            | image_url: width: 1400
            | image_tag:
              widths: '500,700,900,1100,1400',
              loading: 'lazy',
              class: 'qp-product-img'
          }}

        {% endif %}

      </div>

      <div class="qp-routine-copy">

        <h2>

          A simple reset<br>
          you can actually stick with.

        </h2>

      </div>

    </div>

  </section>


  <!-- =====================================================
       FINAL CTA
       ===================================================== -->

  <section class="qp-scroll-final">

    <div>

      <span>
        QUESTPROPS™ NECK RESTORE
      </span>

      <h2>

        Your daily<br>
        neck reset.

      </h2>

      {% if section.settings.product_url != blank %}

        <a href="{{ section.settings.product_url }}">
          RESET YOUR NECK
        </a>

      {% endif %}

    </div>

  </section>

</section>



<style>

/* =========================================================
   ROOT
   ========================================================= */

#QPScrollStory-{{ section.id }} {

  --qp-bg: #ffffff;

  --qp-text: #171717;

  --qp-muted: rgba(23,23,23,.48);

  --qp-accent: #fde047;

  background:
    var(--qp-bg);

  color:
    var(--qp-text);

  overflow:
    clip;

}


/* =========================================================
   SCENES
   ========================================================= */

#QPScrollStory-{{ section.id }}
.qp-scene {

  position:
    relative;

  width:
    100%;

}


/* Scene 01 */

#QPScrollStory-{{ section.id }}
.qp-scene--problem {

  height:
    150vh;

}


/* Scene 02 */

#QPScrollStory-{{ section.id }}
.qp-scene--reset {

  height:
    200vh;

}


/* Scene 03 */

#QPScrollStory-{{ section.id }}
.qp-scene--routine {

  height:
    150vh;

}


/* =========================================================
   STICKY
   ========================================================= */

#QPScrollStory-{{ section.id }}
.qp-sticky {

  position:
    sticky;

  top:
    0;

  width:
    100%;

  height:
    100vh;

  height:
    100svh;

  overflow:
    hidden;

}


/* =========================================================
   GIANT BACKGROUND TEXT
   ========================================================= */

#QPScrollStory-{{ section.id }}
.qp-big-word {

  position:
    absolute;

  left:
    0;

  top:
    50%;

  z-index:
    1;

  white-space:
    nowrap;

  font-size:
    clamp(
      100px,
      17vw,
      300px
    );

  font-weight:
    900;

  line-height:
    .8;

  letter-spacing:
    -.08em;

  color:
    rgba(23,23,23,.055);

  pointer-events:
    none;

  will-change:
    transform,
    opacity;

}


/* =========================================================
   PRODUCT
   ========================================================= */

#QPScrollStory-{{ section.id }}
.qp-main-product,
#QPScrollStory-{{ section.id }}
.qp-reset-product,
#QPScrollStory-{{ section.id }}
.qp-routine-product {

  position:
    absolute;

  z-index:
    5;

  left:
    50%;

  top:
    50%;

  width:
    min(
      62vw,
      760px
    );

  transform:
    translate3d(
      -50%,
      -50%,
      0
    );

  will-change:
    transform,
    opacity;

}


#QPScrollStory-{{ section.id }}
.qp-product-img {

  display:
    block;

  width:
    100%;

  height:
    auto;

  object-fit:
    contain;

}


/* =========================================================
   SCENE 01 COPY
   ========================================================= */

#QPScrollStory-{{ section.id }}
.qp-problem-copy {

  position:
    absolute;

  z-index:
    10;

  left:
    8vw;

  bottom:
    10vh;

  opacity:
    0;

  transform:
    translate3d(
      0,
      40px,
      0
    );

  will-change:
    transform,
    opacity;

}


#QPScrollStory-{{ section.id }}
.qp-problem-copy span {

  display:
    block;

  margin-bottom:
    16px;

  font-size:
    10px;

  letter-spacing:
    .25em;

  color:
    var(--qp-muted);

}


#QPScrollStory-{{ section.id }}
.qp-problem-copy h2 {

  margin:
    0;

  font-size:
    clamp(
      40px,
      6vw,
      86px
    );

  line-height:
    .9;

  letter-spacing:
    -.06em;

}


/* =========================================================
   SIDE CARDS
   ========================================================= */

#QPScrollStory-{{ section.id }}
.qp-side-card {

  position:
    absolute;

  z-index:
    10;

  bottom:
    12vh;

  width:
    220px;

  opacity:
    0;

  will-change:
    transform,
    opacity;

}


#QPScrollStory-{{ section.id }}
.qp-side-card--left {

  left:
    6vw;

}


#QPScrollStory-{{ section.id }}
.qp-side-card--right {

  right:
    6vw;

}


#QPScrollStory-{{ section.id }}
.qp-side-card strong {

  display:
    block;

  font-size:
    11px;

  letter-spacing:
    .18em;

}


#QPScrollStory-{{ section.id }}
.qp-side-card span {

  display:
    block;

  margin-top:
    7px;

  font-size:
    14px;

  color:
    var(--qp-muted);

}


/* =========================================================
   SCENE 02 PRODUCT
   ========================================================= */

#QPScrollStory-{{ section.id }}
.qp-reset-product {

  opacity:
    0;

  transform:
    translate3d(
      -50%,
      -50%,
      0
    )
    scale(.88);

}


/* =========================================================
   FEATURE TAGS
   ========================================================= */

#QPScrollStory-{{ section.id }}
.qp-feature-tag {

  position:
    absolute;

  padding:
    10px 18px;

  border-radius:
    999px;

  background:
    var(--qp-accent);

  font-size:
    11px;

  font-weight:
    800;

  letter-spacing:
    .15em;

  opacity:
    0;

  will-change:
    transform,
    opacity;

}


#QPScrollStory-{{ section.id }}
.qp-feature-tag--ems {

  left:
    8%;

  top:
    28%;

}


#QPScrollStory-{{ section.id }}
.qp-feature-tag--heat {

  right:
    7%;

  top:
    58%;

}


/* =========================================================
   SCENE 02 COPY
   ========================================================= */

#QPScrollStory-{{ section.id }}
.qp-reset-copy {

  position:
    absolute;

  z-index:
    10;

  right:
    7vw;

  top:
    50%;

  width:
    min(
      36vw,
      480px
    );

  transform:
    translate3d(
      100px,
      -50%,
      0
    );

  opacity:
    0;

  will-change:
    transform,
    opacity;

}


#QPScrollStory-{{ section.id }}
.qp-reset-copy > span {

  display:
    block;

  margin-bottom:
    28px;

  font-size:
    10px;

  letter-spacing:
    .25em;

  color:
    var(--qp-muted);

}


#QPScrollStory-{{ section.id }}
.qp-copy-step {

  position:
    absolute;

  left:
    0;

  top:
    0;

  font-size:
    clamp(
      32px,
      4vw,
      64px
    );

  font-weight:
    700;

  line-height:
    1;

  letter-spacing:
    -.05em;

  opacity:
    0;

  transform:
    translateY(
      30px
    );

  will-change:
    transform,
    opacity;

}


/* =========================================================
   SCENE 03
   ========================================================= */

#QPScrollStory-{{ section.id }}
.qp-routine-number {

  position:
    absolute;

  z-index:
    1;

  left:
    50%;

  top:
    45%;

  transform:
    translate(
      -50%,
      -50%
    );

  font-size:
    clamp(
      180px,
      32vw,
      520px
    );

  font-weight:
    900;

  line-height:
    .75;

  letter-spacing:
    -.1em;

  color:
    rgba(23,23,23,.055);

  will-change:
    transform;

}


#QPScrollStory-{{ section.id }}
.qp-routine-label {

  position:
    absolute;

  z-index:
    10;

  left:
    50%;

  top:
    27%;

  transform:
    translateX(
      -50%
    );

  font-size:
    11px;

  letter-spacing:
    .3em;

  color:
    var(--qp-muted);

}


#QPScrollStory-{{ section.id }}
.qp-routine-product {

  z-index:
    5;

  width:
    min(
      42vw,
      520px
    );

}


#QPScrollStory-{{ section.id }}
.qp-routine-copy {

  position:
    absolute;

  z-index:
    10;

  left:
    50%;

  bottom:
    8vh;

  width:
    min(
      90vw,
      700px
    );

  transform:
    translateX(
      -50%
    );

  text-align:
    center;

  opacity:
    0;

  will-change:
    opacity,
    transform;

}


#QPScrollStory-{{ section.id }}
.qp-routine-copy h2 {

  margin:
    0;

  font-size:
    clamp(
      30px,
      4vw,
      60px
    );

  line-height:
    .95;

  letter-spacing:
    -.05em;

}


/* =========================================================
   FINAL CTA
   ========================================================= */

#QPScrollStory-{{ section.id }}
.qp-scroll-final {

  min-height:
    70vh;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  text-align:
    center;

  padding:
    80px 20px;

}


#QPScrollStory-{{ section.id }}
.qp-scroll-final span {

  font-size:
    10px;

  letter-spacing:
    .3em;

  color:
    var(--qp-muted);

}


#QPScrollStory-{{ section.id }}
.qp-scroll-final h2 {

  margin:
    20px 0 35px;

  font-size:
    clamp(
      42px,
      7vw,
      90px
    );

  line-height:
    .9;

  letter-spacing:
    -.06em;

}


#QPScrollStory-{{ section.id }}
.qp-scroll-final a {

  display:
    inline-flex;

  padding:
    16px 28px;

  background:
    var(--qp-text);

  color:
    white;

  text-decoration:
    none;

  font-size:
    12px;

  font-weight:
    700;

  letter-spacing:
    .12em;

}


/* =========================================================
   MOBILE
   ========================================================= */

@media screen and (max-width: 749px) {

  #QPScrollStory-{{ section.id }}
  .qp-scene--problem {

    height:
      145vh;

  }


  #QPScrollStory-{{ section.id }}
  .qp-scene--reset {

    height:
      180vh;

  }


  #QPScrollStory-{{ section.id }}
  .qp-scene--routine {

    height:
      145vh;

  }


  #QPScrollStory-{{ section.id }}
  .qp-big-word {

    font-size:
      24vw;

  }


  #QPScrollStory-{{ section.id }}
  .qp-main-product,
  #QPScrollStory-{{ section.id }}
  .qp-reset-product {

    width:
      88vw;

  }


  #QPScrollStory-{{ section.id }}
  .qp-problem-copy {

    left:
      7vw;

    bottom:
      8vh;

  }


  #QPScrollStory-{{ section.id }}
  .qp-side-card {

    width:
      140px;

    bottom:
      18vh;

  }


  #QPScrollStory-{{ section.id }}
  .qp-side-card--left {

    left:
      4vw;

  }


  #QPScrollStory-{{ section.id }}
  .qp-side-card--right {

    right:
      4vw;

  }


  #QPScrollStory-{{ section.id }}
  .qp-reset-product {

    width:
      82vw;

  }


  #QPScrollStory-{{ section.id }}
  .qp-reset-copy {

    left:
      7vw;

    right:
      auto;

    top:
      auto;

    bottom:
      9vh;

    width:
      86vw;

  }


  #QPScrollStory-{{ section.id }}
  .qp-routine-product {

    width:
      78vw;

  }

}


/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

  #QPScrollStory-{{ section.id }}
  .qp-scene {

    height:
      auto;

  }


  #QPScrollStory-{{ section.id }}
  .qp-sticky {

    position:
      relative;

    height:
      100vh;

  }

}

</style>



<script>

(function() {

  const root =
    document.getElementById(
      'QPScrollStory-{{ section.id }}'
    );

  if (!root) return;


  let ticking = false;


  /* =====================================================
     BASIC FUNCTIONS
     ===================================================== */

  function clamp(value) {

    return Math.max(
      0,
      Math.min(
        1,
        value
      )
    );

  }


  function map(
    value,
    inMin,
    inMax,
    outMin,
    outMax
  ) {

    const t =
      clamp(
        (value - inMin) /
        (inMax - inMin)
      );

    return (
      outMin +
      (
        outMax -
        outMin
      ) * t
    );

  }


  /* =====================================================
     SCENE PROGRESS
     ===================================================== */

  function progress(scene) {

    const rect =
      scene.getBoundingClientRect();


    const distance =
      scene.offsetHeight -
      window.innerHeight;


    if (
      distance <= 0
    ) {

      return 0;

    }


    return clamp(
      -rect.top /
      distance
    );

  }


  /* =====================================================
     UPDATE
     ===================================================== */

  function update() {

    ticking = false;


    /* ===================================================
       SCENE 01
       =================================================== */

    const scene1 =
      root.querySelector(
        '.qp-scene--problem'
      );


    if (scene1) {

      const p =
        progress(scene1);


      const word =
        root.querySelector(
          '.qp-big-word--problem'
        );


      const product =
        root.querySelector(
          '.qp-main-product'
        );


      const copy =
        root.querySelector(
          '.qp-problem-copy'
        );


      const cards =
        root.querySelectorAll(
          '.qp-side-card'
        );


      /* -----------------------------------------------
         BACKGROUND WORD
         ----------------------------------------------- */

      const wordX =
        map(
          p,
          0,
          .72,
          35,
          -30
        );


      const wordOpacity =
        map(
          p,
          .48,
          .9,
          1,
          0
        );


      word.style.transform =
        `
        translate3d(
          ${wordX}vw,
          -50%,
          0
        )
        `;


      word.style.opacity =
        wordOpacity;


      /* -----------------------------------------------
         PRODUCT
         ----------------------------------------------- */

      const productScale =
        map(
          p,
          0,
          .55,
          1.18,
          1
        );


      const productX =
        map(
          p,
          .35,
          .8,
          0,
          -8
        );


      product.style.transform =
        `
        translate3d(
          calc(
            -50% +
            ${productX}vw
          ),
          -50%,
          0
        )
        scale(
          ${productScale}
        )
        `;


      /* -----------------------------------------------
         MAIN COPY
         ----------------------------------------------- */

      const copyP =
        clamp(
          (p - .3) /
          .22
        );


      copy.style.opacity =
        copyP;


      copy.style.transform =
        `
        translate3d(
          0,
          ${map(
            copyP,
            0,
            1,
            40,
            0
          )}px,
          0
        )
        `;


      /* -----------------------------------------------
         SIDE CARDS
         ----------------------------------------------- */

      const cardP =
        clamp(
          (p - .12) /
          .38
        );


      cards.forEach(
        function(card) {

          card.style.opacity =
            cardP;


          card.style.transform =
            `
            translate3d(
              0,
              ${map(
                cardP,
                0,
                1,
                30,
                0
              )}px,
              0
            )
            `;

        }
      );

    }


    /* ===================================================
       SCENE 02
       =================================================== */

    const scene2 =
      root.querySelector(
        '.qp-scene--reset'
      );


    if (scene2) {

      const p =
        progress(scene2);


      const word =
        root.querySelector(
          '.qp-big-word--reset'
        );


      const product =
        root.querySelector(
          '.qp-reset-product'
        );


      const copy =
        root.querySelector(
          '.qp-reset-copy'
        );


      /* -----------------------------------------------
         BACKGROUND WORD
         ----------------------------------------------- */

      const wordX =
        map(
          p,
          0,
          .75,
          30,
          -28
        );


      const wordOpacity =
        map(
          p,
          .7,
          1,
          1,
          0
        );


      word.style.transform =
        `
        translate3d(
          ${wordX}vw,
          -50%,
          0
        )
        `;


      word.style.opacity =
        wordOpacity;


      /* -----------------------------------------------
         PRODUCT
         ----------------------------------------------- */

      const productP =
        clamp(
          p /
          .42
        );


      product.style.opacity =
        productP;


      product.style.transform =
        `
        translate3d(
          -50%,
          -50%,
          0
        )
        scale(
          ${map(
            productP,
            0,
            1,
            .88,
            1
          )}
        )
        `;


      /* -----------------------------------------------
         EMS
         ----------------------------------------------- */

      const ems =
        root.querySelector(
          '.qp-feature-tag--ems'
        );


      const emsP =
        clamp(
          (p - .12) /
          .16
        );


      ems.style.opacity =
        emsP;


      ems.style.transform =
        `
        translateY(
          ${map(
            emsP,
            0,
            1,
            20,
            0
          )}px
        )
        scale(
          ${map(
            emsP,
            0,
            1,
            .8,
            1
          )}
        )
        `;


      /* -----------------------------------------------
         HEAT
         ----------------------------------------------- */

      const heat =
        root.querySelector(
          '.qp-feature-tag--heat'
        );


      const heatP =
        clamp(
          (p - .25) /
          .16
        );


      heat.style.opacity =
        heatP;


      heat.style.transform =
        `
        translateY(
          ${map(
            heatP,
            0,
            1,
            20,
            0
          )}px
        )
        scale(
          ${map(
            heatP,
            0,
            1,
            .8,
            1
          )}
        )
        `;


      /* -----------------------------------------------
         RIGHT COPY
         ----------------------------------------------- */

      const copyP =
        clamp(
          (p - .48) /
          .28
        );


      copy.style.opacity =
        copyP;


      copy.style.transform =
        `
        translate3d(
          ${map(
            copyP,
            0,
            1,
            100,
            0
          )}px,
          -50%,
          0
        )
        `;


      /* -----------------------------------------------
         COPY STEPS
         ----------------------------------------------- */

      const steps =
        root.querySelectorAll(
          '.qp-copy-step'
        );


      steps.forEach(
        function(
          step,
          index
        ) {

          const starts = [
            .50,
            .64,
            .78
          ];


          const stepP =
            clamp(
              (
                p -
                starts[index]
              ) /
              .12
            );


          step.style.opacity =
            stepP;


          step.style.transform =
            `
            translateY(
              ${map(
                stepP,
                0,
                1,
                30,
                0
              )}px
            )
            `;

        }
      );

    }


    /* ===================================================
       SCENE 03
       =================================================== */

    const scene3 =
      root.querySelector(
        '.qp-scene--routine'
      );


    if (scene3) {

      const p =
        progress(scene3);


      const number =
        root.querySelector(
          '.qp-routine-number'
        );


      const product =
        root.querySelector(
          '.qp-routine-product'
        );


      const copy =
        root.querySelector(
          '.qp-routine-copy'
        );


      /* -----------------------------------------------
         GIANT NUMBER
         ----------------------------------------------- */

      const numberScale =
        map(
          p,
          0,
          .7,
          1.25,
          1
        );


      const numberY =
        map(
          p,
          0,
          .7,
          20,
          -40
        );


      number.style.transform =
        `
        translate3d(
          -50%,
          calc(
            -50% +
            ${numberY}px
          ),
          0
        )
        scale(
          ${numberScale}
        )
        `;


      /* -----------------------------------------------
         PRODUCT
         ----------------------------------------------- */

      const productScale =
        map(
          p,
          0,
          .75,
          1,
          .7
        );


      const productY =
        map(
          p,
          0,
          .75,
          0,
          -80
        );


      product.style.transform =
        `
        translate3d(
          -50%,
          calc(
            -50% +
            ${productY}px
          ),
          0
        )
        scale(
          ${productScale}
        )
        `;


      /* -----------------------------------------------
         FINAL COPY
         ----------------------------------------------- */

      const copyP =
        clamp(
          (
            p -
            .65
          ) /
          .25
        );


      copy.style.opacity =
        copyP;


      copy.style.transform =
        `
        translate3d(
          -50%,
          ${map(
            copyP,
            0,
            1,
            40,
            0
          )}px,
          0
        )
        `;

    }

  }


  /* =====================================================
     RAF SCROLL
     ===================================================== */

  function requestUpdate() {

    if (ticking) {

      return;

    }


    ticking = true;


    window.requestAnimationFrame(
      update
    );

  }


  window.addEventListener(
    'scroll',
    requestUpdate,
    {
      passive: true
    }
  );


  window.addEventListener(
    'resize',
    requestUpdate
  );


  update();

})();

</script>



