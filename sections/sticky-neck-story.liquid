<div id="gsap-container" style="height: 300vh; position: relative; background-color: #f7f3ed;">
  <!-- 吸附容器：保持瓶子在屏幕中心 -->
  <div id="sticky-box" style="position: sticky; top: 0; height: 100vh; display: flex; align-items: center; justify-content: center; overflow: hidden;">
    
    <!-- 背景大字：作为视觉基底 -->
    <div id="text-bg" style="position: absolute; font-size: 15vw; font-weight: 900; color: #b3222a; opacity: 0.1; white-space: nowrap; pointer-events: none;">
      GLACIER BLUE
    </div>

    <!-- 你的按摩仪图片：GSAP 将控制它的缩放 -->
    <img id="product-img" src="{{ section.settings.product_image | image_url: width: 1200 }}" 
         style="width: 400px; z-index: 10; transform-origin: center;">
  </div>
</div>

<!-- 引入 GSAP 和 ScrollTrigger -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

<script>
  gsap.registerPlugin(ScrollTrigger);

  // 创建滚动时间轴
  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: "#gsap-container",
      start: "top top",
      end: "bottom bottom",
      scrub: 1, // 关键：让动画与滚动条平滑联动
      pin: true // 锁定容器
    }
  });

  // 动画逻辑：滚动时缩放产品图，位移背景字
  tl.to("#product-img", { scale: 0.6, duration: 1 }) 
    .to("#text-bg", { x: "-20%", duration: 1 }, "<");
</script>

{% schema %}
{
  "name": "GSAP Magazine Scroll",
  "settings": [
    { "type": "image_picker", "id": "product_image", "label": "中间产品图片" }
  ],
  "presets": [{ "name": "GSAP Magazine Scroll" }]
}
{% endschema %}