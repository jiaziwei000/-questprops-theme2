<section id="qp-hero-story-{{ section.id }}" class="qp-hero-story">

  <div class="qp-story-track">

    <!-- =========================================
         FIXED TYPOGRAPHY
         文字完全固定，不跟着滚动移动
    ========================================== -->

    <div class="qp-type-layer">

      <div class="qp-type type-top">
        THE DAY
      </div>

      <div class="qp-type type-middle">
        DOESN'T
      </div>

      <div class="qp-type type-middle-right">
        WAIT.
      </div>

      <div class="qp-type type-bottom">
        YOUR NECK
      </div>

      <div class="qp-type type-bottom-right">
        HAS ENOUGH.
      </div>

      <div class="qp-type type-final">
        TAKE TEN.
      </div>

    </div>


    <!-- =========================================
         SMALL FIXED BRAND COPY
    ========================================== -->

    <div class="qp-microcopy">

      <div class="micro-left">
        QUESTPROPS™
      </div>

      <div class="micro-right">
        DAILY NECK RESET
      </div>

    </div>


    <!-- =========================================
         PRODUCT
         产品在最上层移动
    ========================================== -->

    <div class="qp-product-stage">

      <div class="qp-product-object">

        {% if section.settings.product_image != blank %}

          {{
            section.settings.product_image
            | image_url: width: 2400
            | image_tag:
              class: 'qp-product-image',
              loading: 'eager',
              widths: '800,1200,1600,2000,2400'
          }}

        {% else %}

          <div class="qp-image-placeholder">
            PRODUCT IMAGE
          </div>

        {% endif %}


        <!-- PACKAGE -->

        <div class="qp-package-object">

          {% if section.settings.package_image != blank %}

            {{
              section.settings.package_image
              | image_url: width: 1600
              | image_tag:
                class: 'qp-package-image',
                loading: 'lazy',
                widths: '600,900,1200,1600'
            }}

          {% else %}

            <div class="qp-package-placeholder">
              PACKAGING
            </div>

          {% endif %}

        </div>

      </div>

    </div>


    <!-- =========================================
         FINAL CTA
    ========================================== -->

    <div class="qp-story-final">

      <div class="qp-final-inner">

        <div class="qp-final-eyebrow">
          QUESTPROPS™ NECK RESTORE
        </div>

        <h2>
          COME BACK<br>
          FEELING READY.
        </h2>

        <p>
          Your simple daily neck reset.
        </p>

        <div class="qp-final-price">
          $119.99
        </div>

        <a
          href="{{ section.settings.button_link }}"
          class="qp-final-button"
        >
          {{ section.settings.button_text }}
          <span>→</span>
        </a>

        <div class="qp-final-trust">
          60-Day Trial · 2-Year Warranty · Free Shipping
        </div>

      </div>

    </div>

  </div>

</section>


<style>

/* =====================================================
   ROOT
===================================================== */

#qp-hero-story-{{ section.id }} {

  --qp-bg: #f3f1ec;
  --qp-text: #171717;

  position: relative;

  width: 100%;

  background: var(--qp-bg);

  color: var(--qp-text);

  overflow: clip;

}


/* =====================================================
   LONG SCROLL
===================================================== */

#qp-hero-story-{{ section.id }} .qp-story-track {

  position: relative;

  height: 650vh;

}


/* =====================================================
   FIXED TYPOGRAPHY
   THIS DOES NOT MOVE
===================================================== */

#qp-hero-story-{{ section.id }} .qp-type-layer {

  position: sticky;

  top: 0;

  width: 100%;

  height: 100vh;

  height: 100svh;

  overflow: hidden;

  z-index: 2;

  pointer-events: none;

}


/* =====================================================
   GIANT TYPE
===================================================== */

#qp-hero-story-{{ section.id }} .qp-type {

  position: absolute;

  white-space: nowrap;

  font-family: inherit;

  font-size: clamp(
    100px,
    15vw,
    250px
  );

  font-weight: 800;

  line-height: .76;

  letter-spacing: -.085em;

  text-transform: uppercase;

  color: #171717;

}


/* =====================================================
   TYPE COMPOSITION
===================================================== */

#qp-hero-story-{{ section.id }} .type-top {

  top: 8%;

  left: -3%;

}


#qp-hero-story-{{ section.id }} .type-middle {

  top: 34%;

  left: -7%;

}


#qp-hero-story-{{ section.id }} .type-middle-right {

  top: 49%;

  right: -5%;

}


#qp-hero-story-{{ section.id }} .type-bottom {

  top: 70%;

  left: -8%;

}


#qp-hero-story-{{ section.id }} .type-bottom-right {

  top: 82%;

  right: -12%;

}


#qp-hero-story-{{ section.id }} .type-final {

  top: 28%;

  left: -5%;

  opacity: 0;

}


/* =====================================================
   MICRO BRAND
===================================================== */

#qp-hero-story-{{ section.id }} .qp-microcopy {

  position: sticky;

  top: 0;

  height: 0;

  z-index: 8;

  pointer-events: none;

}


#qp-hero-story-{{ section.id }} .micro-left,
#qp-hero-story-{{ section.id }} .micro-right {

  position: absolute;

  top: 30px;

  font-size: 10px;

  font-weight: 600;

  letter-spacing: .18em;

}


#qp-hero-story-{{ section.id }} .micro-left {

  left: 32px;

}


#qp-hero-story-{{ section.id }} .micro-right {

  right: 32px;

}


/* =====================================================
   PRODUCT STAGE
===================================================== */

#qp-hero-story-{{ section.id }} .qp-product-stage {

  position: sticky;

  top: 0;

  height: 100vh;

  height: 100svh;

  margin-top: -100vh;

  margin-top: -100svh;

  display: flex;

  align-items: center;

  justify-content: center;

  z-index: 20;

  pointer-events: none;

}


/* =====================================================
   PRODUCT OBJECT
===================================================== */

#qp-hero-story-{{ section.id }} .qp-product-object {

  position: relative;

  width: min(
    54vw,
    820px
  );

  transform:
    translate3d(
      0,
      52vh,
      0
    )
    scale(.72);

  will-change:
    transform;

}


/* =====================================================
   PRODUCT IMAGE
===================================================== */

#qp-hero-story-{{ section.id }} .qp-product-image {

  display: block;

  width: 100%;

  height: auto;

  object-fit: contain;

  filter:
    drop-shadow(
      0 35px 55px rgba(0,0,0,.12)
    );

}


/* =====================================================
   PACKAGE
===================================================== */

#qp-hero-story-{{ section.id }} .qp-package-object {

  position: absolute;

  width: 31%;

  right: -3%;

  bottom: -4%;

  opacity: 0;

  transform:
    translate3d(
      80px,
      60px,
      0
    )
    rotate(9deg)
    scale(.65);

  transform-origin: center bottom;

  will-change:
    transform,
    opacity;

}


#qp-hero-story-{{ section.id }} .qp-package-image {

  display: block;

  width: 100%;

  height: auto;

  filter:
    drop-shadow(
      0 25px 35px rgba(0,0,0,.12)
    );

}


#qp-hero-story-{{ section.id }} .qp-package-placeholder {

  aspect-ratio: 1 / 1;

  border: 1px dashed #999;

  display: flex;

  align-items: center;

  justify-content: center;

  font-size: 9px;

}


/* =====================================================
   FINAL
===================================================== */

#qp-hero-story-{{ section.id }} .qp-story-final {

  position: absolute;

  top: 520vh;

  left: 0;

  width: 100%;

  min-height: 100vh;

  display: flex;

  align-items: center;

  justify-content: center;

  z-index: 40;

  pointer-events: none;

}


#qp-hero-story-{{ section.id }} .qp-final-inner {

  text-align: center;

  opacity: 0;

  transform: translateY(30px);

  transition:
    opacity .8s ease,
    transform .8s ease;

}


#qp-hero-story-{{ section.id }} .qp-final-inner.active {

  opacity: 1;

  transform: translateY(0);

}


#qp-hero-story-{{ section.id }} .qp-final-eyebrow {

  margin-bottom: 22px;

  font-size: 10px;

  letter-spacing: .22em;

  font-weight: 600;

}


#qp-hero-story-{{ section.id }} .qp-final-inner h2 {

  margin: 0;

  font-size: clamp(
    55px,
    7vw,
    115px
  );

  line-height: .82;

  letter-spacing: -.075em;

  font-weight: 800;

}


#qp-hero-story-{{ section.id }} .qp-final-inner p {

  margin:
    28px
    0
    12px;

  font-size: 15px;

}


#qp-hero-story-{{ section.id }} .qp-final-price {

  font-size: 23px;

  margin-bottom: 24px;

}


#qp-hero-story-{{ section.id }} .qp-final-button {

  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 18px;

  min-width: 225px;

  padding: 18px 30px;

  background: #171717;

  color: #fff;

  text-decoration: none;

  font-size: 11px;

  font-weight: 700;

  letter-spacing: .12em;

  pointer-events: auto;

}


#qp-hero-story-{{ section.id }} .qp-final-trust {

  margin-top: 18px;

  font-size: 10px;

  opacity: .55;

}


/* =====================================================
   MOBILE
===================================================== */

@media screen and (max-width: 749px) {

  #qp-hero-story-{{ section.id }} .qp-story-track {

    height: 650vh;

  }


  #qp-hero-story-{{ section.id }} .qp-type {

    font-size: 19vw;

    line-height: .78;

    letter-spacing: -.085em;

  }


  #qp-hero-story-{{ section.id }} .type-top {

    top: 13%;

    left: -7%;

  }


  #qp-hero-story-{{ section.id }} .type-middle {

    top: 36%;

    left: -12%;

  }


  #qp-hero-story-{{ section.id }} .type-middle-right {

    top: 49%;

    right: -15%;

  }


  #qp-hero-story-{{ section.id }} .type-bottom {

    top: 69%;

    left: -14%;

  }


  #qp-hero-story-{{ section.id }} .type-bottom-right {

    top: 82%;

    right: -35%;

  }


  #qp-hero-story-{{ section.id }} .qp-product-object {

    width: 92vw;

  }


  #qp-hero-story-{{ section.id }} .qp-package-object {

    width: 37%;

    right: -3%;

    bottom: -3%;

  }


  #qp-hero-story-{{ section.id }} .micro-left {

    left: 18px;

  }


  #qp-hero-story-{{ section.id }} .micro-right {

    right: 18px;

  }


  #qp-hero-story-{{ section.id }} .qp-final-inner {

    padding: 0 20px;

  }


  #qp-hero-story-{{ section.id }} .qp-final-inner h2 {

    font-size: 13vw;

  }

}

</style>


<script>

(function() {

  const root =
    document.querySelector(
      '#qp-hero-story-{{ section.id }}'
    );

  if (!root) return;


  const track =
    root.querySelector(
      '.qp-story-track'
    );

  const product =
    root.querySelector(
      '.qp-product-object'
    );

  const packageBox =
    root.querySelector(
      '.qp-package-object'
    );

  const final =
    root.querySelector(
      '.qp-final-inner'
    );


  function update() {

    const rect =
      track.getBoundingClientRect();

    const total =
      track.offsetHeight -
      window.innerHeight;


    if (total <= 0) return;


    let progress =
      -rect.top / total;


    progress =
      Math.max(
        0,
        Math.min(
          1,
          progress
        )
      );


    /* =========================================
       PRODUCT MOVEMENT

       0 → 从底部进入
       1 → 最终停住
    ========================================== */

    let x = 0;

    let y = 0;

    let scale = .72;

    let rotate = 0;


    if (progress < .18) {

      const p =
        progress / .18;

      y =
        52 -
        (52 * p);

      scale =
        .72 +
        (.18 * p);

      rotate =
        -3 +
        (3 * p);

    }

    else if (progress < .42) {

      const p =
        (progress - .18) /
        .24;

      y =
        0;

      x =
        -14 * p;

      scale =
        .90 +
        (.10 * p);

      rotate =
        0;

    }

    else if (progress < .68) {

      const p =
        (progress - .42) /
        .26;

      x =
        -14 +
        (28 * p);

      y =
        -2 * p;

      scale =
        1.0 +
        (.14 * p);

      rotate =
        -2 +
        (4 * p);

    }

    else if (progress < .82) {

      const p =
        (progress - .68) /
        .14;

      x =
        14 -
        (8 * p);

      y =
        -2;

      scale =
        1.14 +
        (.08 * p);

      rotate =
        2 -
        (2 * p);

    }

    else {

      x = 6;

      y = -2;

      scale = 1.22;

      rotate = 0;

    }


    product.style.transform =
      `
      translate3d(
        ${x}vw,
        ${y}vh,
        0
      )
      scale(${scale})
      rotate(${rotate}deg)
      `;


    /* =========================================
       PACKAGE
    ========================================== */

    if (packageBox) {

      let p =
        (progress - .70) /
        .14;


      p =
        Math.max(
          0,
          Math.min(
            1,
            p
          )
        );


      packageBox.style.opacity =
        p;


      packageBox.style.transform =
        `
        translate3d(
          ${80 - (80 * p)}px,
          ${60 - (60 * p)}px,
          0
        )
        rotate(
          ${9 - (9 * p)}deg
        )
        scale(
          ${.65 + (.35 * p)}
        )
        `;

    }


    /* =========================================
       FINAL CTA
    ========================================== */

    if (final) {

      if (progress > .84) {

        final.classList.add(
          'active'
        );

      } else {

        final.classList.remove(
          'active'
        );

      }

    }

  }


  let ticking = false;


  function requestUpdate() {

    if (ticking) return;

    ticking = true;


    requestAnimationFrame(
      function() {

        update();

        ticking = false;

      }
    );

  }


  window.addEventListener(
    'scroll',
    requestUpdate,
    {
      passive: true
    }
  );


  window.addEventListener(
    'resize',
    requestUpdate
  );


  update();

})();

</script>


{% schema %}

{
  "name": "QP Brand Scroll Story",

  "settings": [

    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product image"
    },

    {
      "type": "image_picker",
      "id": "package_image",
      "label": "Packaging image"
    },

    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SHOP NECK RESTORE"
    },

    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }

  ],

  "presets": [
    {
      "name": "QP Brand Scroll Story"
    }
  ]

}

{% endschema %}