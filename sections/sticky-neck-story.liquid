<div id="magazine-scroll-section" style="height: 400vh; position: relative; background-color: #f7f3ed; overflow: hidden;">
  
  <!-- 核心粘性视窗 -->
  <div id="magazine-sticky-viewport" style="position: sticky; top: 0; height: 100vh; display: flex; align-items: center; justify-content: center;">
    
    <!-- 背景巨型杂志大字 1 -->
    <div class="mag-bg-text text-phase-1" style="position: absolute; font-size: 14vw; font-weight: 900; color: rgba(179, 34, 42, 0.08); white-space: nowrap; text-transform: uppercase; z-index: 1;">
      UNLIMITED RELEASE
    </div>

    <!-- 背景巨型杂志大字 2 -->
    <div class="mag-bg-text text-phase-2" style="position: absolute; font-size: 16vw; font-weight: 900; color: rgba(179, 34, 42, 0.08); white-space: nowrap; text-transform: uppercase; opacity: 0; z-index: 1;">
      GLACIER FEEL
    </div>

    <!-- 左侧文案随滚动浮现 -->
    <div class="mag-side-content left-content" style="position: absolute; left: 8%; top: 35%; max-width: 300px; opacity: 0; transform: translateY(30px); z-index: 3;">
      <h3 style="font-size: 1.8rem; font-weight: 800; color: #333; margin: 0 0 10px 0;">{{ section.settings.left_heading }}</h3>
      <p style="font-size: 1rem; color: #666; line-height: 1.5; margin: 0;">{{ section.settings.left_text }}</p>
    </div>

    <!-- 右侧文案随滚动浮现 -->
    <div class="mag-side-content right-content" style="position: absolute; right: 8%; top: 45%; max-width: 300px; opacity: 0; transform: translateY(30px); z-index: 3;">
      <h3 style="font-size: 1.8rem; font-weight: 800; color: #333; margin: 0 0 10px 0;">{{ section.settings.right_heading }}</h3>
      <p style="font-size: 1rem; color: #666; line-height: 1.5; margin: 0;">{{ section.settings.right_text }}</p>
    </div>

    <!-- 中心核心产品图片 -->
    <div id="product-container" style="z-index: 2; display: flex; justify-content: center; align-items: center;">
      {% if section.settings.product_image != blank %}
        <img id="main-product-img" src="{{ section.settings.product_image | image_url: width: 1200 }}" alt="Product" style="width: 380px; max-width: 45vw; height: auto; transform-origin: center; will-change: transform;">
      {% else %}
        <img id="main-product-img" src="https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-image_large.png" alt="Placeholder" style="width: 380px; max-width: 45vw; height: auto;">
      {% endif %}
    </div>

  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

<script>
  document.addEventListener("DOMContentLoaded", (event) => {
    gsap.registerPlugin(ScrollTrigger);

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: "#magazine-scroll-section",
        start: "top top",
        end: "bottom bottom",
        scrub: 1.2,
        pin: true,
        anticipatePin: 1
      }
    });

    tl.to("#main-product-img", { scale: 0.65, ease: "power1.inOut", duration: 1 })
      .to(".text-phase-1", { x: "-25%", ease: "none", duration: 1 }, 0)
      .to(".left-content", { opacity: 1, y: 0, duration: 0.6 }, 0.3)
      .to(".right-content", { opacity: 1, y: 0, duration: 0.6 }, 0.5)
      .to(".text-phase-1", { opacity: 0, duration: 0.4 }, 0.7)
      .to(".text-phase-2", { opacity: 1, duration: 0.4 }, 0.7)
      .to(".text-phase-2", { x: "15%", ease: "none", duration: 0.6 }, 0.7);
  });
</script>

{% schema %}
{
  "name": "Magazine Scroll",
  "settings": [
    { "type": "image_picker", "id": "product_image", "label": "核心产品图片" },
    { "type": "text", "id": "left_heading", "label": "左侧标题", "default": "GLACIER BLUE" },
    { "type": "textarea", "id": "left_text", "label": "左侧描述", "default": "沉浸式色彩体验。" },
    { "type": "text", "id": "right_heading", "label": "右侧标题", "default": "SMART TOUCH" },
    { "type": "textarea", "id": "right_text", "label": "右侧描述", "default": "精巧交互设计。" }
  ],
  "presets": [
    { "name": "Magazine Scroll" }
  ]
}
{% endschema %}