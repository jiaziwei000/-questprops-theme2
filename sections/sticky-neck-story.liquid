<section
  id="qp-product-story-{{ section.id }}"
  class="qp-product-story"
>
  <div class="qp-product-story__scroll">

    <div class="qp-product-story__stage">

      <!-- BRAND -->

      <div class="qp-product-story__brand">
        {{ section.settings.brand }}
      </div>

      <div class="qp-product-story__index">
        {{ section.settings.index }}
      </div>


      <!-- BACKGROUND TYPOGRAPHY -->

      <div class="qp-product-story__type">

        <span>
          {{ section.settings.heading_line_1 }}
        </span>

        <span>
          {{ section.settings.heading_line_2 }}
        </span>

      </div>


      <!-- PRODUCT -->

      <div class="qp-product-story__product">

        {% if section.settings.product_image != blank %}

          {{
            section.settings.product_image
            | image_url: width: 2400
            | image_tag:
              loading: 'eager',
              widths: '800,1200,1600,2000,2400',
              class: 'qp-product-story__product-image'
          }}

        {% endif %}


        <!-- PACKAGE -->

        {% if section.settings.package_image != blank %}

          <div class="qp-product-story__package">

            {{
              section.settings.package_image
              | image_url: width: 1400
              | image_tag:
                loading: 'lazy',
                widths: '500,800,1100,1400',
                class: 'qp-product-story__package-image'
            }}

          </div>

        {% endif %}

      </div>


      <!-- PRODUCT DETAILS -->

      <div class="qp-product-story__details">

        <span>EMS</span>

        <span>HEAT</span>

        <span>10 MIN / DAY</span>

      </div>


      <!-- FINAL LOCKUP -->

      <div class="qp-product-story__lockup">

        <div class="qp-product-story__eyebrow">
          QUESTPROPS™ NECK RESTORE
        </div>

        <h2>
          {{ section.settings.final_heading }}
        </h2>

        {% if section.settings.final_text != blank %}

          <p>
            {{ section.settings.final_text }}
          </p>

        {% endif %}

        <a
          href="{{ section.settings.button_link }}"
          class="qp-product-story__button"
        >
          {{ section.settings.button_text }}
          <span>→</span>
        </a>

      </div>

    </div>

  </div>
</section>


<style>

/* =====================================================
   ROOT
===================================================== */

#qp-product-story-{{ section.id }} {

  --qp-bg: {{ section.settings.background }};

  --qp-text: {{ section.settings.text_color }};

  position: relative;

  width: 100%;

  background: var(--qp-bg);

  color: var(--qp-text);

  overflow: clip;

}


/* =====================================================
   SCROLL AREA
===================================================== */

#qp-product-story-{{ section.id }}
.qp-product-story__scroll {

  position: relative;

  height: 500vh;

}


/* =====================================================
   STICKY STAGE
===================================================== */

#qp-product-story-{{ section.id }}
.qp-product-story__stage {

  position: sticky;

  top: 0;

  width: 100%;

  height: 100vh;

  height: 100svh;

  overflow: hidden;

  isolation: isolate;

}


/* =====================================================
   BRAND
===================================================== */

#qp-product-story-{{ section.id }}
.qp-product-story__brand {

  position: absolute;

  top: 26px;

  left: 28px;

  z-index: 50;

  font-size: 10px;

  font-weight: 700;

  letter-spacing: .18em;

}


/* =====================================================
   INDEX
===================================================== */

#qp-product-story-{{ section.id }}
.qp-product-story__index {

  position: absolute;

  top: 26px;

  right: 28px;

  z-index: 50;

  font-size: 10px;

  letter-spacing: .16em;

}


/* =====================================================
   BACKGROUND TYPE

   NEVER MOVES
===================================================== */

#qp-product-story-{{ section.id }}
.qp-product-story__type {

  position: absolute;

  top: 20vh;

  left: -3vw;

  z-index: 1;

  display: flex;

  flex-direction: column;

  font-size: clamp(
    90px,
    14vw,
    230px
  );

  line-height: .78;

  font-weight: 800;

  letter-spacing: -.085em;

  text-transform: uppercase;

  white-space: nowrap;

  pointer-events: none;

}


#qp-product-story-{{ section.id }}
.qp-product-story__type span:nth-child(2) {

  margin-left: 12vw;

}


/* =====================================================
   PRODUCT
===================================================== */

#qp-product-story-{{ section.id }}
.qp-product-story__product {

  position: absolute;

  top: 50%;

  left: 50%;

  z-index: 20;

  width: min(
    52vw,
    720px
  );

  transform:

    translate(
      -50%,
      calc(-50% + 70vh)
    )

    scale(.72);

  will-change: transform;

}


/* =====================================================
   PRODUCT IMAGE
===================================================== */

#qp-product-story-{{ section.id }}
.qp-product-story__product-image {

  display: block;

  width: 100%;

  height: auto;

  object-fit: contain;

  filter:

    drop-shadow(
      0 28px 35px
      rgba(0,0,0,.12)
    );

}


/* =====================================================
   PACKAGE
===================================================== */

#qp-product-story-{{ section.id }}
.qp-product-story__package {

  position: absolute;

  right: -4%;

  bottom: -4%;

  width: 30%;

  opacity: 0;

  transform:

    translate(
      35px,
      40px
    )

    rotate(5deg)

    scale(.75);

  will-change:
    opacity,
    transform;

}


#qp-product-story-{{ section.id }}
.qp-product-story__package-image {

  display: block;

  width: 100%;

  height: auto;

  filter:

    drop-shadow(
      0 18px 26px
      rgba(0,0,0,.12)
    );

}


/* =====================================================
   DETAILS
===================================================== */

#qp-product-story-{{ section.id }}
.qp-product-story__details {

  position: absolute;

  left: 50%;

  bottom: 42px;

  z-index: 25;

  display: flex;

  gap: 24px;

  transform:
    translateX(-50%);

  font-size: 9px;

  font-weight: 700;

  letter-spacing: .16em;

  opacity: 0;

}


#qp-product-story-{{ section.id }}
.qp-product-story__details span {

  white-space: nowrap;

}


/* =====================================================
   FINAL LOCKUP
===================================================== */

#qp-product-story-{{ section.id }}
.qp-product-story__lockup {

  position: absolute;

  left: 50%;

  bottom: 9vh;

  z-index: 40;

  width: min(
    520px,
    90vw
  );

  text-align: center;

  opacity: 0;

  transform:

    translate(
      -50%,
      25px
    );

  pointer-events: none;

}


#qp-product-story-{{ section.id }}
.qp-product-story__eyebrow {

  margin-bottom: 18px;

  font-size: 9px;

  font-weight: 700;

  letter-spacing: .2em;

}


#qp-product-story-{{ section.id }}
.qp-product-story__lockup h2 {

  margin: 0;

  font-size: clamp(
    42px,
    5vw,
    78px
  );

  line-height: .86;

  letter-spacing: -.065em;

}


#qp-product-story-{{ section.id }}
.qp-product-story__lockup p {

  max-width: 360px;

  margin: 20px auto;

  font-size: 14px;

  line-height: 1.5;

}


/* =====================================================
   BUTTON
===================================================== */

#qp-product-story-{{ section.id }}
.qp-product-story__button {

  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 20px;

  min-width: 220px;

  padding: 17px 28px;

  background: var(--qp-text);

  color: var(--qp-bg);

  text-decoration: none;

  font-size: 10px;

  font-weight: 700;

  letter-spacing: .15em;

  pointer-events: auto;

  transition:
    opacity .2s ease,
    transform .2s ease;

}


#qp-product-story-{{ section.id }}
.qp-product-story__button:hover {

  opacity: .85;

  transform:
    translateY(-2px);

}


/* =====================================================
   MOBILE
===================================================== */

@media screen and (max-width: 749px) {

  #qp-product-story-{{ section.id }}
  .qp-product-story__scroll {

    height: 460vh;

  }


  #qp-product-story-{{ section.id }}
  .qp-product-story__brand {

    top: 20px;

    left: 18px;

    font-size: 8px;

  }


  #qp-product-story-{{ section.id }}
  .qp-product-story__index {

    top: 20px;

    right: 18px;

    font-size: 8px;

  }


  #qp-product-story-{{ section.id }}
  .qp-product-story__type {

    top: 24vh;

    left: -9vw;

    font-size: 19vw;

  }


  #qp-product-story-{{ section.id }}
  .qp-product-story__type span:nth-child(2) {

    margin-left: 16vw;

  }


  #qp-product-story-{{ section.id }}
  .qp-product-story__product {

    width: 88vw;

  }


  #qp-product-story-{{ section.id }}
  .qp-product-story__package {

    width: 36%;

  }


  #qp-product-story-{{ section.id }}
  .qp-product-story__details {

    bottom: 22px;

    gap: 12px;

    font-size: 7px;

  }


  #qp-product-story-{{ section.id }}
  .qp-product-story__lockup {

    bottom: 8vh;

  }


  #qp-product-story-{{ section.id }}
  .qp-product-story__lockup h2 {

    font-size: 13vw;

  }

}

</style>


<script>

(function() {

  const root =
    document.getElementById(
      'qp-product-story-{{ section.id }}'
    );

  if (!root) return;


  const scroll =
    root.querySelector(
      '.qp-product-story__scroll'
    );


  const product =
    root.querySelector(
      '.qp-product-story__product'
    );


  const packageEl =
    root.querySelector(
      '.qp-product-story__package'
    );


  const details =
    root.querySelector(
      '.qp-product-story__details'
    );


  const lockup =
    root.querySelector(
      '.qp-product-story__lockup'
    );


  function clamp(
    value,
    min,
    max
  ) {

    return Math.max(
      min,
      Math.min(
        max,
        value
      )
    );

  }


  function smoothstep(t) {

    return t * t * (3 - 2 * t);

  }


  function update() {

    const rect =
      scroll.getBoundingClientRect();


    const total =
      scroll.offsetHeight -
      window.innerHeight;


    if (total <= 0) return;


    let progress =
      -rect.top / total;


    progress =
      clamp(
        progress,
        0,
        1
      );


    /* ==================================
       PRODUCT MOVEMENT
    ================================== */

    let y;

    let x;

    let scale;


    if (progress < .25) {

      const p =
        smoothstep(
          progress / .25
        );


      y =
        70 -
        (70 * p);


      x = 0;


      scale =
        .72 +
        (.20 * p);

    }


    else if (progress < .60) {

      const p =
        smoothstep(
          (progress - .25) / .35
        );


      y = 0;


      x =
        -1.5 * p;


      scale =
        .92 +
        (.08 * p);

    }


    else if (progress < .78) {

      const p =
        smoothstep(
          (progress - .60) / .18
        );


      x =
        -1.5 +
        (3 * p);


      y =
        -1 * p;


      scale =
        1 +
        (.16 * p);

    }


    else {

      const p =
        smoothstep(
          (progress - .78) / .12
        );


      x =
        1.5 -
        (1.5 * p);


      y = -1;


      scale =
        1.16 +
        (.03 * p);

    }


    product.style.transform =

      `translate(
        calc(-50% + ${x}vw),
        calc(-50% + ${y}vh)
      )
      scale(${scale})`;


    /* ==================================
       DETAILS
    ================================== */

    const detailProgress =
      clamp(
        (progress - .58) / .12,
        0,
        1
      );


    details.style.opacity =
      smoothstep(
        detailProgress
      );


    /* ==================================
       PACKAGE
    ================================== */

    if (packageEl) {

      const packageProgress =
        clamp(
          (progress - .70) / .14,
          0,
          1
        );


      const p =
        smoothstep(
          packageProgress
        );


      packageEl.style.opacity =
        p;


      packageEl.style.transform =

        `translate(
          ${35 - (35 * p)}px,
          ${40 - (40 * p)}px
        )
        rotate(
          ${5 - (5 * p)}deg
        )
        scale(
          ${.75 + (.25 * p)}
        )`;

    }


    /* ==================================
       FINAL LOCKUP
    ================================== */

    const finalProgress =
      clamp(
        (progress - .88) / .10,
        0,
        1
      );


    const finalEase =
      smoothstep(
        finalProgress
      );


    lockup.style.opacity =
      finalEase;


    lockup.style.transform =

      `translate(
        -50%,
        ${25 - (25 * finalEase)}px
      )`;

  }


  let ticking = false;


  function requestUpdate() {

    if (ticking) return;


    ticking = true;


    requestAnimationFrame(
      function() {

        update();

        ticking = false;

      }
    );

  }


  window.addEventListener(
    'scroll',
    requestUpdate,
    {
      passive: true
    }
  );


  window.addEventListener(
    'resize',
    requestUpdate
  );


  update();

})();

</script>


{% schema %}

{
  "name": "QP Product Story",

  "settings": [

    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product image"
    },

    {
      "type": "image_picker",
      "id": "package_image",
      "label": "Packaging image"
    },

    {
      "type": "text",
      "id": "brand",
      "label": "Brand",
      "default": "QUESTPROPS™"
    },

    {
      "type": "text",
      "id": "index",
      "label": "Index",
      "default": "01"
    },

    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "NECK"
    },

    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2",
      "default": "RESTORE"
    },

    {
      "type": "text",
      "id": "final_heading",
      "label": "Final heading",
      "default": "A SIMPLE RESET FOR YOUR DAY."
    },

    {
      "type": "textarea",
      "id": "final_text",
      "label": "Final text",
      "default": "EMS stimulation and soothing heat, built into a simple 10-minute routine."
    },

    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SHOP NECK RESTORE"
    },

    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },

    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#F2F0EB"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#171717"
    }

  ],

  "presets": [
    {
      "name": "QP Product Story"
    }
  ]

}

{% endschema %}