<!-- 1. HTML 与 Liquid 逻辑 -->
<div class="my-custom-section">
  <div class="page-width">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.content }}</p>
    
    {% if section.settings.show_button %}
      <a href="{{ section.settings.button_link }}" class="button">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</div>

<!-- 2. CSS 样式 -->
{% style %}
  .my-custom-section {
    padding: {{ section.settings.padding_top }}px 0;
    background-color: {{ section.settings.bg_color }};
  }
{% endstyle %}

<!-- 3. JavaScript (可选) -->
<script>
  console.log("Custom section loaded");
</script>

<!-- 4. Schema 设置 (定义后台编辑面板) -->
{% schema %}
{
  "name": "我的自定义区块",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "欢迎光临"
    },
    {
      "type": "textarea",
      "id": "content",
      "label": "内容",
      "default": "这是一段自定义描述。"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "背景颜色",
      "default": "#f4f4f4"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "顶部内边距",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "我的自定义区块"
    }
  ]
}
{% endschema %}