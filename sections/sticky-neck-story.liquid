<div class="magazine-wrapper">
  <!-- 左侧滚动文案区 -->
  <div class="scroll-column left-side">
    <div class="text-block">
      <h2 class="mag-title">{{ section.settings.left_title_1 }}</h2>
      <p>{{ section.settings.left_text_1 }}</p>
    </div>
    <div class="text-block">
      <h2 class="mag-title">{{ section.settings.left_title_2 }}</h2>
      <p>{{ section.settings.left_text_2 }}</p>
    </div>
  </div>

  <!-- 中间吸附的按摩仪图片 -->
  <div class="sticky-column">
    <div class="sticky-box">
      {% if section.settings.product_image != blank %}
        <img src="{{ section.settings.product_image | image_url: width: 800 }}" alt="Product Image" style="display:block; width:100%; height:auto;">
      {% else %}
        <img src="https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-image_large.png" alt="Placeholder">
      {% endif %}
    </div>
  </div>

  <!-- 右侧滚动文案区 -->
  <div class="scroll-column right-side">
    <div class="text-block">
      <h2 class="mag-title">{{ section.settings.right_title_1 }}</h2>
      <p>{{ section.settings.right_text_1 }}</p>
    </div>
    <div class="text-block">
      <h2 class="mag-title">{{ section.settings.right_title_2 }}</h2>
      <p>{{ section.settings.right_text_2 }}</p>
    </div>
  </div>
</div>

<style>
  .magazine-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: flex-start; /* 必须对齐顶部 */
    max-width: 1400px;
    margin: 0 auto;
    padding: 100px 20px;
    background-color: #f7f3ed;
  }

  .scroll-column {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 500px; /* 增加间距让图片有更长的吸附滚动时间 */
    padding-bottom: 200px;
  }

  .text-block { max-width: 350px; }
  .left-side { align-items: flex-end; text-align: right; }
  .right-side { align-items: flex-start; text-align: left; }

  .mag-title {
    font-size: 3.5rem;
    font-weight: 900;
    line-height: 1.1;
    color: #b3222a;
    text-transform: uppercase;
    margin: 0 0 15px 0;
  }

  /* 核心修复：确保 sticky-column 撑得够大 */
  .sticky-column {
    flex: 1.2;
    position: relative;
    height: 1200px; /* 给一个固定大高度，或者设为 auto */
  }

  .sticky-box {
    position: sticky;
    position: -webkit-sticky; /* 兼容 Safari */
    top: 15vh;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  @media screen and (max-width: 768px) {
    .magazine-wrapper { flex-direction: column; }
    .sticky-column { height: auto; }
    .sticky-box { position: relative; top: 0; }
  }
</style>

{% schema %}
{
  "name": "Magazine Sticky Product",
  "settings": [
    { "type": "image_picker", "id": "product_image", "label": "中间产品图片" },
    { "type": "text", "id": "left_title_1", "label": "左标题1", "default": "GLACIER BLUE" },
    { "type": "textarea", "id": "left_text_1", "label": "左描述1", "default": "采用冰川湖泊蓝美学设计。" },
    { "type": "text", "id": "left_title_2", "label": "左标题2", "default": "SOFT TOUCH" },
    { "type": "textarea", "id": "left_text_2", "label": "左描述2", "default": "婴儿肌亲肤硅胶材质。" },
    { "type": "text", "id": "right_title_1", "label": "右标题1", "default": "SMART KNOB" },
    { "type": "textarea", "id": "right_text_1", "label": "右描述1", "default": "橘色智能数显旋钮。" },
    { "type": "text", "id": "right_title_2", "label": "右标题2", "default": "RELAXATION" },
    { "type": "textarea", "id": "right_text_2", "label": "右描述2", "default": "深层放松释放压力。" }
  ],
  "presets": [{ "name": "Magazine Sticky Product" }]
}
{% endschema %}