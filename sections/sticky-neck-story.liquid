{% comment %}
  QUESTPROPS™ Scroll Story
  Shopify OS 2.0 Section
  Scroll-driven product storytelling
{% endcomment %}

<section
  id="QPScrollStory-{{ section.id }}"
  class="qp-story"
>

  <!-- =====================================================
       SCENE 01
       ===================================================== -->

  <div
    class="qp-scene qp-scene-01"
    data-scene="01"
  >

    <div class="qp-sticky">

      {% if section.settings.scene_1_bg != blank %}
        <div
          class="qp-background-text qp-bg-01"
          aria-hidden="true"
        >
          {{ section.settings.scene_1_bg }}
        </div>
      {% endif %}


      <div class="qp-eyebrow qp-eyebrow-01">
        {{ section.settings.scene_1_eyebrow }}
      </div>


      <div class="qp-product qp-product-01">

        {% if section.settings.scene_1_image != blank %}

          {{
            section.settings.scene_1_image
            | image_url: width: 1800
            | image_tag:
              widths: '400,600,800,1200,1600,1800',
              sizes: '80vw',
              loading: 'lazy',
              class: 'qp-product-img'
          }}

        {% endif %}

      </div>


      <div class="qp-main-copy qp-copy-01">

        {% if section.settings.scene_1_heading != blank %}

          <h2>
            {{ section.settings.scene_1_heading }}
          </h2>

        {% endif %}


        {% if section.settings.scene_1_text != blank %}

          <div class="qp-copy-text">
            {{ section.settings.scene_1_text }}
          </div>

        {% endif %}

      </div>


      <div class="qp-cards qp-cards-01">

        {% for block in section.blocks %}

          {% if block.type == 'scene1_card' %}

            <div
              class="qp-card"
              {{ block.shopify_attributes }}
            >

              {% if block.settings.title != blank %}

                <strong>
                  {{ block.settings.title }}
                </strong>

              {% endif %}

              {% if block.settings.text != blank %}

                <span>
                  {{ block.settings.text }}
                </span>

              {% endif %}

            </div>

          {% endif %}

        {% endfor %}

      </div>

    </div>

  </div>



  <!-- =====================================================
       SCENE 02
       ===================================================== -->

  <div
    class="qp-scene qp-scene-02"
    data-scene="02"
  >

    <div class="qp-sticky">

      {% if section.settings.scene_2_bg != blank %}

        <div
          class="qp-background-text qp-bg-02"
          aria-hidden="true"
        >
          {{ section.settings.scene_2_bg }}
        </div>

      {% endif %}


      <div class="qp-eyebrow qp-eyebrow-02">

        {{ section.settings.scene_2_eyebrow }}

      </div>


      <div class="qp-product qp-product-02">

        {% if section.settings.scene_2_image != blank %}

          {{
            section.settings.scene_2_image
            | image_url: width: 1800
            | image_tag:
              widths: '400,600,800,1200,1600,1800',
              sizes: '80vw',
              loading: 'lazy',
              class: 'qp-product-img'
          }}

        {% endif %}

      </div>


      <div class="qp-tags">

        {% for block in section.blocks %}

          {% if block.type == 'scene2_tag' %}

            <div
              class="qp-tag"
              {{ block.shopify_attributes }}
            >

              {{ block.settings.text }}

            </div>

          {% endif %}

        {% endfor %}

      </div>


      <div class="qp-features">

        {% for block in section.blocks %}

          {% if block.type == 'scene2_feature' %}

            <div
              class="qp-feature"
              {{ block.shopify_attributes }}
            >

              {% if block.settings.number != blank %}

                <small>
                  {{ block.settings.number }}
                </small>

              {% endif %}


              {% if block.settings.title != blank %}

                <h3>
                  {{ block.settings.title }}
                </h3>

              {% endif %}


              {% if block.settings.text != blank %}

                <div class="qp-feature-text">
                  {{ block.settings.text }}
                </div>

              {% endif %}

            </div>

          {% endif %}

        {% endfor %}

      </div>

    </div>

  </div>



  <!-- =====================================================
       SCENE 03
       ===================================================== -->

  <div
    class="qp-scene qp-scene-03"
    data-scene="03"
  >

    <div class="qp-sticky">

      {% if section.settings.scene_3_number != blank %}

        <div
          class="qp-big-number"
          aria-hidden="true"
        >
          {{ section.settings.scene_3_number }}
        </div>

      {% endif %}


      {% if section.settings.scene_3_label != blank %}

        <div class="qp-number-label">
          {{ section.settings.scene_3_label }}
        </div>

      {% endif %}


      <div class="qp-product qp-product-03">

        {% if section.settings.scene_3_image != blank %}

          {{
            section.settings.scene_3_image
            | image_url: width: 1800
            | image_tag:
              widths: '400,600,800,1200,1600,1800',
              sizes: '80vw',
              loading: 'lazy',
              class: 'qp-product-img'
          }}

        {% endif %}

      </div>


      <div class="qp-final-copy">

        {% if section.settings.scene_3_heading != blank %}

          <h2>
            {{ section.settings.scene_3_heading }}
          </h2>

        {% endif %}


        {% if section.settings.scene_3_text != blank %}

          <div>
            {{ section.settings.scene_3_text }}
          </div>

        {% endif %}

      </div>

    </div>

  </div>



  <!-- =====================================================
       FINAL CTA
       ===================================================== -->

  <div class="qp-final-cta">

    <div class="qp-final-inner">

      {% if section.settings.cta_eyebrow != blank %}

        <span>
          {{ section.settings.cta_eyebrow }}
        </span>

      {% endif %}


      {% if section.settings.cta_heading != blank %}

        <h2>
          {{ section.settings.cta_heading }}
        </h2>

      {% endif %}


      {% if section.settings.cta_text != blank %}

        <div class="qp-cta-text">
          {{ section.settings.cta_text }}
        </div>

      {% endif %}


      {% if section.settings.cta_button_text != blank %}

        <a
          class="qp-cta-button"
          href="{{ section.settings.cta_button_url }}"
        >
          {{ section.settings.cta_button_text }}
        </a>

      {% endif %}

    </div>

  </div>

</section>



<style>

/* =========================================================
   ROOT
   ========================================================= */

#QPScrollStory-{{ section.id }} {

  --qp-bg: {{ section.settings.background_color }};
  --qp-text: {{ section.settings.text_color }};
  --qp-muted: {{ section.settings.muted_color }};
  --qp-accent: {{ section.settings.accent_color }};

  background: var(--qp-bg);
  color: var(--qp-text);

  width: 100%;

  overflow: clip;

  position: relative;

}


/* =========================================================
   SCENES
   ========================================================= */

#QPScrollStory-{{ section.id }} .qp-scene {

  position: relative;

  width: 100%;

}


#QPScrollStory-{{ section.id }} .qp-scene-01 {
  height: 160vh;
}


#QPScrollStory-{{ section.id }} .qp-scene-02 {
  height: 220vh;
}


#QPScrollStory-{{ section.id }} .qp-scene-03 {
  height: 170vh;

}


/* =========================================================
   STICKY
   ========================================================= */

#QPScrollStory-{{ section.id }} .qp-sticky {

  position: sticky;

  top: 0;

  height: 100vh;
  height: 100svh;

  width: 100%;

  overflow: hidden;

}


/* =========================================================
   BACKGROUND TEXT
   ========================================================= */

#QPScrollStory-{{ section.id }} .qp-background-text {

  position: absolute;

  z-index: 1;

  top: 50%;

  left: 0;

  white-space: nowrap;

  font-size: clamp(
    110px,
    17vw,
    300px
  );

  line-height: .75;

  font-weight: 900;

  letter-spacing: -.09em;

  color: rgba(23,23,23,.055);

  pointer-events: none;

  user-select: none;

  will-change: transform, opacity;

}


/* =========================================================
   EYEBROW
   ========================================================= */

#QPScrollStory-{{ section.id }} .qp-eyebrow {

  position: absolute;

  z-index: 20;

  top: 8vh;

  left: 7vw;

  font-size: 10px;

  line-height: 1;

  letter-spacing: .28em;

  text-transform: uppercase;

  color: var(--qp-muted);

}


/* =========================================================
   PRODUCT
   ========================================================= */

#QPScrollStory-{{ section.id }} .qp-product {

  position: absolute;

  left: 50%;

  top: 50%;

  z-index: 5;

  transform:
    translate(-50%,-50%);

  will-change:
    transform,
    opacity;

}


#QPScrollStory-{{ section.id }} .qp-product-01 {

  width: min(
    58vw,
    760px
  );

}


#QPScrollStory-{{ section.id }} .qp-product-02 {

  width: min(
    55vw,
    720px
  );

  opacity: 0;

}


#QPScrollStory-{{ section.id }} .qp-product-03 {

  width: min(
    46vw,
    600px
  );

}


#QPScrollStory-{{ section.id }} .qp-product-img {

  display: block;

  width: 100%;

  height: auto;

  object-fit: contain;

}


/* =========================================================
   SCENE 01 COPY
   ========================================================= */

#QPScrollStory-{{ section.id }} .qp-main-copy {

  position: absolute;

  left: 7vw;

  bottom: 9vh;

  z-index: 20;

  max-width: 410px;

  opacity: 0;

  will-change:
    transform,
    opacity;

}


#QPScrollStory-{{ section.id }} .qp-main-copy h2 {

  margin: 0 0 16px;

  font-size: clamp(
    42px,
    5vw,
    76px
  );

  line-height: .9;

  letter-spacing: -.065em;

}


#QPScrollStory-{{ section.id }} .qp-copy-text {

  max-width: 340px;

  font-size: 15px;

  line-height: 1.5;

  color: var(--qp-muted);

}


/* =========================================================
   SCENE 01 CARDS
   ========================================================= */

#QPScrollStory-{{ section.id }} .qp-card {

  position: absolute;

  z-index: 20;

  bottom: 12vh;

  width: 210px;

  opacity: 0;

  will-change:
    transform,
    opacity;

}


#QPScrollStory-{{ section.id }} .qp-card:nth-child(odd) {

  left: 6vw;

}


#QPScrollStory-{{ section.id }} .qp-card:nth-child(even) {

  right: 6vw;

}


#QPScrollStory-{{ section.id }} .qp-card strong {

  display: block;

  font-size: 10px;

  line-height: 1.2;

  letter-spacing: .18em;

}


#QPScrollStory-{{ section.id }} .qp-card span {

  display: block;

  margin-top: 8px;

  font-size: 13px;

  line-height: 1.45;

  color: var(--qp-muted);

}


/* =========================================================
   SCENE 02 TAGS
   ========================================================= */

#QPScrollStory-{{ section.id }} .qp-tags {

  position: absolute;

  inset: 0;

  z-index: 20;

  pointer-events: none;

}


#QPScrollStory-{{ section.id }} .qp-tag {

  position: absolute;

  padding: 10px 17px;

  border-radius: 999px;

  background: var(--qp-accent);

  color: #171717;

  font-size: 10px;

  font-weight: 800;

  line-height: 1;

  letter-spacing: .14em;

  text-transform: uppercase;

  opacity: 0;

  will-change:
    transform,
    opacity;

}


#QPScrollStory-{{ section.id }} .qp-tag:nth-child(1) {

  left: 12%;

  top: 34%;

}


#QPScrollStory-{{ section.id }} .qp-tag:nth-child(2) {

  right: 12%;

  top: 59%;

}


#QPScrollStory-{{ section.id }} .qp-tag:nth-child(3) {

  left: 18%;

  top: 65%;

}


#QPScrollStory-{{ section.id }} .qp-tag:nth-child(4) {

  right: 18%;

  top: 30%;

}


/* =========================================================
   FEATURES
   ========================================================= */

#QPScrollStory-{{ section.id }} .qp-features {

  position: absolute;

  z-index: 30;

  right: 7vw;

  top: 50%;

  width: min(
    32vw,
    430px
  );

  min-height: 230px;

  transform:
    translate(100px,-50%);

  opacity: 0;

  will-change:
    transform,
    opacity;

}


#QPScrollStory-{{ section.id }} .qp-feature {

  position: absolute;

  left: 0;

  top: 0;

  width: 100%;

  opacity: 0;

  transform:
    translateY(30px);

  will-change:
    transform,
    opacity;

}


#QPScrollStory-{{ section.id }} .qp-feature small {

  display: block;

  margin-bottom: 12px;

  font-size: 10px;

  letter-spacing: .2em;

  color: var(--qp-muted);

}


#QPScrollStory-{{ section.id }} .qp-feature h3 {

  margin: 0 0 14px;

  font-size: clamp(
    30px,
    4vw,
    56px
  );

  line-height: .95;

  letter-spacing: -.055em;

}


#QPScrollStory-{{ section.id }} .qp-feature-text {

  max-width: 330px;

  font-size: 14px;

  line-height: 1.5;

  color: var(--qp-muted);

}


/* =========================================================
   SCENE 03
   ========================================================= */

#QPScrollStory-{{ section.id }} .qp-big-number {

  position: absolute;

  z-index: 1;

  left: 50%;

  top: 45%;

  transform:
    translate(-50%,-50%);

  font-size: clamp(
    180px,
    32vw,
    520px
  );

  font-weight: 900;

  line-height: .7;

  letter-spacing: -.1em;

  color: rgba(23,23,23,.055);

  will-change: transform;

}


#QPScrollStory-{{ section.id }} .qp-number-label {

  position: absolute;

  z-index: 20;

  top: 25%;

  left: 50%;

  transform:
    translateX(-50%);

  font-size: 10px;

  letter-spacing: .28em;

  text-transform: uppercase;

  color: var(--qp-muted);

}


#QPScrollStory-{{ section.id }} .qp-final-copy {

  position: absolute;

  z-index: 20;

  left: 50%;

  bottom: 9vh;

  width: 90%;

  text-align: center;

  transform:
    translateX(-50%);

  opacity: 0;

  will-change:
    transform,
    opacity;

}


#QPScrollStory-{{ section.id }} .qp-final-copy h2 {

  margin: 0;

  font-size: clamp(
    34px,
    4vw,
    62px
  );

  line-height: .95;

  letter-spacing: -.06em;

}


#QPScrollStory-{{ section.id }} .qp-final-copy div {

  margin-top: 15px;

  color: var(--qp-muted);

  font-size: 14px;

}


/* =========================================================
   FINAL CTA
   ========================================================= */

#QPScrollStory-{{ section.id }} .qp-final-cta {

  min-height: 70vh;

  display: flex;

  align-items: center;

  justify-content: center;

  padding: 80px 20px;

  text-align: center;

}


#QPScrollStory-{{ section.id }} .qp-final-inner {

  max-width: 850px;

}


#QPScrollStory-{{ section.id }} .qp-final-inner > span {

  font-size: 10px;

  letter-spacing: .28em;

  text-transform: uppercase;

  color: var(--qp-muted);

}


#QPScrollStory-{{ section.id }} .qp-final-inner h2 {

  margin: 20px 0 35px;

  font-size: clamp(
    48px,
    7vw,
    96px
  );

  line-height: .86;

  letter-spacing: -.065em;

}


#QPScrollStory-{{ section.id }} .qp-cta-text {

  margin: 0 auto 30px;

  max-width: 500px;

  color: var(--qp-muted);

}


#QPScrollStory-{{ section.id }} .qp-cta-button {

  display: inline-flex;

  align-items: center;

  justify-content: center;

  min-height: 52px;

  padding: 0 30px;

  background: var(--qp-text);

  color: var(--qp-bg);

  text-decoration: none;

  font-size: 11px;

  font-weight: 700;

  letter-spacing: .15em;

  text-transform: uppercase;

  transition:
    transform .25s ease,
    opacity .25s ease;

}


#QPScrollStory-{{ section.id }} .qp-cta-button:hover {

  transform: translateY(-2px);

  opacity: .85;

}


/* =========================================================
   MOBILE
   ========================================================= */

@media screen and (max-width: 749px) {


  #QPScrollStory-{{ section.id }} .qp-scene-01 {

    height: 175vh;

  }


  #QPScrollStory-{{ section.id }} .qp-scene-02 {

    height: 230vh;

  }


  #QPScrollStory-{{ section.id }} .qp-scene-03 {

    height: 180vh;

  }


  /* -----------------------------------------
     BACKGROUND
     ----------------------------------------- */

  #QPScrollStory-{{ section.id }} .qp-background-text {

    top: 43%;

    font-size: 25vw;

  }


  /* -----------------------------------------
     EYEBROW
     ----------------------------------------- */

  #QPScrollStory-{{ section.id }} .qp-eyebrow {

    top: 6vh;

    left: 20px;

    font-size: 8px;

    letter-spacing: .22em;

  }


  /* -----------------------------------------
     PRODUCT
     ----------------------------------------- */

  #QPScrollStory-{{ section.id }} .qp-product-01 {

    width: 88vw;

    top: 43%;

  }


  #QPScrollStory-{{ section.id }} .qp-product-02 {

    width: 88vw;

    top: 41%;

  }


  #QPScrollStory-{{ section.id }} .qp-product-03 {

    width: 82vw;

    top: 43%;

  }


  /* -----------------------------------------
     SCENE 01 COPY
     ----------------------------------------- */

  #QPScrollStory-{{ section.id }} .qp-main-copy {

    left: 20px;

    right: 20px;

    bottom: 7vh;

    max-width: none;

  }


  #QPScrollStory-{{ section.id }} .qp-main-copy h2 {

    font-size: 44px;

  }


  #QPScrollStory-{{ section.id }} .qp-copy-text {

    font-size: 13px;

    max-width: 300px;

  }


  /* -----------------------------------------
     CARDS
     ----------------------------------------- */

  #QPScrollStory-{{ section.id }} .qp-card {

    bottom: 22vh;

    width: 125px;

  }


  #QPScrollStory-{{ section.id }} .qp-card:nth-child(odd) {

    left: 20px;

  }


  #QPScrollStory-{{ section.id }} .qp-card:nth-child(even) {

    right: 20px;

  }


  #QPScrollStory-{{ section.id }} .qp-card strong {

    font-size: 8px;

  }


  #QPScrollStory-{{ section.id }} .qp-card span {

    font-size: 11px;

  }


  /* -----------------------------------------
     TAGS
     ----------------------------------------- */

  #QPScrollStory-{{ section.id }} .qp-tag {

    padding: 8px 13px;

    font-size: 8px;

  }


  #QPScrollStory-{{ section.id }} .qp-tag:nth-child(1) {

    left: 7%;

    top: 29%;

  }


  #QPScrollStory-{{ section.id }} .qp-tag:nth-child(2) {

    right: 7%;

    top: 57%;

  }


  #QPScrollStory-{{ section.id }} .qp-tag:nth-child(3) {

    left: 7%;

    top: 63%;

  }


  #QPScrollStory-{{ section.id }} .qp-tag:nth-child(4) {

    right: 7%;

    top: 28%;

  }


  /* -----------------------------------------
     FEATURES
     ----------------------------------------- */

  #QPScrollStory-{{ section.id }} .qp-features {

    left: 20px;

    right: 20px;

    bottom: 7vh;

    top: auto;

    width: auto;

    min-height: 170px;

    transform:
      translateY(40px);

  }


  #QPScrollStory-{{ section.id }} .qp-feature {

    width: calc(100vw - 40px);

  }


  #QPScrollStory-{{ section.id }} .qp-feature h3 {

    font-size: 36px;

  }


  #QPScrollStory-{{ section.id }} .qp-feature-text {

    font-size: 13px;

    max-width: 290px;

  }


  /* -----------------------------------------
     SCENE 03
     ----------------------------------------- */

  #QPScrollStory-{{ section.id }} .qp-big-number {

    top: 42%;

    font-size: 58vw;

  }


  #QPScrollStory-{{ section.id }} .qp-number-label {

    top: 22%;

    font-size: 8px;

    letter-spacing: .22em;

  }


  #QPScrollStory-{{ section.id }} .qp-final-copy {

    bottom: 8vh;

  }


  #QPScrollStory-{{ section.id }} .qp-final-copy h2 {

    font-size: 34px;

  }


  /* -----------------------------------------
     CTA
     ----------------------------------------- */

  #QPScrollStory-{{ section.id }} .qp-final-cta {

    min-height: 65vh;

    padding: 70px 20px;

  }


  #QPScrollStory-{{ section.id }} .qp-final-inner h2 {

    font-size: 48px;

  }

}


/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

  #QPScrollStory-{{ section.id }} .qp-scene {

    height: auto;

  }


  #QPScrollStory-{{ section.id }} .qp-sticky {

    position: relative;

    height: 100svh;

  }

}

</style>



<script>

(function() {

  const root =
    document.getElementById(
      'QPScrollStory-{{ section.id }}'
    );

  if (!root) return;


  let ticking = false;


  /* =====================================================
     HELPERS
     ===================================================== */

  function clamp(value) {

    return Math.max(
      0,
      Math.min(1, value)
    );

  }


  function map(
    value,
    start,
    end,
    outputStart,
    outputEnd
  ) {

    const progress =
      clamp(
        (value - start) /
        (end - start)
      );

    return (
      outputStart +
      (outputEnd - outputStart) *
      progress
    );

  }


  function progressOf(scene) {

    const rect =
      scene.getBoundingClientRect();

    const distance =
      scene.offsetHeight -
      window.innerHeight;

    if (distance <= 0) {

      return 0;

    }

    return clamp(
      -rect.top / distance
    );

  }


  /* =====================================================
     SCENE 01
     ===================================================== */

  function updateScene01() {

    const scene =
      root.querySelector(
        '.qp-scene-01'
      );

    if (!scene) return;


    const p =
      progressOf(scene);


    const background =
      root.querySelector(
        '.qp-bg-01'
      );


    const product =
      root.querySelector(
        '.qp-product-01'
      );


    const copy =
      root.querySelector(
        '.qp-copy-01'
      );


    const cards =
      root.querySelectorAll(
        '.qp-cards-01 .qp-card'
      );


    const mobile =
      window.innerWidth <= 749;


    /* Background */

    if (background) {

      background.style.transform =
        `
        translate3d(
          ${map(
            p,
            0,
            .7,
            mobile ? 18 : 28,
            mobile ? -18 : -28
          )}vw,
          -50%,
          0
        )
        `;


      background.style.opacity =
        map(
          p,
          .65,
          .9,
          1,
          0
        );

    }


    /* Product */

    if (product) {

      product.style.transform =
        `
        translate3d(
          -50%,
          -50%,
          0
        )
        scale(
          ${map(
            p,
            0,
            .55,
            mobile ? 1.08 : 1.22,
            1
          )}
        )
        `;

    }


    /* Main copy */

    if (copy) {

      const cp =
        clamp(
          (p - .35) / .2
        );


      copy.style.opacity = cp;


      copy.style.transform =
        `
        translateY(
          ${map(
            cp,
            0,
            1,
            35,
            0
          )}px
        )
        `;

    }


    /* Cards */

    cards.forEach(
      function(card, index) {

        const start =
          .12 + index * .08;


        const cp =
          clamp(
            (p - start) / .22
          );


        card.style.opacity = cp;


        card.style.transform =
          `
          translateY(
            ${map(
              cp,
              0,
              1,
              25,
              0
            )}px
          )
          `;

      }
    );

  }


  /* =====================================================
     SCENE 02
     ===================================================== */

  function updateScene02() {

    const scene =
      root.querySelector(
        '.qp-scene-02'
      );

    if (!scene) return;


    const p =
      progressOf(scene);


    const background =
      root.querySelector(
        '.qp-bg-02'
      );


    const product =
      root.querySelector(
        '.qp-product-02'
      );


    const tags =
      root.querySelectorAll(
        '.qp-scene-02 .qp-tag'
      );


    const features =
      root.querySelectorAll(
        '.qp-scene-02 .qp-feature'
      );


    const featureContainer =
      root.querySelector(
        '.qp-features'
      );


    const mobile =
      window.innerWidth <= 749;


    /* Background */

    if (background) {

      background.style.transform =
        `
        translate3d(
          ${map(
            p,
            0,
            .72,
            mobile ? 20 : 30,
            mobile ? -20 : -30
          )}vw,
          -50%,
          0
        )
        `;


      background.style.opacity =
        map(
          p,
          .7,
          .95,
          1,
          0
        );

    }


    /* Product */

    if (product) {

      const pp =
        clamp(
          p / .35
        );


      product.style.opacity = pp;


      product.style.transform =
        `
        translate3d(
          -50%,
          -50%,
          0
        )
        scale(
          ${map(
            pp,
            0,
            1,
            .78,
            1
          )}
        )
        `;

    }


    /* Tags */

    tags.forEach(
      function(tag, index) {

        const start =
          .12 + index * .08;


        const tp =
          clamp(
            (p - start) / .15
          );


        tag.style.opacity = tp;


        tag.style.transform =
          `
          translateY(
            ${map(
              tp,
              0,
              1,
              25,
              0
            )}px
          )
          scale(
            ${map(
              tp,
              0,
              1,
              .82,
              1
            )}
          )
          `;

      }
    );


    /* Feature container */

    if (featureContainer) {

      const fp =
        clamp(
          (p - .36) / .18
        );


      featureContainer.style.opacity = fp;


      if (mobile) {

        featureContainer.style.transform =
          `
          translateY(
            ${map(
              fp,
              0,
              1,
              40,
              0
            )}px
          )
          `;

      } else {

        featureContainer.style.transform =
          `
          translate(
            ${map(
              fp,
              0,
              1,
              100,
              0
            )}px,
            -50%
          )
          `;

      }

    }


    /* Features */

    features.forEach(
      function(feature, index) {

        const start =
          mobile
            ? .46 + index * .13
            : .48 + index * .13;


        const fp =
          clamp(
            (p - start) / .10
          );


        feature.style.opacity = fp;


        feature.style.transform =
          `
          translateY(
            ${map(
              fp,
              0,
              1,
              30,
              0
            )}px
          )
          `;

      }
    );

  }


  /* =====================================================
     SCENE 03
     ===================================================== */

  function updateScene03() {

    const scene =
      root.querySelector(
        '.qp-scene-03'
      );

    if (!scene) return;


    const p =
      progressOf(scene);


    const number =
      root.querySelector(
        '.qp-big-number'
      );


    const product =
      root.querySelector(
        '.qp-product-03'
      );


    const copy =
      root.querySelector(
        '.qp-final-copy'
      );


    /* Number */

    if (number) {

      number.style.transform =
        `
        translate(
          -50%,
          -50%
        )
        scale(
          ${map(
            p,
            0,
            .7,
            1.12,
            1
          )}
        )
        `;

    }


    /* Product */

    if (product) {

      product.style.transform =
        `
        translate(
          -50%,
          calc(
            -50% +
            ${map(
              p,
              0,
              .75,
              0,
              -75
            )}px
          )
        )
        scale(
          ${map(
            p,
            0,
            .75,
            1,
            .72
          )}
        )
        `;

    }


    /* Copy */

    if (copy) {

      const cp =
        clamp(
          (p - .63) / .2
        );


      copy.style.opacity = cp;


      copy.style.transform =
        `
        translate(
          -50%,
          ${map(
            cp,
            0,
            1,
            35,
            0
          )}px
        )
        `;

    }

  }


  /* =====================================================
     UPDATE
     ===================================================== */

  function update() {

    ticking = false;

    updateScene01();

    updateScene02();

    updateScene03();

  }


  function requestUpdate() {

    if (ticking) return;

    ticking = true;

    window.requestAnimationFrame(
      update
    );

  }


  window.addEventListener(
    'scroll',
    requestUpdate,
    {
      passive: true
    }
  );


  window.addEventListener(
    'resize',
    requestUpdate
  );


  update();

})();

</script>



