    {"type":"color","id":"header_background","label":"Header background","default":"#332F1F"},
    {"type":"color","id":"header_text_color","label":"Header text","default":"#FFFFFF"},
    {"type":"color","id":"highlight_background","label":"Brand highlight","default":"#E6F1EE"},
