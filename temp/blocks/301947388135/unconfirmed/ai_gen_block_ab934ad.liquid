    {"type":"text","id":"brace_5","label":"Option 2 row 5","default":"✗"},
    {"type":"text","id":"chiro_5","label":"Option 3 row 5","default":"✗"},
    {"type":"text","id":"video_5","label":"Option 4 row 5","default":"✗"},
    {"type":"text","id":"feature_6","label":"Feature 6","default":"Face de-puffing"},
    {"type":"text","id":"brand_6","label":"Brand 6","default":"✓ (jugular drainage)"},
    {"type":"text","id":"brace_6","label":"Option 2 row 6","default":"✗"},
    {"type":"text","id":"chiro_6","label":"Option 3 row 6","default":"✗"},
    {"type":"text","id":"video_6","label":"Option 4 row 6","default":"✗"},
    {"type":"header","content":"Colors and type"},
    {"type":"color","id":"text_color","label":"Text","default":"#332F1F"},
    {"type":"color","id":"heading_color","label":"Heading","default":"#332F1F"},
