{% doc %}
  @prompt
    How Hizoo compares
    Hizoo	Posture Brace	Chiropractor	YouTube Stretches
    Targets the SCM directly	✓	✗	✗	✗
    Cost	$200 once	$25–$45	$1,200+/yr	Free
    Daily commitment	10 min lying down	All-day wear	Weekly visits	20+ min active
    Visible results	2–4 weeks	None (weakens muscles)	Reverses in 48 hrs	80% quit by week 3
    Sleep improvement	✓ (vagus nerve)	✗	✗	✗
    Face de-puffing	✓ (jugular drainage)	✗	✗	✗
    我要一个这个表格
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-comparison-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    color: {{ block.settings.text_color }};
  }

  .ai-comparison-{{ ai_gen_id }}__heading {
    margin: 0 0 24px;
    text-align: center;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
  }

  .ai-comparison-{{ ai_gen_id }}__wrap {
    overflow-x: auto;
    border: 1px solid {{ block.settings.border_color }};
    border-radius: 16px;
    background: {{ block.settings.table_background }};
  }

  .ai-comparison-{{ ai_gen_id }}__table {
    width: 100%;
    min-width: 680px;
    border-collapse: collapse;
    table-layout: fixed;
  }

  .ai-comparison-{{ ai_gen_id }} th,
  .ai-comparison-{{ ai_gen_id }} td {
    padding: 16px 14px;
    border-bottom: 1px solid {{ block.settings.border_color }};
    text-align: center;
    vertical-align: middle;
    font-size: {{ block.settings.body_size }}px;
    line-height: 1.35;
  }

  .ai-comparison-{{ ai_gen_id }} th:first-child,
  .ai-comparison-{{ ai_gen_id }} td:first-child {
    width: 25%;
    text-align: left;
  }

  .ai-comparison-{{ ai_gen_id }} th {
    background: {{ block.settings.header_background }};
    color: {{ block.settings.header_text_color }};
    font-weight: 700;
  }

  .ai-comparison-{{ ai_gen_id }} td:first-child {
    color: {{ block.settings.label_color }};
    font-weight: 700;
  }

  .ai-comparison-{{ ai_gen_id }} tr:last-child td {
    border-bottom: 0;
  }

  .ai-comparison-{{ ai_gen_id }} td:nth-child(2) {
    background: {{ block.settings.highlight_background }};
    color: {{ block.settings.highlight_text_color }};
    font-weight: 700;
  }

  @media screen and (max-width: 749px) {
    .ai-comparison-{{ ai_gen_id }}__heading {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-comparison-{{ ai_gen_id }} th,
    .ai-comparison-{{ ai_gen_id }} td {
      padding: 13px 10px;
      font-size: 13px;
    }
  }
{% endstyle %}

<div class="ai-comparison-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-comparison-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
  {% endif %}
  <div class="ai-comparison-{{ ai_gen_id }}__wrap">
    <table class="ai-comparison-{{ ai_gen_id }}__table">
      <thead>
        <tr>
          <th scope="col">{{ block.settings.feature_heading | escape }}</th>
          <th scope="col">{{ block.settings.brand_heading | escape }}</th>
          <th scope="col">{{ block.settings.brace_heading | escape }}</th>
          <th scope="col">{{ block.settings.chiro_heading | escape }}</th>
          <th scope="col">{{ block.settings.video_heading | escape }}</th>
        </tr>
      </thead>
      <tbody>
        {% for i in (1..6) %}
          {% liquid
            assign feature_key = 'feature_' | append: i
            assign brand_key = 'brand_' | append: i
            assign brace_key = 'brace_' | append: i
            assign chiro_key = 'chiro_' | append: i
            assign video_key = 'video_' | append: i
          %}
          <tr>
            <th scope="row">{{ block.settings[feature_key] | escape }}</th>
            <td>{{ block.settings[brand_key] | escape }}</td>
            <td>{{ block.settings[brace_key] | escape }}</td>
            <td>{{ block.settings[chiro_key] | escape }}</td>
            <td>{{ block.settings[video_key] | escape }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

{% schema %}
{
  "name": "Comparison table",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"How Hizoo compares"},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"header","content":"Column headings"},
    {"type":"text","id":"feature_heading","label":"Feature","default":"Feature"},
    {"type":"text","id":"brand_heading","label":"Brand","default":"Hizoo"},
    {"type":"text","id":"brace_heading","label":"Option 2","default":"Posture Brace"},
    {"type":"text","id":"chiro_heading","label":"Option 3","default":"Chiropractor"},
    {"type":"text","id":"video_heading","label":"Option 4","default":"YouTube Stretches"},
