    {"type":"color","id":"table_background","label":"Table background","default":"#FFFFFF"},
    {"type":"color","id":"border_color","label":"Borders","default":"#D9D4C9"},
    {"type":"range","id":"heading_size","label":"Heading size","min":18,"max":48,"step":2,"unit":"px","default":30},
    {"type":"range","id":"body_size","label":"Body size","min":12,"max":24,"step":1,"unit":"px","default":15}
  ],
  "presets": [{"name":"Comparison table"}],
  "tag": null,
