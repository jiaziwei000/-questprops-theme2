    {"type":"text","id":"feature_1","label":"Feature 1","default":"Targets the SCM directly"},
    {"type":"text","id":"brand_1","label":"Brand 1","default":"✓"},
    {"type":"text","id":"brace_1","label":"Option 2 row 1","default":"✗"},
    {"type":"text","id":"chiro_1","label":"Option 3 row 1","default":"✗"},
    {"type":"text","id":"video_1","label":"Option 4 row 1","default":"✗"},
    {"type":"text","id":"feature_2","label":"Feature 2","default":"Cost"},
    {"type":"text","id":"brand_2","label":"Brand 2","default":"$200 once"},
    {"type":"text","id":"brace_2","label":"Option 2 row 2","default":"$25–$45"},
    {"type":"text","id":"chiro_2","label":"Option 3 row 2","default":"$1,200+/yr"},
    {"type":"text","id":"video_2","label":"Option 4 row 2","default":"Free"},
    {"type":"text","id":"feature_3","label":"Feature 3","default":"Daily commitment"},
    {"type":"text","id":"brand_3","label":"Brand 3","default":"10 min lying down"},
    {"type":"text","id":"brace_3","label":"Option 2 row 3","default":"All-day wear"},
    {"type":"text","id":"chiro_3","label":"Option 3 row 3","default":"Weekly visits"},
    {"type":"text","id":"video_3","label":"Option 4 row 3","default":"20+ min active"},
    {"type":"text","id":"feature_4","label":"Feature 4","default":"Visible results"},
    {"type":"text","id":"brand_4","label":"Brand 4","default":"2–4 weeks"},
    {"type":"text","id":"brace_4","label":"Option 2 row 4","default":"None (weakens muscles)"},
    {"type":"text","id":"chiro_4","label":"Option 3 row 4","default":"Reverses in 48 hrs"},
