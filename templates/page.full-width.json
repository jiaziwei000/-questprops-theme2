        "content_qgRpYq": {
          "type": "content",
          "settings": {
            "image": "shopify://shop_images/555566664db5cda89acc1c7eb10878af.jpg",
            "subheading": "Week 4",
            "heading": "<em>\"This is just my face now.\"</em>",
            "heading_tag": "h2",
            "text": "<p>A thirty-second habit, not a chore — and that's what makes it stick. You're maintaining an open drain with almost no effort.</p>",
            "button_label": "",
            "button_link": "",
            "button_style": "primary",
            "button_external": false,
            "button_icon": true,
            "highlighted_text": "half_text",
