      "blocks": {
        "content_jKUt99": {
          "type": "content",
          "settings": {
            "image": "shopify://shop_images/25a8888bc49646a92b995caf27.jpg",
            "subheading": "WEEK 1",
            "heading": "<em>\"Oh, that's the feeling.\"</em>",
            "heading_tag": "h2",
            "text": "<p>Your neck loosening, tension lifting, a light fresh feeling as fluid starts to move. Right after, your face looks a little less puffy. It fades during the day — that's normal.</p>",
            "button_label": "",
            "button_link": "",
            "button_style": "primary",
            "button_external": false,
            "button_icon": true,
            "highlighted_text": "half_text",
