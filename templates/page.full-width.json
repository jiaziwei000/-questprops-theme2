    "reveal_testimonials_UkpDUP": {
      "type": "reveal-testimonials",
      "blocks": {
        "testimonial_CajEQV": {
          "type": "testimonial",
          "settings": {
            "icon": "quote",
            "text": "<p>Ordered this for the puffiness under my eyes and honestly didn't expect much. Two weeks in and my husband asked if I'd \"done something\" to my face 😂 It's the neck thing, I swear.<br/><br/></p>",
            "author": "Diana Wallace",
            "author_info": "",
            "author_url": "",
            "image": "shopify://shop_images/2.png",
            "image_ratio": "rounded",
            "image_height": 30,
            "highlighted_text": "none",
