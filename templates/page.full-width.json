          "settings": {
            "image": "shopify://shop_images/45454614071a97379b3d54dd727600.jpg",
            "subheading": "Week 2",
            "heading": "<em>\"My mornings are different.\"</em>",
            "heading_tag": "h2",
            "text": "<p>You wake up and your face isn't as puffy as it used to be. The pillow-face is softer. The effect starts carrying overnight instead of disappearing by lunch.</p>",
            "button_label": "",
            "button_link": "",
            "button_style": "primary",
            "button_external": false,
            "button_icon": true,
            "highlighted_text": "half_text",
            "highlighted_scribble": "circle",
