        },
        "content_BneRkg": {
          "type": "content",
          "settings": {
            "image": "shopify://shop_images/444333351e37005d7ede9848668f6ac5d.jpg",
            "subheading": "Week 3",
            "heading": "<em>\"Where has my jawline been?\"</em>",
            "heading_tag": "h2",
            "text": "<p>Your baseline resets. The jawline you forgot you had shows up more consistently — it was never fat, it was fluid sitting on top of it. Under-eyes look less tired.</p>",
            "button_label": "",
            "button_link": "",
            "button_style": "primary",
            "button_external": false,
            "button_icon": true,
            "highlighted_text": "half_text",
