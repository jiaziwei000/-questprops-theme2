        "heading_alignment": "text-center justify-center",
        "heading_tag": "h2",
        "subheading": "",
        "description": "<p>Our device combines EMS micro-stimulation and soothing heat to mimic a therapist’s hands. It awakens sluggish lymph nodes, draining trapped fluid that creates puffy cheeks and under-eye bags for a naturally lifted look.<br/><br/></p>",
        "button_label": "",
        "button_link": "",
        "button_external": false,
        "button_icon": true,
        "highlighted_text": "marker",
        "highlighted_scribble": "circle",
