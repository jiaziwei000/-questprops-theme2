        "text_xFGwNk": {
          "type": "text",
          "settings": {
            "text": "<p>10 minutes. Lying down. Before bed. Results compound nightly — each session builds on the last.</p><h3>What to expect:</h3><ul><li><strong>Week 1:</strong> The tension at the base of your skull starts releasing. Your neck feels different — lighter.</li><li><strong>Week 2–3:</strong> The visible hump begins softening. Side-profile photos start looking different.</li><li><strong>Week 4+:</strong> The hump visibly reduces. Clothes sit differently. You stop checking mirrors compulsively.</li></ul>",
            "text_font": "body",
            "text_size": "subtext-md",
            "text_max_size": 32,
            "text_line_height": 1.6,
            "text_letter_spacing": 0,
            "text_capitalize": false,
            "secondary_color": false,
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
