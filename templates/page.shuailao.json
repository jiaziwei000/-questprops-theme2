            "button_size": "md",
            "button_external": false,
            "button_icon": true
          }
        },
        "text_fGpJXV": {
          "type": "text",
          "settings": {
            "text": "<p>Free shipping · 30-day guarantee · Results in as little as 7 days<br/><br/></p>",
            "text_font": "body",
