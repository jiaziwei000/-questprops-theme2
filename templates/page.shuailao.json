    "rich_text_aRfL4f": {
      "type": "rich-text",
      "blocks": {
        "heading_AWeQRP": {
          "type": "heading",
          "settings": {
            "heading": "<em>\"Think of your face like a curtain on a rod. The rod is your neck posture. When the rod is straight, the curtain hangs smooth and tight. When the rod tilts forward, the curtain bunches, sags, and wrinkles.\"</em>",
            "heading_size": "title-md",
            "heading_tag": "h2",
            "highlighted_text": "underline",
            "highlighted_scribble": "circle",
            "highlighted_reveal": false
          }
        },
        "text_tbCTAr": {
          "type": "text",
          "settings": {
            "text": "<p><br/>Every serum, roller, and face exercise is trying to iron the curtain while the rod is still tilted. Fix the rod, the curtain fixes itself.<br/><br/></p>",
            "text_font": "heading",
            "text_size": "subtext-sm",
            "text_max_size": 32,
            "text_line_height": 1.6,
            "text_letter_spacing": 0,
            "text_capitalize": false,
