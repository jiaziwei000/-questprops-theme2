        },
        "testimonial_XUFTKV": {
          "type": "testimonial",
          "disabled": true,
          "settings": {
            "icon": "5-stars",
            "text": "<p>HEYYYY!!! i was waiting to try all the pros - nooooo cons ! OF THIS LITTLE FRIEND !!! <br/>The QuestProps DELIVERED !!!! i suffer tension headaches n neck pain SINCE i was 25!!! Teaching for 20 ys DID NOT HELP ! <br/>HERE COMES THIS NOT HEAVY <br/>STILL LEARNING U CAN USE ON CALVES N BACKKKK !! <br/>its STRONGGGG! in the Soft mode for me yet ! <br/><br/>Happy so far !! Released my tense neck and upper shoulders !!! 👍👍😜😈🙏🙏🙏🙏<br/><br/>Finally something that works ?!!!!!! <br/>♥️♥️♥️🙌🙌🙌🙌🙌🙌🙌🥂🥂🥳<br/><br/><br/></p>",
            "author": "Martha W.",
            "author_info": "",
