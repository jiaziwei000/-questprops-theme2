        "text_BkDjKt": {
          "type": "text",
          "settings": {
            "text": "<p>✓91% of users reported <span style=\"text-decoration:underline\"><strong>reduced neck pain</strong></span> from the first session.</p>",
            "text_font": "heading",
            "text_size": "subtext-sm",
            "text_max_size": 32,
