t-weight:700}.qp-no{color:#aaa49a;font-weight:500}\n@media(max-width:650px){.qp-compare{padding:20px 12px 22px}.qp-compare h2{font-size:17px;line-height:1.3}.qp-compare h3{font-size:17px}.qp-compare__intro{font-size:12px;margin:5px auto 13px}.qp-costs{display:flex;gap:7px;overflow-x:auto;margin:0 -12px;padding:0 12px 4px;scroll-snap-type:x proximity}.qp-cost{flex:0 0 145px;min-height:104px;height:104px;padding:9px 8px;border-radius:8px;scroll-snap-align:start}.qp-cost__name{font-size:8px;margin-bottom:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.qp-cost__price{font-size:13px;margin-bottom:3px}.qp-cost ul{font-size:10px;line-height:1.3}.qp-cost li:nth-child(n+2){display:none}.qp-cost__note{font-size:12px;line-height:1.4;margin:10px 0 15px}.qp-table-intro{padding:11px 11px 7px}.qp-table-intro p{font-size:11px;margin-top:3px}.qp-table{min-width:0;font-size:11px}.qp-table th,.qp-table td{padding:5px 6px}.qp-table th{font-size:8px}.qp-table th:first-child,.qp-table td:first-child{width:58%}.qp-table th:nth-child(3){font-size:0}.qp-table th:nth-child(3)::after{content:'OTHER OPTIONS';font-size:8px}.qp-table td:nth-child(3){font-size:0}.qp-table td:nth-child(3)::after{content:'✓';font-size:12px;color:#77643a;font-weight:700}.qp-table tr:nth-child(1) td:nth-child(3)::after,.qp-table tr:nth-child(3) td:nth-child(3)::after,.qp-table tr:nth-child(5) td:nth-child(3)::after{content:'✕';color:#aaa49a;font-weight:500}.qp-table th:nth-child(4),.qp-table td:nth-child(4){display:none}.qp-yes,.qp-no{font-size:12px}}\n</style>\n<section class=\"qp-compare\" aria-label=\"QuestProps comparison\"><div class=\"qp-compare__inner\"><h2>What Does Your Beauty Routine Really Cost?</h2><p class=\"qp-compare__intro\">Small daily habits can add up to less time, less hassle, and less ongoing spending.</p><div class=\"qp-costs\"><article class=\"qp-cost qp-cost--featured\"><div class=\"qp-cost__name\">QUESTPROPS</div><div class=\"qp-cost__price\">$0.87 / day</div><ul><li>30 seconds