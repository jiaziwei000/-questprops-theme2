    "custom_liquid_rFkMbR": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.name",
      "settings": {
        "liquid": "<style>\n.qp-compare{\n  background:#faf9f6;\n  color:#332f1f;\n  padding:32px 20px 36px;\n  font-family:inherit;\n}\n\n.qp-compare *{\n  box-sizing:border-box;\n}\n\n.qp-compare__inner{\n  max-width:1080px;\n  margin:0 auto;\n}\n\n.qp-compare h2{\n  margin:0;\n  text-align:center;\n  font-size:clamp(22px,2.4vw,30px);\n  line-height:1.2;\n  letter-spacing:-.025em;\n  font-weight:600;\n}\n\n.qp-compare__intro{\n  max-width:650px;\n  margin:9px auto 24px;\n  text-align:center;\n  color:#716b60;\n  font-size:13px;\n  line-height:1.55;\n}\n\n.qp-costs{\n  display:grid;\n  grid-template-columns:repeat(3,minmax(0,1fr));\n  gap:12px;\n}\n\n.qp-cost{\n  min-height:156px;\n  padding:18px 17px;\n  border:1px solid #ded9cf;\n  border-radius:12px;\n  background:#fffdf9;\n}\n\n.qp-cost--featured{\n  background:#f3ede0;\n  border-color:#b9a77e;\n  box-shadow:0 2px 8px rgba(73,58,32,.05);\n}\n\n.qp-cost__name{\n  margin-bottom:9px;\n  color:#766b54;\n  font-size:9px;\n  line-height:1.25;\n  letter-spacing:.08em;\n  font-weight:700;\n}\n\n.qp-cost__price{\n  margin-bottom:10px;\n  color:#332f1f;\n  font-size:20px;\n  line-height:1.15;\n  letter-spacing:-.02em;\n  font-weight:600;\n}\n\n.qp-cost ul{\n  list-style:none;\n  margin:0;\n  padding:0;\n  color:#6d675c;\n  font-size:12px;\n  line-height:1.55;\n}\n\n.qp-cost li{\n  position:relative;\n  padding-left:12px;\n}\n\n.qp-cost li::before{\n  content:\"•\";\n  position:absolute;\n  left:0;\n  color:#9b8b67;\n}\n\n.qp-cost li+li{\n  margin-top:2px;\n}\n\n.qp-cost__note{\n  max-width:680px;\n  margin:20px auto 26px;\n  text-align:center;\n  color:#625d50;\n  font-size:13px;\n  line-height:1.55;\n}\n\n.qp-cost__note strong{\n  color:#332f1f;\n  font-weight:600;\n}\n\n.qp-table-wrap{\n  overflow:hidden;\n  border:1px solid #ded9cf;\n  border-radius:12px;\n  background:#fffdf9;\n}\n\n.qp-table-intro{\n  padding:18px 20px 13px;\n}\n\n.qp-table-intro h3{\n  margin:0;\n  font-size:19px;\n  line-height:1.25;\n  font-weight:600;\n  letter-spacing:-.015em;\n}\n\n.qp-table-intro p{\n  margin:5px 0 0;\n  color:#716b60;\n  font-size:12px;\n  line-height:1.45;\n}\n\n.qp-table{\n  width:100%;\n  border-collapse:collapse;\n  table-layout:fixed;\n  font-size:12px;\n}\n\n.qp-table th,\n.qp-table td{\n  padding:11px 14px;\n  border-top:1px solid #e8e3db;\n  text-align:center;\n  vertical-align:middle;\n}\n\n.qp-table th{\n  background:#f7f3eb;\n  color:#6c644f;\n  font-size:9px;\n  line-height:1.25;\n  letter-spacing:.055em;\n  font-weight:700;\n}\n\n.qp-table th:first-child,\n.qp-table td:first-child{\n  width:43%;\n  text-align:left;\n}\n\n.qp-table th:nth-child(2),\n.qp-table td:nth-child(2){\n  background:#f3ede0;\n}\n\n.qp-table td:first-child{\n  color:#4f493e;\n  font-weight:500;\n}\n\n.qp-yes{\n  color:#77643a;\n  font-size:15px;\n  font-weight:700;\n}\n\n.qp-no{\n  color:#aaa49a;\n  font-size:15px;\n  font-weight:500;\n}\n\n@media(max-width:650px){\n\n  .qp-compare{\n    padding:24px 12px 28px;\n  }\n\n  .qp-compare h2{\n    font-size:20px;\n    line-height:1.25;\n  }\n\n  .qp-compare__intro{\n    margin:7px auto 18px;\n    font-size:12px;\n    line-height:1.5;\n  }\n\n  .qp-costs{\n    display:grid;\n    grid-template-columns:repeat(3,minmax(0,1fr));\n    gap:6px;\n  }\n\n  .qp-cost{\n    min-height:132px;\n    padding:11px 9px;\n    border-radius:9px;\n  }\n\n  .qp-cost--featured{\n    padding:11px 9px;\n  }\n\n  .qp-cost__name{\n    min-height:20px;\n    margin-bottom:5px;\n    font-size:7px;\n    line-height:1.25;\n    letter-spacing:.055em;\n  }\n\n  .qp-cost__price{\n    min-height:30px;\n    margin-bottom:6px;\n    font-size:13px;\n    line-height:1.15;\n  }\n\n  .qp-cost ul{\n    font-size:9px;\n    line-height:1.35;\n  }\n\n  .qp-cost li{\n    padding-left:8px;\n  }\n\n  .qp-cost__note{\n    margin:14px auto 18px;\n    font-size:11px;\n    line-height:1.45;\n  }\n\n  .qp-table-wrap{\n    border-radius:9px;\n  }\n\n  .qp-table-intro{\n    padding:13px 12px 9px;\n  }\n\n  .qp-table-intro h3{\n    font-size:16px;\n  }\n\n  .qp-table-intro p{\n    margin-top:3px;\n    font-size:10px;\n  }\n\n  .qp-table{\n    font-size:10px;\n  }\n\n  .qp-table th,\n  .qp-table td{\n    padding:8px 5px;\n  }\n\n  .qp-table th{\n    font-size:7px;\n    line-height:1.2;\n    letter-spacing:.025em;\n  }\n\n  .qp-table th:first-child,\n  .qp-table td:first-child{\n    width:43%;\n  }\n\n  .qp-table th:nth-child(2),\n  .qp-table td:nth-child(2){\n    width:19%;\n  }\n\n  .qp-table th:nth-child(3),\n  .qp-table td:nth-child(3){\n    width:19%;\n  }\n\n  .qp-table th:nth-child(4),\n  .qp-table td:nth-child(4){\n    width:19%;\n  }\n\n  .qp-yes,\n  .qp-no{\n    font-size:13px;\n  }\n}\n</style>\n\n<section class=\"qp-compare\" aria-label=\"QuestProps HMS comparison\">\n\n  <div class=\"qp-compare__inner\">\n\n    <h2>What Does Your Neck Care Really Cost?</h2>\n\n    <p class=\"qp-compare__intro\">\n      A simple at-home routine can cost less per day than a single professional session.\n    </p>\n\n    <div class=\"qp-costs\">\n\n      <article class=\"qp-cost qp-cost--featured\">\n        <div class=\"qp-cost__name\">QUESTPROPS HMS</div>\n        <div class=\"qp-cost__price\">&lt; $0.50 / DAY</div>\n        <ul>\n          <li>Heat + EMS + massage</li>\n          <li>Use at home</li>\n          <li>Simple daily routine</li>\n        </ul>\n      </article>\n\n      <article class=\"qp-cost\">\n        <div class=\"qp-cost__name\">MASSAGE THERAPY</div>\n        <div class=\"qp-cost__price\">$60+ / SESSION</div>\n        <ul>\n          <li>Pay every visit</li>\n          <li>Book an appointment</li>\n          <li>Travel and wait</li>\n        </ul>\n      </article>\n\n      <article class=\"qp-cost\">\n        <div class=\"qp-cost__name\">SEPARATE DEVICES</div>\n        <div class=\"qp-cost__price\">MULTIPLE COSTS</div>\n        <ul>\n          <li>Different devices</li>\n          <li>Different routines</li>\n          <li>More to manage</li>\n        </ul>\n      </article>\n\n    </div>\n\n    <p class=\"qp-cost__note\">\n      <strong>Work it into your day, not around your schedule.</strong><br>\n      No appointments. No travel. Just a simple at-home routine.\n    </p>\n\n    <div class=\"qp-table-wrap\">\n\n      <div class=\"qp-table-intro\">\n        <h3>Simple By Design</h3>\n        <p>See how QuestProps fits into everyday life.</p>\n      </div>\n\n      <table class=\"qp-table\">\n\n        <thead>\n          <tr>\n            <th>FEATURE</th>\n            <th>QUESTPROPS</th>\n            <th>MASSAGE</th>\n            <th>SEPARATE DEVICES</th>\n          </tr>\n        </thead>\n\n        <tbody>\n\n          <tr>\n            <td>Use at home</td>\n            <td class=\"qp-yes\">✓</td>\n            <td class=\"qp-no\">✕</td>\n            <td class=\"qp-yes\">✓</td>\n          </tr>\n\n          <tr>\n            <td>No appointment needed</td>\n            <td class=\"qp-yes\">✓</td>\n            <td class=\"qp-no\">✕</td>\n            <td class=\"qp-yes\">✓</td>\n          </tr>\n\n          <tr>\n            <td>Heat + EMS + massage</td>\n            <td class=\"qp-yes\">✓</td>\n            <td class=\"qp-no\">✕</td>\n            <td class=\"qp-no\">✕</td>\n          </tr>\n\n          <tr>\n            <td>One simple routine</td>\n            <td class=\"qp-yes\">✓</td>\n            <td class=\"qp-no\">✕</td>\n            <td class=\"qp-no\">✕</td>\n          </tr>\n\n          <tr>\n            <td>No travel required</td>\n            <td class=\"qp-yes\">✓</td>\n            <td class=\"qp-no\">✕</td>\n            <td class=\"qp-yes\">✓</td>\n          </tr>\n\n          <tr>\n            <td>Easy to use regularly</td>\n            <td class=\"qp-yes\">✓</td>\n            <td class=\"qp-no\">✕</td>\n            <td class=\"qp-no\">✕</td>\n          </tr>\n\n        </tbody>\n\n      </table>\n\n    </div>\n\n  </div>\n\n</section>",
