          "type": "collapsible_tab",
          "settings": {
            "icon": "chat_bubble",
            "iwidth": "custom",
            "icon_width": 24,
            "heading": "SHIPPING DETAILS",
            "content": "<p>Fast, Free Shipping on All Orders<br/>Order Processing: Orders are processed and dispatched within 1–2 business days.<br/>USA Delivery: Typically 4–8 business days directly from our US fulfillment hub.<br/>International Delivery: Typically 5–10 business days via our regional fulfillment network.<br/>Tracking Included: You will receive a tracking link via email as soon as your package leaves our warehouse, allowing you to monitor delivery every step of the way.<br/>Shipping Cost: 100% Free worldwide—no minimum purchase required.<br/>Questions about your delivery? Contact our support team anytime at contact@questprops.com.</p>",
            "metafields": "",
            "text_size": "text-base"
          }
        },
        "collapsible_tab_J49Gai": {
          "type": "collapsible_tab",
          "settings": {
            "icon": "chat_bubble",
            "iwidth": "custom",
            "icon_width": 24,
            "heading": "WHY IS MY NECK ALWAYS WORKING?",
            "content": "<p>Sitting at a desk.<br/><br/>Behind the wheel.<br/><br/>Looking down at your phone.<br/><br/>Working through another long day.</p><p><strong>Your neck keeps adapting.<br/><br/>You rarely give it a real chance to let go.</strong></p>",
