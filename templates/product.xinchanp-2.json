    "faq_pPgBLe": {
      "type": "faq",
      "blocks": {
        "question_fjzh9M": {
          "type": "question",
          "settings": {
            "title": "WHY DOES MY NECK ALWAYS FEEL LIKE IT'S WORKING?",
            "text": "<p>Your neck doesn't really get a break.</p><p>Sitting at a desk.<br/>Driving.<br/>Looking down at your phone.<br/>Working.<br/>Traveling.</p><p>All day, your neck is constantly supporting, adjusting and holding.</p><p>And when you finally try to relax, you often start another routine — stretching, massaging, repositioning, adjusting.</p><p><strong>Maybe your neck doesn't need more work.<br/>Maybe it needs a chance to let go.</strong></p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_qdCbkk": {
          "type": "question",
          "settings": {
            "title": "HOW FAST WILL I FEEL THE DIFFERENCE?",
            "text": "<p><strong>First Use</strong><br/>Get familiar with your 10-minute reset.</p><p><strong>First Week</strong><br/>Build a simple daily routine.</p><p><strong>Long Term</strong><br/>Make 10 minutes of hands-free reset part of your day.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_ptU7mq": {
          "type": "question",
          "settings": {
            "title": "WHAT IF NECK RESTORE ISN'T FOR ME?",
            "text": "<p><strong>180-Day Risk-Free Trial</strong></p><p>Take your time getting used to your new routine. If it's not right for you, you're covered by our 180-day trial.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_nCAY8t": {
          "type": "question",
          "settings": {
            "title": "WHAT DO I DO?",
            "text": "<p><strong>1 —</strong> Position Neck Restore comfortably.</p><p><strong>2 —</strong> Choose your preferred settings.</p><p><strong>3 —</strong> Relax for 10 minutes.</p><p><strong>4 —</strong> Done.</p><p><strong>No complicated routine.<br/>No holding a device.<br/>Just 10 minutes.</strong></p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_ATJ9xc": {
          "type": "question",
          "settings": {
            "title": "IS THIS JUST ANOTHER NECK MASSAGER?",
            "text": "<p><strong>Not exactly.</strong></p><p>It's not just a handheld massager.</p><p>It's not just heat.</p><p>It's not a device you need to keep operating.</p><p><strong>26° Support + Heat + Massage + Gentle EMS</strong></p><p><strong>Combined into one 10-minute hands-free routine.</strong></p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_QhTdqi": {
          "type": "question",
          "settings": {
            "title": "WHAT'S INSIDE NECK RESTORE?",
            "text": "<p>26° Support</p><p>Heat</p><p>Massage</p><p>Gentle EMS</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
