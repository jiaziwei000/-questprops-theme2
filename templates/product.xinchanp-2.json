            "iwidth": "custom",
            "icon_width": 24,
            "heading": "WHAT DO I DO?",
            "content": "<p><strong>1 — Position</strong><br/><br/>Set Neck Restore comfortably.</p><p><strong>2 — Choose</strong><br/><br/>Select your preferred settings.</p><p><strong>3 — Relax</strong><br/><br/>Let it run for 10 minutes.</p><p><strong>4 — Done</strong><br/><br/>That's your reset.</p><p><strong>No complicated routine.</strong> <strong>No appointment.</strong> <strong>No holding a device.</strong></p><p></p>",
            "metafields": "",
            "text_size": "text-base"
          }
        },
        "collapsible_tab_hkTydY": {
          "type": "collapsible_tab",
          "settings": {
            "icon": "chat_bubble",
            "iwidth": "custom",
            "icon_width": 24,
            "heading": "NOT JUST ANOTHER NECK MASSAGER.",
            "content": "<h3>26° SUPPORT</h3><p>Designed around a 26° support angle.</p><h3>HEAT</h3><p>Gentle warmth for your daily reset.</p><h3>MASSAGE</h3><p>A hands-on feel without holding a device.</p><h3>GENTLE EMS</h3><p>Adds another layer to your simple 10-minute reset.</p>",
