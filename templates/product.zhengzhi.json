    "faq": {
      "type": "faq",
      "blocks": {
        "question-1": {
          "type": "question",
          "settings": {
            "title": "<strong>How does QUESTPROPS™ Neck Restore work?</strong>",
            "text": "<p>QUESTPROPS™ combines gentle EMS stimulation, massage and soothing heat in one simple routine. Adjustable settings let you choose the intensity and warmth that feel comfortable for you.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question-2": {
          "type": "question",
          "settings": {
            "title": "<strong>How long should I use it?</strong>",
            "text": "<p>We recommend 10–15 minutes per session. The device includes a 15-minute automatic shut-off for added convenience.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question-3": {
          "type": "question",
          "settings": {
            "title": "<strong>Who is it designed for?</strong>",
            "text": "<p>It's designed for adults who spend a lot of time sitting, working at a desk, driving, using screens, or simply want a relaxing neck routine at the end of the day.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question-4": {
          "type": "question",
          "settings": {
            "title": "<strong>Is the EMS sensation uncomfortable?</strong>",
            "text": "<p>EMS can feel different from person to person. Start at a low intensity and gradually adjust it to a level that feels comfortable for you.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question-5": {
          "type": "question",
          "settings": {
            "title": "<strong>How does the 180-Day Risk-Free Trial work?</strong>",
            "text": "<p>Try QUESTPROPS™ at home. If it isn't right for you, you can return it within the applicable 180-day trial period. Please see our Return Policy for the full terms and conditions.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_8FE3BR": {
          "type": "question",
          "settings": {
            "title": "Does it come with a warranty?",
            "text": "<p>Yes. QUESTPROPS™ Neck Restore includes a 2-Year Warranty. If you need help with a warranty claim, our support team is here to assist you.<br/><br/></p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_Q4E43L": {
          "type": "question",
          "settings": {
            "title": "How long does shipping take?",
            "text": "<p>Orders typically ship within 1–2 business days. Delivery time depends on your destination and shipping method. Tracking information is provided when your order ships.<br/><br/></p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_T7RUaN": {
          "type": "question",
          "settings": {
            "title": "What’s included in the box?",
            "text": "<p>You’ll receive 1× QUESTPROPS™ Neck Restore, 1× Remote Control, 1× USB Charging Cable, and 1× User Guide.<br/><br/></p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "contact": {
          "type": "contact",
          "settings": {
            "heading": "Still have questions?",
            "text": "<p>We're happy to help. Contact our support team and we'll get back to you as soon as possible.</p>",
            "show_phone": false,
            "avatar_height": 60,
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
