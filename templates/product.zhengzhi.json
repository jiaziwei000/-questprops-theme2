            "text_size": "text-base"
          }
        },
        "collapsible_tab_QahVHh": {
          "type": "collapsible_tab",
          "settings": {
            "icon": "none",
            "iwidth": "custom",
            "icon_width": 24,
            "heading": "How Does It Work?",
            "content": "<p>The Questprops holds your fabric in place while you weave threadback and forth to create a strong, knitted patch. Simply stretchthe fabric over the disc and start weaving with the help of the 14hooks at the top. By going over and under each vertical thread,you create an interlocking structure that holds the patch securely<br/>in place.</p>",
            "metafields": "",
            "text_size": "text-base"
          }
        }
