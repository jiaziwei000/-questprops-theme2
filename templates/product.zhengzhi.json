        "collapsible_tab_EjYkJR": {
          "type": "collapsible_tab",
          "settings": {
            "icon": "none",
            "iwidth": "custom",
            "icon_width": 24,
            "heading": "What's Included in the Kit?",
            "content": "<p>The kit includes our wooden PatchMaker made of stainless steeland beech hardwood a latch hook,a sharp needle and printedinstructions with15 pattern designs and access to 5 videotutorials.</p>",
            "metafields": "",
            "text_size": "text-base"
